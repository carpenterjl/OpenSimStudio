<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenSim.Core\OpenSim.Core.csproj" />
    <ProjectReference Include="..\OpenSim.Geometry\OpenSim.Geometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenSim.Tests" />
    <InternalsVisibleTo Include="OpenSim.App.Tests" />
  </ItemGroup>

  <!-- OP-12: the shipped refractiveindex.info pages (CC0 1.0), their licence and the manifest,
       embedded unchanged. Resource names are "riidb/" plus the path under the folder. -->
  <ItemGroup>
    <EmbeddedResource Include="Materials\RefractiveIndexInfo\**\*" Exclude="Materials\RefractiveIndexInfo\.gitattributes" LogicalName="riidb/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- OP-79: the CIE colour-matching and V(lambda) tables (CC BY-SA 4.0), embedded unchanged.
       Resource names are "cie/" plus the file name. -->
  <ItemGroup>
    <EmbeddedResource Include="Photometry\Data\*.csv" LogicalName="cie/%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
