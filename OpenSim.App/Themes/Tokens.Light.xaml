<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- OpenSim Studio design tokens, LIGHT theme.
         Mirrors Tokens.Dark.xaml key-for-key ([data-theme="light"] in the design
         handoff); ThemeService swaps the two dictionaries at runtime, so every key
         here MUST exist in both files. -->

    <!-- Surface ramp -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FBFBFC"/>
    <SolidColorBrush x:Key="SurfaceBrightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#E9ECF0"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#DDE1E6"/>

    <!-- On-surface / outline -->
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#1C1F23"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#5C6470"/>
    <SolidColorBrush x:Key="HeadingBrush" Color="#111826"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#8A929E"/>
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="#DFE2E7"/>

    <!-- Accent (primary = deep cyan) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0E7490"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#0891B2"/>
    <SolidColorBrush x:Key="PrimaryFixedBrush" Color="#CBF3FF"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#4A4BAB"/>
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#E1E0FF"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="#0F7A52"/>
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#C8F5E2"/>

    <!-- Status -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="#FFDAD6"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#A9791C"/>

    <!-- Data-kind palette -->
    <SolidColorBrush x:Key="KindFunctionBrush" Color="#2C5DBF"/>
    <SolidColorBrush x:Key="KindTypeBrush" Color="#7A3FB5"/>
    <SolidColorBrush x:Key="KindConstantBrush" Color="#9A6712"/>
    <SolidColorBrush x:Key="KindVariableBrush" Color="#1B7A99"/>
    <SolidColorBrush x:Key="KindModuleBrush" Color="#3F7A28"/>
    <SolidColorBrush x:Key="KindMacroBrush" Color="#C0395A"/>
    <SolidColorBrush x:Key="KindInterfaceBrush" Color="#0D8A70"/>

    <!-- Semantic aliases -->
    <SolidColorBrush x:Key="AppBgBrush" Color="#FBFBFC"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBgRaisedBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="PanelBgHoverBrush" Color="#E9ECF0"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#DFE2E7"/>
    <SolidColorBrush x:Key="RailBgBrush" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="TextHeadingBrush" Color="#111826"/>
    <SolidColorBrush x:Key="TextBodyBrush" Color="#1C1F23"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5C6470"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#8A929E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0E7490"/>
    <SolidColorBrush x:Key="AccentSolidBrush" Color="#0891B2"/>
    <SolidColorBrush x:Key="AccentOnBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#2E0E7490"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7A52"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="SelectionBgBrush" Color="#CFE3FA"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#6B111826"/>

    <Color x:Key="ShadowColor">#111826</Color>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib"
                   x:Key="ShadowOpacity">0.10</system:Double>
</ResourceDictionary>
