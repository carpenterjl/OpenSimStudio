<Application x:Class="OpenSim.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSim.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Order contract: index 0 is the ACTIVE THEME TOKENS dictionary and is
                 what ThemeService swaps at runtime; Icons and Controls follow and are
                 theme-independent (they bind tokens with DynamicResource). -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.Dark.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters at application scope: the panel UserControls resolve
                 StaticResource against their own + application dictionaries only. -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
