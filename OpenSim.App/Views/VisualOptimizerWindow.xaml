<Window x:Class="OpenSim.App.Views.VisualOptimizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        Title="Visual Optimizer" Width="560" Height="560" MinWidth="400" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}">
    <!-- OP-60: the Visual Optimizer. DataContext is the OpticsVisualOptimizerViewModel: up to
         eight sliders on the lens's variables (radii as curvatures). Moving one publishes trial
         values so the analysis windows update; Keep writes them into the lens, Exit (or closing)
         puts the originals back. -->
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button Content="Load" Command="{Binding LoadCommand}" MinWidth="70" Margin="0,0,4,4"
                    ToolTip="Put back any trial values and read the variables again."/>
            <Button Content="Save" Command="{Binding KeepCommand}" MinWidth="70" Margin="8,0,4,4"
                    ToolTip="Write the values into the lens (one undoable edit) and stay open."/>
            <Button Content="Keep and Exit" Click="KeepAndExit_Click" MinWidth="90" Margin="0,0,4,4"/>
            <Button Content="Exit" Click="Exit_Click" MinWidth="70" Margin="0,0,4,4"
                    ToolTip="Put the original values back and close."/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="VisualOptimizerRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Margin="0,0,0,6">
                            <StackPanel>
                                <controls:FormGrid>
                                    <Label Content="Parameter"/>
                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Variable}" DisplayMemberPath="Label"/>
                                    <Label Content="Start"/>
                                    <TextBox Text="{Binding Start}"/>
                                    <Label Content="Stop"/>
                                    <TextBox Text="{Binding Stop}"/>
                                    <Label Content="Value"/>
                                    <TextBox Text="{Binding Value}"/>
                                </controls:FormGrid>
                                <Slider Margin="0,4,0,0" Minimum="{Binding Start}" Maximum="{Binding Stop}" Value="{Binding Value}"/>
                            </StackPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
