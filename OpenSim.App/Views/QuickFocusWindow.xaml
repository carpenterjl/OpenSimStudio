<Window x:Class="OpenSim.App.Views.QuickFocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        Title="Quick Focus" Width="460" Height="420" MinWidth="360" MinHeight="260"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}">
    <!-- OP-60: Quick Focus. DataContext is the OpticsQuickFocusViewModel. Focus adjusts the
         thickness of the surface before the image for the best RMS and writes it into the lens
         (one undoable edit of the Lens Data Editor). -->
    <DockPanel Margin="8">
        <controls:FormGrid DockPanel.Dock="Top" IsEnabled="{Binding IsIdle}">
            <Label Content="Criterion"/>
            <ComboBox ItemsSource="{Binding Criteria}" SelectedItem="{Binding SelectedCriterion}" DisplayMemberPath="Label"
                      AutomationProperties.AutomationId="QuickFocusCriterionCombo"/>
            <Label Content="Use centroid"/>
            <CheckBox IsChecked="{Binding UseCentroid}" VerticalAlignment="Center"
                      ToolTip="Reference the RMS to the centroid rather than the chief ray (better for systems dominated by coma)."/>
            <Label Content="Gaussian quadrature rings"/>
            <TextBox Text="{Binding Rings}" ToolTip="Rings of the pupil quadrature, 1 to 20; 4 arms per ring."/>
        </controls:FormGrid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,4">
            <Button Content="Focus" Command="{Binding FocusCommand}" MinWidth="70" Margin="0,0,4,4"
                    AutomationProperties.AutomationId="QuickFocusButton"/>
            <Button Content="Close" Click="Close_Click" MinWidth="70" Margin="0,0,4,4"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,4"/>
        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextFaintBrush}"/>
    </DockPanel>
</Window>
