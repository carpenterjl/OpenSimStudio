<Window x:Class="OpenSim.App.Views.MeritFunctionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        xmlns:sheet="clr-namespace:OpenSim.App.Controls.Spreadsheet"
        Title="Merit Function Editor" Width="1200" Height="560" MinWidth="520" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}">
    <!-- OP-54: the Merit Function Editor. DataContext is the OpticsMeritEditorViewModel; the
         sheet is OP-10's SpreadsheetGrid. Type an operand's code (EFFL) or name in the Operand
         column. Update evaluates and fills the Value and % Contrib columns. -->
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button Content="Update" Command="{Binding UpdateCommand}" Margin="0,0,4,4"
                    ToolTip="Evaluate the merit function on the project's lens and show each row's value and contribution."/>
            <Button Content="Insert operand" Command="{Binding InsertOperandCommand}" Margin="8,0,4,4"
                    ToolTip="Insert a BLNK row before the current one."/>
            <Button Content="Insert after" Command="{Binding InsertOperandAfterCommand}" Margin="0,0,4,4"/>
            <Button Content="Delete operand" Command="{Binding DeleteOperandCommand}" Margin="0,0,4,4"/>
            <Button Content="Undo" Command="{Binding UndoCommand}" Margin="8,0,4,4"/>
            <Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,4,4"/>
            <TextBlock Text="{Binding MeritValueText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,4,4"/>
        </WrapPanel>

        <Expander DockPanel.Dock="Top" Header="Find an operand" Margin="0,0,0,4">
            <DockPanel Margin="4">
                <controls:FormGrid DockPanel.Dock="Top" Width="360" HorizontalAlignment="Left">
                    <Label Content="Code or name"/>
                    <TextBox Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"/>
                </controls:FormGrid>
                <ListBox ItemsSource="{Binding FindResults}" MaxHeight="140" Margin="0,4,0,0"/>
            </DockPanel>
        </Expander>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ProblemsText}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource ErrorBrush}"/>
        </StackPanel>

        <sheet:SpreadsheetGrid x:Name="Grid" Document="{Binding Document}"/>
    </DockPanel>
</Window>
