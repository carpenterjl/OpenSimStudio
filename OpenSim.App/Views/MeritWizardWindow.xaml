<Window x:Class="OpenSim.App.Views.MeritWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        Title="Optimization Wizard" Width="560" Height="720" MinWidth="420" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}">
    <!-- OP-56: the Optimization Wizard. DataContext is the OpticsMeritWizardViewModel. Apply
         writes the default merit function into the Merit Function Editor at Start At (one undo
         step); OK applies and closes. The contrast (MTF) criterion is not built yet. -->
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="OK" Command="{Binding OkCommand}" Margin="0,0,4,4" MinWidth="70" IsDefault="True"
                    AutomationProperties.AutomationId="MeritWizardOkButton"/>
            <Button Content="Apply" Command="{Binding ApplyCommand}" Margin="0,0,4,4" MinWidth="70"
                    AutomationProperties.AutomationId="MeritWizardApplyButton"/>
            <Button Content="Close" IsCancel="True" Margin="0,0,4,4" MinWidth="70"/>
            <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Margin="12,0,4,4"
                    ToolTip="Save these settings with the project."/>
            <Button Content="Load Settings" Command="{Binding LoadSettingsCommand}" Margin="0,0,4,4"
                    ToolTip="Show the settings last saved."/>
            <Button Content="Reset Settings" Command="{Binding ResetSettingsCommand}" Margin="0,0,4,4"
                    ToolTip="Show the defaults."/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Optimization function" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <controls:FormGrid>
                    <Label Content="Criterion"/>
                    <ComboBox ItemsSource="{Binding Criteria}" SelectedValue="{Binding Criterion}" SelectedValuePath="Value" DisplayMemberPath="Label"
                              AutomationProperties.AutomationId="MeritWizardCriterionCombo"
                              ToolTip="Wavefront: OPD in waves. Spot: transverse ray aberrations. Angular: angular aberrations, for afocal systems."/>
                    <Label Content="Reference"/>
                    <ComboBox ItemsSource="{Binding References}" SelectedValue="{Binding Reference}" SelectedValuePath="Value" DisplayMemberPath="Label"
                              ToolTip="Centroid: the weighted centroid of the field's rays (wavefront: mean and tilt removed). Chief ray: the primary wavelength's chief ray (wavefront: mean removed)."/>
                    <Label Content="Ignore lateral colour"/>
                    <CheckBox IsChecked="{Binding IgnoreLateralColor}" VerticalAlignment="Center"
                              ToolTip="One reference per wavelength instead of one per field (centroid reference)."/>
                </controls:FormGrid>

                <TextBlock Text="Pupil integration" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <controls:FormGrid>
                    <Label Content="Method"/>
                    <ComboBox ItemsSource="{Binding Integrations}" SelectedValue="{Binding Integration}" SelectedValuePath="Value" DisplayMemberPath="Label"
                              ToolTip="Gaussian quadrature assumes an unvignetted pupil; when rays are vignetted the wizard writes the rectangular array instead and says so."/>
                    <Label Content="Rings"/>
                    <TextBox Text="{Binding Rings}" IsEnabled="{Binding IsGaussian}"
                             ToolTip="1 to 20. n rings integrate an aberration of order up to 2n − 1."/>
                    <Label Content="Arms"/>
                    <ComboBox ItemsSource="{Binding ArmsChoices}" SelectedItem="{Binding Arms}" IsEnabled="{Binding IsGaussian}"/>
                    <Label Content="Grid (rays across)"/>
                    <TextBox Text="{Binding Grid}" ToolTip="Rectangular array: 2 to 100 rays across; rays outside the pupil are left out."/>
                    <Label Content="Delete vignetted"/>
                    <CheckBox IsChecked="{Binding DeleteVignetted}" VerticalAlignment="Center"
                              ToolTip="Rectangular array: leave out the rows whose ray fails now."/>
                    <Label Content="Symmetry"/>
                    <ComboBox ItemsSource="{Binding SymmetryChoices}" SelectedValue="{Binding Symmetry}" SelectedValuePath="Value" DisplayMemberPath="Label"
                              ToolTip="Assuming axial symmetry halves the rows of fields on the y axis and keeps one row per ring on axis."/>
                </controls:FormGrid>

                <TextBlock Text="Boundary values (lens units)" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <controls:FormGrid>
                    <Label Content="Glass boundaries"/>
                    <CheckBox IsChecked="{Binding GlassBoundaries}" VerticalAlignment="Center" ToolTip="MNCG, MXCG and MNEG rows."/>
                    <Label Content="Glass minimum center thickness"/>
                    <TextBox Text="{Binding GlassMinimum}" IsEnabled="{Binding GlassBoundaries}"/>
                    <Label Content="Glass maximum center thickness"/>
                    <TextBox Text="{Binding GlassMaximum}" IsEnabled="{Binding GlassBoundaries}"/>
                    <Label Content="Glass minimum edge thickness"/>
                    <TextBox Text="{Binding GlassEdge}" IsEnabled="{Binding GlassBoundaries}"/>
                    <Label Content="Air boundaries"/>
                    <CheckBox IsChecked="{Binding AirBoundaries}" VerticalAlignment="Center" ToolTip="MNCA, MXCA and MNEA rows."/>
                    <Label Content="Air minimum center thickness"/>
                    <TextBox Text="{Binding AirMinimum}" IsEnabled="{Binding AirBoundaries}"/>
                    <Label Content="Air maximum center thickness"/>
                    <TextBox Text="{Binding AirMaximum}" IsEnabled="{Binding AirBoundaries}"/>
                    <Label Content="Air minimum edge thickness"/>
                    <TextBox Text="{Binding AirEdge}" IsEnabled="{Binding AirBoundaries}"/>
                </controls:FormGrid>

                <TextBlock Text="Other settings" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <controls:FormGrid>
                    <Label Content="Configurations"/>
                    <ComboBox ItemsSource="{Binding ConfigurationChoices}" SelectedValue="{Binding Configurations}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
                    <Label Content="Start at row"/>
                    <TextBox Text="{Binding StartAt}" ToolTip="The row the generated rows start at; 0 for the end. The default is the row after DMFS."/>
                    <Label Content="Overall weight"/>
                    <TextBox Text="{Binding OverallWeight}" ToolTip="Scales every weight the wizard writes."/>
                    <Label Content="Relative X weight"/>
                    <TextBox Text="{Binding RelativeXWeight}" ToolTip="Spot x + y and angular: the weight of the x rows; 0 leaves them out. Both 0: radial rows."/>
                    <Label Content="Relative Y weight"/>
                    <TextBox Text="{Binding RelativeYWeight}"/>
                    <Label Content="Relative S weight"/>
                    <TextBox Text="{Binding RelativeSWeight}" ToolTip="Contrast: the weight of the sagittal phase differences (MECS); 0 leaves them out."/>
                    <Label Content="Relative T weight"/>
                    <TextBox Text="{Binding RelativeTWeight}" ToolTip="Contrast: the weight of the tangential phase differences (MECT); 0 leaves them out."/>
                    <Label Content="Spatial frequency (cycles/mm)"/>
                    <TextBox Text="{Binding SpatialFrequency}" AutomationProperties.AutomationId="MeritWizardSpatialFrequency"
                             ToolTip="Contrast: the spatial frequency at which to optimize the MTF."/>
                </controls:FormGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
