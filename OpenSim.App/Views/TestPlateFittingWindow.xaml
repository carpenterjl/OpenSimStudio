<Window x:Class="OpenSim.App.Views.TestPlateFittingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        Title="Test Plate Fitting" Width="620" Height="520" MinWidth="420" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}">
    <!-- OP-17: Test Plate Fitting. DataContext is the OpticsTestPlateFittingViewModel. Fit fits
         every variable radius to the nearest plate of the list, re-optimizing the other variables
         after each, and writes the fitted design into the lens (one undoable edit of the Lens
         Data Editor). Show List shows the list as the Test Plate Lists tool does. -->
    <DockPanel Margin="8">
        <controls:FormGrid DockPanel.Dock="Top" IsEnabled="{Binding IsIdle}">
            <Label Content="Test plate list"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="4,0,0,0"
                        AutomationProperties.AutomationId="TestPlateBrowseButton"/>
                <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="A fabricator's test plate list in OpticStudio's .TPD layout: 'partname radius diameter code', millimeters."
                         AutomationProperties.AutomationId="TestPlateFileBox"/>
            </DockPanel>
            <Label Content="Method of fit"/>
            <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Label"
                      ToolTip="The order the radii are fitted in; Try All Methods keeps the order with the lowest merit."
                      AutomationProperties.AutomationId="TestPlateMethodCombo"/>
            <Label Content="Automatic cycles"/>
            <CheckBox IsChecked="{Binding AutomaticCycles}" VerticalAlignment="Center"
                      ToolTip="Each optimization runs until no progress is made; clear to set a number of cycles."/>
            <Label Content="Optimization cycles"/>
            <TextBox Text="{Binding CycleCount}"
                     ToolTip="Cycles of each optimization; used when Automatic cycles is cleared."/>
            <Label Content="Test wavelength (µm)"/>
            <TextBox Text="{Binding TestWavelength}"
                     ToolTip="The wavelength the fringes in the report are given at; the fitting order does not depend on it."/>
        </controls:FormGrid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,4">
            <Button Content="Fit" Command="{Binding FitCommand}" MinWidth="70" Margin="0,0,4,4"
                    AutomationProperties.AutomationId="TestPlateFitButton"/>
            <Button Content="Show List" Command="{Binding ShowListCommand}" MinWidth="70" Margin="0,0,4,4"
                    AutomationProperties.AutomationId="TestPlateShowListButton"/>
            <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="70" Margin="0,0,4,4"/>
            <Button Content="Close" Click="Close_Click" MinWidth="70" Margin="0,0,4,4"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,4"/>
        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 Foreground="{DynamicResource TextFaintBrush}"/>
    </DockPanel>
</Window>
