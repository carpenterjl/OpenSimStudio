<UserControl x:Class="OpenSim.App.Views.Panels.ReportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- On the Results step: the report describes a finished solve. -->
    <GroupBox Header="Report">
        <StackPanel>
            <TextBlock Text="The last solve as a document: what was solved, the summary values, every field's range, the assumptions the solver stated, and its log. The same report the command line writes."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
            <Button Content="Save report (Markdown / HTML)" Command="{Binding Solve.SaveReportCommand}"
                    IsEnabled="{Binding Solve.HasReport}"/>
            <TextBlock Text="No report yet. It covers a solve run with the Solve step's button; the CFD solve and the board tools do not write one." Style="{StaticResource FaintText}" Margin="0,2,0,0"
                       Visibility="{Binding Solve.HasReport, Converter={StaticResource InverseBoolToVis}}"/>
        </StackPanel>
    </GroupBox>
</UserControl>
