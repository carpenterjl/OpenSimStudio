<UserControl x:Class="OpenSim.App.Views.Panels.MagneticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- FU-47: planar magnetics (Feature 13, FU-39, FU-40) — the solve the command line's 'magnetics' command runs. -->
    <GroupBox Header="Planar magnetics (2-D axisymmetric section)" DataContext="{Binding Magnetics}">
        <StackPanel>
            <TextBlock Text="An inductor or transformer from the layout: the windings' copper is cut along a ray from the winding axis, each crossing one ring of an axisymmetric model, with an optional pot or ER core. Static or time-harmonic finite elements give the driven winding's inductance, AC resistance (skin and proximity effect) and mutuals, and the winding impedance matrix. The turns table can be filled by hand too."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>

            <TextBlock Text="Cut the windings from the board" FontWeight="Bold" Margin="0,4,0,2"/>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding HasBoard}">
                <ItemsControl x:Name="MagneticsNetList" ItemsSource="{Binding Nets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                      Foreground="{DynamicResource TextMutedBrush}" Margin="2,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <UniformGrid Columns="2" IsEnabled="{Binding HasBoard}" Margin="0,2,0,0">
                <Label Content="Axis x / y [mm]"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="MagneticsCenterXBox" Text="{Binding CenterXMm}" Margin="0,0,2,0"/>
                    <TextBox x:Name="MagneticsCenterYBox" Text="{Binding CenterYMm}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Cut angle [°] / angles averaged"/>
                <UniformGrid Columns="2">
                    <TextBox Text="{Binding CutAngleDegrees}" Margin="0,0,2,0"
                             ToolTip="The ray's direction from the axis (0° = +x). Ignored when more than one angle is averaged."/>
                    <TextBox Text="{Binding CutAngles}" Margin="2,0,0,0"
                             ToolTip="1 = one cut. More = each turn at its mean radius over that many angles round the axis, which folds a spiral's pitch in (lead-outs and terminals crossing some angles are dropped with a note)."/>
                </UniformGrid>
                <Label Content="Cut out to radius [mm]"/>
                <TextBox Text="{Binding MaxRadiusMm}"/>
            </UniformGrid>
            <UniformGrid Columns="2" Margin="0,3,0,0">
                <Button Content="Axis at the selected copper" Command="{Binding CenterOnWindingsCommand}" IsEnabled="{Binding HasBoard}"
                        ToolTip="The middle of the ticked nets' copper, and a radius past its farthest corner."/>
                <Button x:Name="MagneticsCutButton" Content="Cut the windings" Command="{Binding CutFromBoardCommand}"
                        IsEnabled="{Binding HasBoard}" Margin="2,0,0,0"
                        ToolTip="Fills the turns table below with every crossing of the ticked nets' copper; layer heights from the stackup panel."/>
            </UniformGrid>
            <TextBlock Text="{Binding CutResult}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>

            <TextBlock Text="Turns (r from the axis; z = 0 at the top copper surface, negative down)" FontWeight="Bold" Margin="0,6,0,2"/>
            <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Winding" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBlock Grid.Column="1" Text="Layer" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBlock Grid.Column="2" Text="r0 mm" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBlock Grid.Column="3" Text="r1 mm" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBlock Grid.Column="4" Text="z0 µm" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBlock Grid.Column="5" Text="z1 µm" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
            </Grid>
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MagneticsTurnList" ItemsSource="{Binding Turns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Winding}" ToolTip="The winding this turn belongs to; turns of one winding carry its current in series."/>
                                <TextBox Grid.Column="1" Text="{Binding Layer}"/>
                                <TextBox Grid.Column="2" Text="{Binding R0Mm}"/>
                                <TextBox Grid.Column="3" Text="{Binding R1Mm}"/>
                                <TextBox Grid.Column="4" Text="{Binding Z0Um}"/>
                                <TextBox Grid.Column="5" Text="{Binding Z1Um}"/>
                                <Button Grid.Column="6" Content="×" Padding="0" ToolTip="Remove this turn"
                                        Command="{Binding DataContext.RemoveTurnCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <UniformGrid Columns="2" Margin="0,2,0,0">
                <Button Content="Add a turn" Command="{Binding AddTurnCommand}"
                        ToolTip="Continues the last turn outward (same width and layer, 0.2 mm apart)."/>
                <Button Content="Clear the turns" Command="{Binding ClearTurnsCommand}" Margin="2,0,0,0"/>
            </UniformGrid>

            <TextBlock Text="Core" FontWeight="Bold" Margin="0,6,0,2"/>
            <UniformGrid Columns="2">
                <Label Content="Core"/>
                <ComboBox x:Name="MagneticsCoreCombo" ItemsSource="{Binding CoreKinds}" SelectedItem="{Binding CoreKind}"
                          ToolTip="A pot core is axisymmetric and exact here. An ER core's square legs become the ring of the same area (ErCore.ToAxisymmetric)."/>
            </UniformGrid>
            <UniformGrid Columns="2" Visibility="{Binding HasCore, Converter={StaticResource BoolToVis}}">
                <Label Content="Post radius [mm]"/>
                <TextBox Text="{Binding PostRadiusMm}"/>
                <Label Content="Window height [mm] / plates [mm]"/>
                <UniformGrid Columns="2">
                    <TextBox Text="{Binding WindowHeightMm}" Margin="0,0,2,0" ToolTip="Must be taller than the winding stack."/>
                    <TextBox Text="{Binding PlateThicknessMm}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Centre-post gap [mm] / µr"/>
                <UniformGrid Columns="2">
                    <TextBox Text="{Binding GapMm}" Margin="0,0,2,0"/>
                    <TextBox Text="{Binding CoreMu}" Margin="2,0,0,0" ToolTip="Linear relative permeability of the ferrite."/>
                </UniformGrid>
            </UniformGrid>
            <UniformGrid Columns="2" Visibility="{Binding IsPotCore, Converter={StaticResource BoolToVis}}">
                <Label Content="Window radius / outer radius [mm]"/>
                <UniformGrid Columns="2">
                    <TextBox Text="{Binding WindowRadiusMm}" Margin="0,0,2,0"/>
                    <TextBox Text="{Binding OuterRadiusMm}" Margin="2,0,0,0"/>
                </UniformGrid>
            </UniformGrid>
            <UniformGrid Columns="2" Visibility="{Binding IsErCore, Converter={StaticResource BoolToVis}}">
                <Label Content="Window width / leg width [mm]"/>
                <UniformGrid Columns="2">
                    <TextBox Text="{Binding WindowWidthMm}" Margin="0,0,2,0"/>
                    <TextBox Text="{Binding LegWidthMm}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Leg depth [mm]"/>
                <TextBox Text="{Binding DepthMm}" ToolTip="The outer legs' depth: their area sets the equivalent wall's radius."/>
            </UniformGrid>

            <TextBlock Text="Solve" FontWeight="Bold" Margin="0,6,0,2"/>
            <UniformGrid Columns="2">
                <Label Content="Frequency [kHz] (0 = static)"/>
                <TextBox x:Name="MagneticsFrequencyBox" Text="{Binding FrequencyKhz}"
                         ToolTip="0: magnetostatic, the inductance only. Above 0: time-harmonic; solid turns show skin and proximity effect."/>
                <Label Content="Driven winding (1 A)"/>
                <ComboBox x:Name="MagneticsDriveCombo" ItemsSource="{Binding Windings}" SelectedItem="{Binding DriveWinding}"/>
                <Label Content="Strand ⌀ [mm] / strands per turn"/>
                <UniformGrid Columns="2">
                    <TextBox Text="{Binding StrandDiameterMm}" Margin="0,0,2,0"
                             ToolTip="A stranded (litz) winding: the strands' skin and proximity loss homogenised from the local field. 0 = solid copper turns."/>
                    <TextBox Text="{Binding StrandsPerTurn}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Copper σ [S/m]"/>
                <TextBox Text="{Binding CopperConductivity}"/>
            </UniformGrid>
            <Button x:Name="MagneticsSolveButton" Content="Solve the section" Command="{Binding SolveCommand}" Margin="0,3,0,0"/>
            <TextBlock x:Name="MagneticsResultText" Text="{Binding Result}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
            <ItemsControl ItemsSource="{Binding ResultLines}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Image Source="{Binding FieldImage}" MaxHeight="520" Margin="0,4,0,0" Stretch="Uniform"
                   AutomationProperties.AutomationId="MagneticsFieldImage"
                   ToolTip="Peak |B| over a cycle on the r–z section, three decades below the largest; the regions of the model are outlined."/>

            <TextBlock Text="Winding impedance matrix (AC)" FontWeight="Bold" Margin="0,6,0,2"/>
            <TextBlock Text="One solid-turn solve per winding. A lead-out trace adds its DC resistance and partial self-inductance in series on its own winding (no coupling to the rings)."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
            <ItemsControl ItemsSource="{Binding LeadOuts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Winding, StringFormat='Lead-out of {0} (length, width mm)'}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding LengthMm}" ToolTip="Length [mm]; 0 = none"/>
                            <TextBox Grid.Column="2" Text="{Binding WidthMm}" ToolTip="Width [mm]"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <UniformGrid Columns="2" Margin="0,3,0,0">
                <Button Content="Solve the impedance matrix" Command="{Binding SolveMatrixCommand}"/>
                <Button Content="Save report" Command="{Binding SaveReportCommand}" IsEnabled="{Binding HasResult}" Margin="2,0,0,0"/>
            </UniformGrid>
            <TextBlock Text="{Binding MatrixResult}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Assumptions}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
        </StackPanel>
    </GroupBox>
</UserControl>
