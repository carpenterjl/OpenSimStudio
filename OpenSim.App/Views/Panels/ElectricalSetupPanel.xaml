<UserControl x:Class="OpenSim.App.Views.Panels.ElectricalSetupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GroupBox Header="Electrical simulation setup"
              Visibility="{Binding Session.IsElectricalAnalysis, Converter={StaticResource BoolToVis}}">
        <StackPanel>
            <!-- Step 1: net + mesh -->
            <TextBlock Text="1. Net" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding Pcb.SelectedNet.Label, FallbackValue='No net selected — pick one in the PCB nets list or click copper in the view.'}"
                       TextWrapping="Wrap" Margin="0,0,0,2"/>
            <TextBlock Text="Mesh the net from the Meshing panel." FontSize="11"
                       Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>

            <!-- Step 2: electrodes -->
            <TextBlock Text="2. Electrodes" FontWeight="Bold" Margin="0,8,0,2"/>
            <TextBlock Text="{Binding Electrodes.ElectrodeInfo}" TextWrapping="Wrap" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <UniformGrid Columns="2">
                <Label Content="Source (＋)"/>
                <ComboBox x:Name="SourceCombo"
                          ItemsSource="{Binding Electrodes.PadElectrodes}" SelectedItem="{Binding Electrodes.SelectedSource}"
                          DisplayMemberPath="Label"/>
                <Label Content="Sink (0 V)"/>
                <ComboBox x:Name="SinkCombo"
                          ItemsSource="{Binding Electrodes.PadElectrodes}" SelectedItem="{Binding Electrodes.SelectedSink}"
                          DisplayMemberPath="Label"/>
            </UniformGrid>
            <TextBlock Text="Gold = selectable pad, green = source, red = sink. Click pads in the view to assign."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>

            <!-- Step 3: excitation + solve -->
            <TextBlock Text="3. Excitation &amp; solve" FontWeight="Bold" Margin="0,8,0,2"/>
            <UniformGrid Columns="2">
                <RadioButton x:Name="VoltageDrive" Content="Voltage [V]" GroupName="Excitation"
                             IsChecked="True" Foreground="{DynamicResource TextMutedBrush}"
                             VerticalAlignment="Center" Margin="2,1"/>
                <TextBox Text="{Binding Electrodes.TestVoltage}"
                         IsEnabled="{Binding IsChecked, ElementName=VoltageDrive}"/>
                <RadioButton x:Name="CurrentDrive" Content="Current [A]" GroupName="Excitation"
                             IsChecked="{Binding Electrodes.DriveWithCurrent, Mode=TwoWay}" Foreground="{DynamicResource TextMutedBrush}"
                             VerticalAlignment="Center" Margin="2,1"
                             ToolTip="Inject this current at the source pad; the sink is held at 0 V"/>
                <TextBox Text="{Binding Electrodes.TestCurrent}"
                         IsEnabled="{Binding IsChecked, ElementName=CurrentDrive}"/>
            </UniformGrid>
            <Button Content="Run electrical test" Command="{Binding Electrodes.RunElectricalTestCommand}"/>
            <TextBlock Text="{Binding Electrodes.ElectricalResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>

            <!-- Step 4: lumped AC impedance estimate -->
            <TextBlock Text="4. AC impedance (R + jωL estimate)" FontWeight="Bold" Margin="0,8,0,2"/>
            <UniformGrid Columns="2">
                <Label Content="f min [Hz]"/>
                <TextBox Text="{Binding Electrodes.AcFMin}"/>
                <Label Content="f max [Hz]"/>
                <TextBox Text="{Binding Electrodes.AcFMax}"/>
                <Label Content="Points"/>
                <TextBox Text="{Binding Electrodes.AcPoints}"/>
            </UniformGrid>
            <Button x:Name="EstimateAcButton" Content="Estimate AC impedance"
                    Command="{Binding Electrodes.EstimateAcImpedanceCommand}"/>
            <TextBlock Text="{Binding Electrodes.AcResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
            <ItemsControl ItemsSource="{Binding Electrodes.AcSweep}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <UniformGrid Columns="3">
                            <TextBlock Text="{Binding Frequency, StringFormat='f = {0:g3} Hz'}" FontSize="11"/>
                            <TextBlock Text="{Binding Magnitude, StringFormat='|Z| = {0:g4} Ω'}" FontSize="11"/>
                            <TextBlock Text="{Binding PhaseDegrees, StringFormat='∠ {0:g3}°'}" FontSize="11"/>
                        </UniformGrid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Electrodes.AcAssumptions}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>

            <!-- Step 5: PEEC inductance from centerlines (no meshing needed) -->
            <TextBlock Text="5. Inductance (PEEC, from centerlines)" FontWeight="Bold" Margin="0,8,0,2"/>
            <TextBlock Text="Works from the imported board — no meshing needed. Failures name the exact reason."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
            <UniformGrid Columns="2">
                <Label Content="Net"/>
                <ComboBox x:Name="InductanceNetCombo"
                          ItemsSource="{Binding Inductance.Nets}"
                          SelectedItem="{Binding Inductance.OutboundNet}"
                          DisplayMemberPath="Label"/>
            </UniformGrid>
            <Button Content="Compute self inductance" Command="{Binding Inductance.ComputeSelfCommand}"/>
            <TextBlock Text="{Binding Inductance.SelfResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
            <UniformGrid Columns="2" Margin="0,4,0,0">
                <Label Content="Second net"/>
                <ComboBox x:Name="SecondNetCombo"
                          ItemsSource="{Binding Inductance.Nets}"
                          SelectedItem="{Binding Inductance.SecondNet}"
                          DisplayMemberPath="Label"/>
            </UniformGrid>
            <Button x:Name="ComputeMutualButton" Content="Compute mutual (M, k)"
                    Command="{Binding Inductance.ComputeMutualCommand}"/>
            <TextBlock Text="{Binding Inductance.MutualResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
            <UniformGrid Columns="2" Margin="0,4,0,0">
                <RadioButton x:Name="ReturnNetRadio" Content="Return: second net" GroupName="LoopReturn"
                             IsChecked="True" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,1"/>
                <RadioButton x:Name="ReturnPlaneRadio" Content="Return: plane layer" GroupName="LoopReturn"
                             IsChecked="{Binding Inductance.ReturnIsPlane, Mode=TwoWay}"
                             Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,1"/>
                <Label Content="Plane layer"/>
                <ComboBox x:Name="PlaneLayerCombo"
                          ItemsSource="{Binding Inductance.PlaneLayers}"
                          SelectedItem="{Binding Inductance.PlaneLayer}"
                          ItemStringFormat="L{0}"
                          IsEnabled="{Binding IsChecked, ElementName=ReturnPlaneRadio}"/>
            </UniformGrid>
            <Button x:Name="ComputeLoopButton" Content="Compute loop inductance"
                    Command="{Binding Inductance.ComputeLoopCommand}"/>
            <TextBlock Text="{Binding Inductance.LoopResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Inductance.InductanceAssumptions}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>

            <TextBlock Text="R and L against frequency (skin and proximity effect)" FontWeight="Bold" Margin="0,6,0,2"/>
            <TextBlock Text="Filament solve of the same path. A loop returns through the second net, or — with 'Return: plane layer' — through the copper of that layer, meshed around the path."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
            <UniformGrid Columns="2">
                <Label Content="Path"/>
                <ComboBox x:Name="AcPathCombo" ItemsSource="{Binding Inductance.AcPaths}"
                          SelectedItem="{Binding Inductance.AcPath}"/>
                <Label Content="Frequencies [MHz]"/>
                <TextBox x:Name="AcFrequenciesBox" Text="{Binding Inductance.AcFrequenciesMhz}"/>
            </UniformGrid>
            <Button x:Name="ComputeAcButton" Content="Solve R(f) and L(f)"
                    Command="{Binding Inductance.ComputeFrequencyDependentCommand}"/>
            <TextBlock Text="{Binding Inductance.AcResult}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            <UniformGrid Columns="2" Margin="0,3,0,0">
                <Button Content="Save SPICE subcircuit" Command="{Binding Inductance.ExportSpiceCommand}"
                        IsEnabled="{Binding Inductance.HasAcResult}"
                        ToolTip="R, L and their coupling as solved at the highest frequency in the list."/>
                <Button Content="Save Touchstone" Command="{Binding Inductance.ExportTouchstoneCommand}"
                        IsEnabled="{Binding Inductance.HasAcResult}" Margin="2,0,0,0"/>
            </UniformGrid>
            <TextBlock Text="{Binding Inductance.AcAssumptions}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>

            <!-- Step 6: rail-level DC (several sources and loads on the meshed net) -->
            <TextBlock Text="6. Power rail (IR drop)" FontWeight="Bold" Margin="0,8,0,2"/>
            <TextBlock Text="Give pads of the meshed net a role. Source: volts and output resistance [mΩ]. Load: amperes. Pads of one component with the same role are one terminal."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RailPadList" ItemsSource="{Binding Rail.Pads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"/>
                                <TextBox Grid.Column="2" Text="{Binding Value}"
                                         ToolTip="Source: volts. Load: amperes."/>
                                <TextBox Grid.Column="3" Text="{Binding OutputMilliohms}"
                                         ToolTip="Source output resistance [mΩ]; not used on a load."/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <UniformGrid Columns="2" Margin="0,4,0,0">
                <Label Content="Nominal [V] (0 = source)"/>
                <TextBox Text="{Binding Rail.NominalVolts}"/>
                <Label Content="Drop limit [%]"/>
                <TextBox Text="{Binding Rail.DropLimitPercent}"/>
                <Label Content="Density limit [A/mm²]"/>
                <TextBox Text="{Binding Rail.CurrentDensityLimit}"
                         ToolTip="Copper above this is listed as a neck-down. 0 = list the densest spot only."/>
                <Label Content="Via limit [A]"/>
                <TextBox Text="{Binding Rail.ViaCurrentLimit}" ToolTip="0 = not checked."/>
                <Label Content="Copper σ [S/m]"/>
                <TextBox Text="{Binding Rail.CopperConductivity}"/>
            </UniformGrid>
            <Button x:Name="SolveRailButton" Content="Solve rail" Command="{Binding Rail.SolveRailCommand}"/>
            <Button x:Name="SolveRailThermalButton" Content="Solve rail with self-heating"
                    Command="{Binding Rail.SolveRailThermalCommand}"
                    ToolTip="Copper loss heats the board, the environment (Thermal workspace) cools it, copper resistivity follows temperature. Mesh the net with the laminate first."/>
            <TextBlock Text="{Binding Rail.RailResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
            <ItemsControl ItemsSource="{Binding Rail.ResultLines}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Rail.RailAssumptions}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>

            <!-- Step 7: junction temperatures of the board's parts (two-resistor models on the whole board) -->
            <TextBlock Text="7. Component temperatures" FontWeight="Bold" Margin="0,8,0,2"/>
            <TextBlock Text="Per part: power [W], θJC and θJB [K/W] from the datasheet, contact size [mm], heatsink [K/W] (0 = bare case). Parts at 0 W are left out. The whole board is meshed with its copper; the Thermal workspace's environment cools it."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
            <UniformGrid Columns="2">
                <Button Content="Parts from the board" Command="{Binding Pcb.ListThermalPartsCommand}"
                        ToolTip="Component names on the pads: IPC-2581, or Gerber with X2 attributes."/>
                <Button Content="Load placement file" Command="{Binding Pcb.LoadPlacementFileCommand}" Margin="2,0,0,0"
                        ToolTip="Pick-and-place table with designator, X, Y, rotation and side columns."/>
            </UniformGrid>
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Pcb.ThermalParts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                <TextBox Grid.Column="1" Text="{Binding PowerWatts}" ToolTip="Power [W]"/>
                                <TextBox Grid.Column="2" Text="{Binding ThetaJc}" ToolTip="θJC, junction to case top [K/W]"/>
                                <TextBox Grid.Column="3" Text="{Binding ThetaJb}" ToolTip="θJB, junction to board [K/W]"/>
                                <TextBox Grid.Column="4" Text="{Binding WidthMm}" ToolTip="Contact width along x [mm]"/>
                                <TextBox Grid.Column="5" Text="{Binding HeightMm}" ToolTip="Contact height along y [mm]"/>
                                <TextBox Grid.Column="6" Text="{Binding HeatsinkKelvinPerWatt}"
                                         ToolTip="Case top to ambient through a heatsink [K/W]; 0 = bare case top in air."/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <UniformGrid Columns="2" Margin="0,4,0,0">
                <Label Content="Case-top film [W/(m²·K)]"/>
                <TextBox Text="{Binding Pcb.CaseFilmCoefficient}"
                         ToolTip="Convection and radiation together on a bare case top. A setting, not computed."/>
                <Label Content="Board element [mm] (0 = auto)"/>
                <TextBox Text="{Binding Pcb.ThermalEdgeMm}"/>
            </UniformGrid>
            <Button Content="Solve component temperatures" Command="{Binding Pcb.SolveComponentTemperaturesCommand}"/>
            <TextBlock Text="{Binding Pcb.ComponentResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
            <ItemsControl ItemsSource="{Binding Pcb.ComponentResultLines}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Pcb.ComponentAssumptions}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>

        </StackPanel>
    </GroupBox>
</UserControl>
