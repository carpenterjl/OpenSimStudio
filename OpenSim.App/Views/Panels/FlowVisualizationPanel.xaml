<UserControl x:Class="OpenSim.App.Views.Panels.FlowVisualizationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Only the conjugate (CFD) analysis has an airflow to show — the Stage 1
         correlation analysis never grows a flow control (a locked scope rule). -->
    <GroupBox Header="Airflow (CFD)"
              Visibility="{Binding Session.IsConjugateHeatFlowAnalysis, Converter={StaticResource BoolToVis}}">
        <StackPanel>
            <TextBlock x:Name="FlowSummaryText" Text="{Binding Flow.FlowSummary}"
                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="2,4"/>

            <StackPanel Visibility="{Binding Flow.HasFlowResult, Converter={StaticResource BoolToVis}}">
                <CheckBox x:Name="FlowArrowsCheck" Content="Velocity arrows"
                          IsChecked="{Binding Flow.ShowArrows}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,2"/>
                <CheckBox x:Name="FlowStreamlinesCheck" Content="Streamlines"
                          IsChecked="{Binding Flow.ShowStreamlines}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,2"/>
                <CheckBox x:Name="FlowSliceCheck" Content="Contour slice"
                          IsChecked="{Binding Flow.ShowSlice}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,2"/>
                <UniformGrid Columns="2"
                             Visibility="{Binding Flow.ShowSlice, Converter={StaticResource BoolToVis}}">
                    <Label Content="Quantity"/>
                    <ComboBox x:Name="SliceQuantityCombo" SelectedIndex="{Binding Flow.SliceQuantity}"
                              ToolTip="Temperature is the heat-exchanger view: the fluid contour through the passage">
                        <ComboBoxItem Content="Speed"/>
                        <ComboBoxItem Content="Temperature"/>
                        <ComboBoxItem Content="Pressure"/>
                    </ComboBox>
                    <Label Content="Slice normal"/>
                    <ComboBox x:Name="SliceAxisCombo" SelectedIndex="{Binding Flow.SliceAxis}">
                        <ComboBoxItem Content="X"/>
                        <ComboBoxItem Content="Y"/>
                        <ComboBoxItem Content="Z"/>
                    </ComboBox>
                    <Label Content="Position"/>
                    <Slider x:Name="SliceFractionSlider" Minimum="0" Maximum="1"
                            Value="{Binding Flow.SliceFraction}"
                            IsMoveToPointEnabled="True"/>
                </UniformGrid>
                <StackPanel Visibility="{Binding Flow.ShowSlice, Converter={StaticResource BoolToVis}}">
                    <CheckBox x:Name="SliceFixedRangeCheck" Content="Fixed colour range"
                              IsChecked="{Binding Flow.SliceFixedRange}"
                              Foreground="{DynamicResource TextMutedBrush}" Margin="2,2"
                              ToolTip="Pins the colour scale so two runs (or a run and a published figure) compare directly"/>
                    <UniformGrid Columns="2"
                                 Visibility="{Binding Flow.SliceFixedRange, Converter={StaticResource BoolToVis}}">
                        <Label Content="Min"/>
                        <TextBox x:Name="SliceMinBox" Text="{Binding Flow.SliceMin}"/>
                        <Label Content="Max"/>
                        <TextBox x:Name="SliceMaxBox" Text="{Binding Flow.SliceMax}"/>
                    </UniformGrid>
                    <TextBlock x:Name="SliceLegendText" Text="{Binding Flow.SliceLegend}"
                               Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                               Margin="2,2"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </GroupBox>
</UserControl>
