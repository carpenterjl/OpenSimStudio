<UserControl x:Class="OpenSim.App.Views.Panels.ElectricalConditionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenSim.App.Controls">
    <GroupBox Header="Electrical conditions (select faces first)"
              Visibility="{Binding Session.IsElectricalAnalysis, Converter={StaticResource BoolToVis}}">
        <StackPanel>
            <controls:FormGrid>
                <Label Content="Voltage [V]"/>
                <TextBox Text="{Binding Conditions.VoltageValue}"/>
            </controls:FormGrid>
            <Button Content="Add voltage" Command="{Binding Conditions.AddVoltageCommand}"/>
            <controls:FormGrid Margin="0,6,0,0">
                <Label Content="Current [A]"/>
                <TextBox Text="{Binding Conditions.CurrentValue}"/>
            </controls:FormGrid>
            <CheckBox Content="Equipotential terminal" IsChecked="{Binding Conditions.CurrentEquipotential}"
                      Foreground="{DynamicResource TextMutedBrush}" Margin="2,2,2,0"
                      ToolTip="One potential over the whole face, found by the solve, carrying the total current — a metal pad or a bus bar end. Unchecked: the current enters at uniform density and the face is not an equipotential."/>
            <Button Content="Add current flow" Command="{Binding Conditions.AddCurrentCommand}"/>
            <!-- FU-42 / FU-47: a prescribed charge (electrostatics) -->
            <StackPanel Visibility="{Binding Session.IsElectrostaticAnalysis, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                <controls:FormGrid>
                    <Label Content="Charge [C]"/>
                    <TextBox x:Name="ChargeValueBox" Text="{Binding Conditions.ChargeValue}"/>
                </controls:FormGrid>
                <Button x:Name="AddChargeButton" Content="Add charge" Command="{Binding Conditions.AddChargeCommand}"
                        ToolTip="On a conductor: the whole conductor floats at the potential this net charge gives it (the solve reports it). On a dielectric face: a uniform surface charge, total exact."/>
            </StackPanel>
        </StackPanel>
    </GroupBox>
</UserControl>
