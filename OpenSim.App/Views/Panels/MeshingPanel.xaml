<UserControl x:Class="OpenSim.App.Views.Panels.MeshingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- THE meshing panel: every mesh control lives here, adapting to context.
         The detail slider drives both the generic mesher and the PCB net mesher. -->
    <GroupBox Header="Meshing">
        <StackPanel>
            <DockPanel>
                <Label Content="Detail" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="72"
                           TextAlignment="Right" Text="{Binding Meshing.EdgeLengthDisplay}"/>
                <Slider x:Name="EdgeLengthSlider" Minimum="0.00005" Maximum="0.002" SmallChange="0.00005"
                        LargeChange="0.0002" TickFrequency="0.00005"
                        Value="{Binding Meshing.EdgeLengthSlider}" Margin="4,0"
                        ToolTip="Fine (left) → coarse (right); moving this turns off Auto"/>
            </DockPanel>
            <CheckBox x:Name="AutoEdgeLengthCheck" Content="Auto edge length" IsChecked="{Binding Meshing.AutoEdgeLength}"
                      Foreground="{DynamicResource TextMutedBrush}" Margin="2,2"/>

            <!-- Generic geometry context -->
            <StackPanel Visibility="{Binding Session.IsPcbMode, Converter={StaticResource InverseBoolToVis}}">
                <DockPanel Margin="0,4,0,2">
                    <Label Content="Method" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MeshMethodCombo" ItemsSource="{Binding Meshing.MeshMethods}"
                              DisplayMemberPath="Label" SelectedValuePath="Method"
                              SelectedValue="{Binding Meshing.MeshMethod}" Margin="4,0,0,0"
                              ToolTip="Structured lattice puts nodes exactly on the geometric faces and edges, but only fits axis-aligned box bodies."/>
                </DockPanel>

                <!-- Structured lattice: element family, then explicit edge divisions -
                     the way a mapped mesh is specified. -->
                <StackPanel Visibility="{Binding Meshing.IsStructured, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,4,0,2">
                        <Label Content="Elements" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ElementShapeCombo" ItemsSource="{Binding Meshing.ElementShapes}"
                                  DisplayMemberPath="Label" SelectedValuePath="Shape"
                                  SelectedValue="{Binding Meshing.ElementShape}" Margin="4,0,0,0"
                                  ToolTip="Hexahedra are the mapped brick mesh a commercial code lays on a block, and the element family the reference beam study used. Structural solves only."/>
                    </DockPanel>
                    <TextBlock Text="Edge divisions" Margin="2,2,0,2" Foreground="{DynamicResource TextMutedBrush}"/>
                    <UniformGrid Columns="3">
                        <TextBox x:Name="LatticeNxBox" Text="{Binding Meshing.LatticeNx}" Margin="2" ToolTip="Cells along X"/>
                        <TextBox x:Name="LatticeNyBox" Text="{Binding Meshing.LatticeNy}" Margin="2" ToolTip="Cells along Y"/>
                        <TextBox x:Name="LatticeNzBox" Text="{Binding Meshing.LatticeNz}" Margin="2" ToolTip="Cells along Z"/>
                    </UniformGrid>
                </StackPanel>

                <CheckBox x:Name="QuadraticElementsCheck" Content="{Binding Meshing.QuadraticLabel}"
                          IsChecked="{Binding Meshing.QuadraticElements}"
                          IsEnabled="{Binding Meshing.QuadraticOrderIsAChoice}"
                          Foreground="{DynamicResource TextMutedBrush}" Margin="2,2"
                          ToolTip="Quadratic elements fix TET4's bending stiffness; hexahedra are HEX20 only, so the choice is not offered there. Structural solves only — electrical/thermal need linear tetrahedral meshes."/>
                <Button x:Name="GenerateMeshButton" Content="Generate mesh" Command="{Binding Meshing.GenerateMeshCommand}"/>
            </StackPanel>

            <!-- PCB net context -->
            <StackPanel Visibility="{Binding Session.IsPcbMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Pcb.SelectedNet.Label, FallbackValue='No net selected — pick one in the PCB nets list or click copper in the view.'}"
                           TextWrapping="Wrap" Margin="0,2,0,2"/>
                <CheckBox x:Name="MeshWithLaminateCheck" Content="Include the laminate (for electro-thermal)"
                          IsChecked="{Binding Pcb.MeshWithLaminate}"
                          Foreground="{DynamicResource TextMutedBrush}" Margin="2,2"
                          ToolTip="Meshes the dielectric under and around the net as a second region, conformal with the copper. Only this net's copper is included."/>
                <DockPanel Visibility="{Binding Pcb.MeshWithLaminate, Converter={StaticResource BoolToVis}}">
                    <Label Content="Laminate margin [mm]" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Pcb.LaminateMarginMm}" Margin="4,0,0,0"
                             ToolTip="Laminate is meshed within this distance of the net. 0 = the whole board (a large mesh at a trace's resolution)."/>
                </DockPanel>
                <Button Content="Mesh selected net" Command="{Binding Pcb.MeshSelectedNetCommand}"/>
            </StackPanel>

            <TextBlock x:Name="MeshInfoText" Text="{Binding Meshing.MeshInfo}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextFaintBrush}"/>
        </StackPanel>
    </GroupBox>
</UserControl>
