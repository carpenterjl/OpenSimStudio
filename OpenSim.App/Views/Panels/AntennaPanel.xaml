<UserControl x:Class="OpenSim.App.Views.Panels.AntennaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenSim.App.ViewModels">
    <!-- Moved verbatim out of ElectricalSetupPanel when RF became its own workspace (design screens 11-12); bindings go through the shell DataContext unchanged. -->
    <GroupBox Header="Antenna (method of moments)">
        <StackPanel>
            <!-- Step 6: antenna simulator (thin-wire + RWG surface MoM; free space,
                 PEC ground, or a dielectric substrate via the layered Green's function) -->
            <TextBlock Text="Thin wires and RWG surfaces in free space or over an infinite PEC ground (image theory). Surface metal can sit on a dielectric substrate (εr, tanδ): a rigorous layered-media Green's function with surface waves — set εr = 1 for air. Works from the imported board's centerlines, a copper island, or a wizard shape; no meshing needed."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
            <UniformGrid Columns="2">
                <Label Content="Geometry"/>
                <ComboBox x:Name="AntennaSourceCombo"
                          ItemsSource="{Binding Antenna.SourceModes}"
                          SelectedItem="{Binding Antenna.SourceMode}"/>
                <Label Content="Net"/>
                <ComboBox x:Name="AntennaNetCombo"
                          ItemsSource="{Binding Antenna.Nets}"
                          SelectedItem="{Binding Antenna.AntennaNet}"
                          DisplayMemberPath="Label"/>
                <Label Content="Dipole length [mm]"/>
                <TextBox Text="{Binding Antenna.DipoleLengthMm}"/>
                <Label Content="Loop radius [mm]"/>
                <TextBox Text="{Binding Antenna.LoopRadiusMm}"/>
                <Label Content="Monopole height [mm]"/>
                <TextBox Text="{Binding Antenna.MonopoleHeightMm}"/>
                <Label Content="Wire radius [mm]"/>
                <TextBox Text="{Binding Antenna.WireRadiusMm}"/>
                <Label Content="Plate/patch W×L [mm]"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="PlateWidthBox" Text="{Binding Antenna.PlateWidthMm}" Margin="0,0,2,0"/>
                    <TextBox x:Name="PlateLengthBox" Text="{Binding Antenna.PlateLengthMm}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Patch height [mm]"/>
                <TextBox x:Name="PatchHeightBox" Text="{Binding Antenna.PatchHeightMm}"
                         ToolTip="Gap between the patch metal and the ground plane (RWG patch mode). With a substrate εr &gt; 1 this is the dielectric slab thickness."/>
                <Label Content="Substrate εr / tanδ"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="SubstrateEpsRBox" Text="{Binding Antenna.SubstrateEpsR}" Margin="0,0,2,0"
                             ToolTip="Dielectric constant of the slab filling the gap under surface (RWG) metal. εr = 1 = air (PEC image theory); εr &gt; 1 engages the rigorous layered-media Green's function, surface waves included."/>
                    <TextBox Text="{Binding Antenna.SubstrateTanD}" Margin="2,0,0,0"
                             ToolTip="Substrate loss tangent (0 = lossless)"/>
                </UniformGrid>
                <Label Content="Probe x/y [mm] (probe-fed patch)"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="ProbeXBox" Text="{Binding Antenna.ProbeXMm}" Margin="0,0,2,0"
                             ToolTip="Coaxial probe feed position from the patch centre (Stage E). The probe snaps to the nearest mesh vertex; a good inset off the radiating edge sets the input resistance ∝ cos²(πx/L)."/>
                    <TextBox x:Name="ProbeYBox" Text="{Binding Antenna.ProbeYMm}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Probe bore [mm] / segments"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="ProbeRadiusBox" Text="{Binding Antenna.ProbeRadiusMm}" Margin="0,0,2,0"
                             ToolTip="Coax inner-conductor radius. The slab must be thick enough that each tube segment ≥ 2·radius (the reduced thin-wire kernel's validity floor)."/>
                    <TextBox x:Name="ProbeSegmentsBox" Text="{Binding Antenna.ProbeSegments}" Margin="2,0,0,0"
                             ToolTip="Number of vertical tube segments across the slab (≥ 2)."/>
                </UniformGrid>
                <Label Content="Cover thickness [mm] (covered patch)"/>
                <TextBox x:Name="CoverThicknessBox" Text="{Binding Antenna.CoverThicknessMm}"
                         ToolTip="Dielectric cover thickness above the buried patch (covered-patch mode, Stage F multi-layer). The cover loads the patch, so the resonance drops below the bare patch's — further with a thicker or denser cover."/>
                <Label Content="Cover εr / tanδ (blank = substrate)"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="CoverEpsRBox" Text="{Binding Antenna.CoverEpsR}" Margin="0,0,2,0"
                             ToolTip="Superstrate relative permittivity. Leave at 0 to track the substrate (the matched-cover default). Any εr ≥ 1 is supported — the buried-source read-out is single-valued across the ε jump."/>
                    <TextBox x:Name="CoverTanDBox" Text="{Binding Antenna.CoverTanD}" Margin="2,0,0,0"
                             ToolTip="Superstrate loss tangent. Negative tracks the substrate's."/>
                </UniformGrid>
                <Label Content="Attached wire L [mm] / angle [°]"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="AttachedWireLengthBox" Text="{Binding Antenna.AttachedWireLengthMm}" Margin="0,0,2,0"
                             ToolTip="Length of the thin wire that ENDS on the plate (wire-fed plate mode, Stage D1). It uses the wire radius above."/>
                    <TextBox x:Name="AttachedWireAngleBox" Text="{Binding Antenna.AttachedWireDegrees}" Margin="2,0,0,0"
                             ToolTip="Angle the wire makes with the sheet: 90° is the classical normal monopole. Below 10° the reduced-kernel tube overlaps the metal and the solve refuses by name."/>
                </UniformGrid>
                <Label Content="Attach x/y [mm] (wire-fed plate)"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="AttachXBox" Text="{Binding Antenna.AttachXMm}" Margin="0,0,2,0"
                             ToolTip="Where the wire lands, measured from the plate centre. The plate is meshed with this point snapped in as a vertex, so the attachment fan has its anchor."/>
                    <TextBox x:Name="AttachYBox" Text="{Binding Antenna.AttachYMm}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Island (RWG)"/>
                <ComboBox x:Name="AntennaIslandCombo"
                          ItemsSource="{Binding Antenna.AntennaIslands}"
                          SelectedItem="{Binding Antenna.AntennaIsland}"
                          DisplayMemberPath="Label"/>
                <CheckBox x:Name="GroundPlaneCheck" Content="Ground plane (PEC)"
                          IsChecked="{Binding Antenna.UseGroundPlane}"
                          Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,1"
                          ToolTip="Infinite perfect-conductor ground via image theory. The monopole always uses it."/>
                <TextBox Text="{Binding Antenna.GroundZMm}"
                         ToolTip="Ground plane z [mm]"/>
                <Label Content="Height above ground [mm]"/>
                <TextBox Text="{Binding Antenna.HeightAboveGroundMm}"
                         ToolTip="Wizard dipole/loop shapes are lifted this far above the plane; net geometry keeps its board coordinates."/>
                <Label Content="Feed at junction"/>
                <ComboBox x:Name="JunctionFeedCombo"
                          ItemsSource="{Binding Antenna.JunctionFeedOptions}"
                          SelectedIndex="{Binding Antenna.JunctionFeedIndex}"
                          IsEnabled="{Binding Antenna.HasJunctionFeedOptions}"
                          ToolTip="Wire models only, when the feed lands where three or more wires meet: the delta gap sits between two of them, and this picks which two. Filled after a solve."/>
                <Label Content="f [MHz]"/>
                <TextBox x:Name="FrequencyBox" Text="{Binding Antenna.FrequencyMHz}"/>
                <Label Content="Sweep f min [MHz]"/>
                <TextBox x:Name="SweepFMinBox" Text="{Binding Antenna.SweepFMinMHz}"/>
                <Label Content="Sweep f max [MHz]"/>
                <TextBox x:Name="SweepFMaxBox" Text="{Binding Antenna.SweepFMaxMHz}"/>
                <Label Content="Sweep points"/>
                <TextBox x:Name="SweepPointsBox" Text="{Binding Antenna.SweepPoints}"/>
                <Label Content="Mesh: elements per λ"/>
                <TextBox x:Name="MeshCellsBox" Text="{Binding Antenna.MeshCellsPerWavelength}"
                         ToolTip="Surface mesh density: elements per (dielectric) wavelength at the highest frequency in play. A plate also gets at least 10 elements along its longer side."/>
                <Label Content="Patch gap from edge [mm]"/>
                <TextBox x:Name="PatchGapOffsetBox" Text="{Binding Antenna.PatchGapOffsetMm}"
                         ToolTip="Edge-fed patch only: where the series-gap port cuts the patch, measured from the edge. 0 = one eighth of the patch length."/>
                <Label Content="Patch gap width [mm]"/>
                <TextBox x:Name="PatchGapWidthBox" Text="{Binding Antenna.PatchGapWidthMm}"
                         ToolTip="Edge-fed patch only: the physical width of the series gap, centred on the position above. The port's impedance depends on it (a gap is a capacitor), and converges under mesh refinement for a fixed width. 0 = one eighteenth of the patch length."/>
            </UniformGrid>

            <!-- FU-47: pins on the wizard patch or a board island (Feature 12) -->
            <StackPanel Visibility="{Binding Antenna.IsPinPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                <TextBlock Text="Pins" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock Text="Vertical pins from the ground up to the metal, solved together: a feed is a port at its base (left a port, shorted, open, or closed by a lumped part), a shorting pin is welded to the ground — an inverted-F, a PIFA, a patch with two feeds. On the wizard patch x, y are from its centre, over the slab set by the patch height and substrate εr above; on a board island they are board coordinates and the pins stand on the plane under it. Tube segments: the probe field above."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                    <TextBlock Grid.Column="1" Text="x mm" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                    <TextBlock Grid.Column="2" Text="y mm" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                    <TextBlock Grid.Column="3" Text="r mm" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                    <TextBlock Grid.Column="4" Text="Role" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                    <TextBlock Grid.Column="5" Text="Port" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                    <TextBlock Grid.Column="6" Text="Value" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                    <TextBlock Grid.Column="7" Text="Q" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                </Grid>
                <ItemsControl x:Name="AntennaPinList" ItemsSource="{Binding Antenna.Pins}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name}"/>
                                <TextBox Grid.Column="1" Text="{Binding XMm}"/>
                                <TextBox Grid.Column="2" Text="{Binding YMm}"/>
                                <TextBox Grid.Column="3" Text="{Binding RadiusMm}" ToolTip="Tube radius [mm]; each tube segment must be at least twice this long."/>
                                <ComboBox Grid.Column="4" ItemsSource="{x:Static vm:AntennaPinRow.Roles}" SelectedItem="{Binding Role}"/>
                                <ComboBox Grid.Column="5" ItemsSource="{x:Static vm:PortLoads.All}" SelectedItem="{Binding Load}"
                                          IsEnabled="{Binding IsFeed}"
                                          ToolTip="A feed's port: left a port, shorted, open (the pin floats), or closed by a resistor, an inductor or a capacitor."/>
                                <TextBox Grid.Column="6" Text="{Binding Value}" IsEnabled="{Binding IsFeed}" ToolTip="The part's value: Ω, nH or pF."/>
                                <TextBox Grid.Column="7" Text="{Binding Q}" IsEnabled="{Binding IsFeed}" ToolTip="The part's Q; 0 = ideal."/>
                                <Button Grid.Column="8" Content="×" Padding="0" ToolTip="Remove this pin"
                                        Command="{Binding DataContext.Antenna.RemovePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <UniformGrid Columns="2" Margin="0,2,0,0">
                    <Button Content="Add a pin" Command="{Binding Antenna.AddPinCommand}"/>
                    <Button x:Name="PinsFromViasButton" Content="Pins from the island's vias" Command="{Binding Antenna.PinsFromViasCommand}"
                            Visibility="{Binding Antenna.IsIslandPinsPanelVisible, Converter={StaticResource BoolToVis}}" Margin="2,0,0,0"
                            ToolTip="Every plated via on the island whose barrel reaches the ground layer: one the net uses to join the island to the plane is a shorting pin, one rising through the plane's antipad a feed."/>
                </UniformGrid>
            </StackPanel>

            <!-- FU-47: a printed antenna with its coplanar ground pour (Feature 12, FU-36) -->
            <StackPanel Visibility="{Binding Antenna.IsPrintedPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                <TextBlock Text="Printed antenna" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock Text="The selected net's copper and a ground pour on the same layer, joined at the feed by a bridge with the port across it (the feed's two terminals). The bridge leaves the antenna copper at its point nearest the selected source pad, or nearest the point below. On the board's laminate the board is an infinite slab with no ground plane under it; in air there is no dielectric."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
                <UniformGrid Columns="2">
                    <Label Content="Ground pour net"/>
                    <ComboBox x:Name="PrintedGroundCombo" ItemsSource="{Binding Antenna.Nets}" SelectedItem="{Binding Antenna.GroundPourNet}"
                              DisplayMemberPath="Label"/>
                    <Label Content="Layer"/>
                    <ComboBox ItemsSource="{Binding Antenna.PrintedLayers}" SelectedItem="{Binding Antenna.PrintedLayer}" ItemStringFormat="L{0}"/>
                    <Label Content="Feed bridge width [mm]"/>
                    <TextBox Text="{Binding Antenna.BridgeWidthMm}"/>
                    <Label Content="Feed point x / y [mm] (no source pad)"/>
                    <UniformGrid Columns="2">
                        <TextBox Text="{Binding Antenna.FeedXMm}" Margin="0,0,2,0"/>
                        <TextBox Text="{Binding Antenna.FeedYMm}" Margin="2,0,0,0"/>
                    </UniformGrid>
                    <Label Content="Keep pour within [mm] (0 = all)"/>
                    <TextBox Text="{Binding Antenna.GroundClipMm}"
                             ToolTip="Clips the ground pour to the antenna copper's bounds plus this margin, to bound the unknowns. Copper outside the clip is not in the model."/>
                </UniformGrid>
                <CheckBox Content="On the board's laminate (ungrounded slab)" IsChecked="{Binding Antenna.PrintedOnLaminate}"
                          Foreground="{DynamicResource TextMutedBrush}" Margin="2,2,0,0"
                          ToolTip="The board's dielectric gaps as one infinite slab (thickness-weighted εr and tanδ) with the copper on its top or bottom face; the edges of the board are not in the model. Off: in air."/>
            </StackPanel>

            <!-- FU-47: sheet metal in air (Feature 12's air model) -->
            <StackPanel Visibility="{Binding Antenna.IsSheetMetalPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                <TextBlock Text="Sheet metal in air" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock Text="Axis-aligned plates on one shared graded grid — a PIFA's top plate and tabs over a finite ground plate of its real size, or over an infinite image ground at z = 0 — with ports as straight cuts along mesh lines (their ends become grid lines). No dielectric."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
                <UniformGrid Columns="2">
                    <Label Content="PIFA ground W × L [mm]"/>
                    <UniformGrid Columns="2">
                        <TextBox Text="{Binding Antenna.PifaGroundWidthMm}" Margin="0,0,2,0"/>
                        <TextBox Text="{Binding Antenna.PifaGroundLengthMm}" Margin="2,0,0,0"/>
                    </UniformGrid>
                    <Label Content="Top plate W × L [mm] / height [mm]"/>
                    <UniformGrid Columns="3">
                        <TextBox Text="{Binding Antenna.PifaTopWidthMm}" Margin="0,0,2,0"/>
                        <TextBox Text="{Binding Antenna.PifaTopLengthMm}" Margin="2,0,2,0"/>
                        <TextBox Text="{Binding Antenna.PifaHeightMm}" Margin="2,0,0,0"/>
                    </UniformGrid>
                    <Label Content="Tab width / feed-to-short [mm]"/>
                    <UniformGrid Columns="2">
                        <TextBox Text="{Binding Antenna.PifaTabWidthMm}" Margin="0,0,2,0"/>
                        <TextBox Text="{Binding Antenna.PifaFeedSpacingMm}" Margin="2,0,0,0" ToolTip="Centre-to-centre spacing of the feed tab from the shorting tab."/>
                    </UniformGrid>
                    <Label Content="Finest element [mm] (0 = uniform)"/>
                    <TextBox Text="{Binding Antenna.SheetMinEdgeMm}" ToolTip="The grid grades down to this near part edges and port lines."/>
                </UniformGrid>
                <CheckBox Content="Image ground at z = 0 instead of a ground plate" IsChecked="{Binding Antenna.SheetImageGround}"
                          Foreground="{DynamicResource TextMutedBrush}" Margin="2,2,0,0"
                          ToolTip="An infinite perfect ground (image theory). With it, leave no plate at z = 0 — plates touching it are grounded there."/>
                <Button x:Name="FillPifaButton" Content="Fill the parts with this PIFA" Command="{Binding Antenna.FillPifaCommand}" Margin="0,2,0,0"
                        ToolTip="Replaces the plates and ports below with the PIFA and centres the sweep on its quarter-wave estimate."/>
                <TextBlock Text="Plates (x0, y0, z0 → x1, y1, z1 mm; one axis equal)" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,4,0,1"/>
                <ItemsControl x:Name="SheetPartList" ItemsSource="{Binding Antenna.SheetParts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name}"/>
                                <TextBox Grid.Column="1" Text="{Binding X0Mm}"/>
                                <TextBox Grid.Column="2" Text="{Binding Y0Mm}"/>
                                <TextBox Grid.Column="3" Text="{Binding Z0Mm}"/>
                                <TextBox Grid.Column="4" Text="{Binding X1Mm}"/>
                                <TextBox Grid.Column="5" Text="{Binding Y1Mm}"/>
                                <TextBox Grid.Column="6" Text="{Binding Z1Mm}"/>
                                <Button Grid.Column="7" Content="×" Padding="0" ToolTip="Remove this plate"
                                        Command="{Binding DataContext.Antenna.RemoveSheetPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Port lines (name, current direction, port; then from → to mm)" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,4,0,1"/>
                <ItemsControl x:Name="SheetPortList" ItemsSource="{Binding Antenna.SheetPorts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Name}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SheetPortRow.Directions}" SelectedItem="{Binding Direction}"
                                              ToolTip="The direction the positive current crosses the cut."/>
                                    <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:PortLoads.All}" SelectedItem="{Binding Load}"/>
                                    <TextBox Grid.Column="3" Text="{Binding Value}" ToolTip="The part's value: Ω, nH or pF."/>
                                    <TextBox Grid.Column="4" Text="{Binding Q}" ToolTip="The part's Q; 0 = ideal."/>
                                    <Button Grid.Column="5" Content="×" Padding="0" ToolTip="Remove this port"
                                            Command="{Binding DataContext.Antenna.RemoveSheetPortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                <UniformGrid Columns="6" Margin="0,1,0,0">
                                    <TextBox Text="{Binding FromXMm}" ToolTip="From x [mm]"/>
                                    <TextBox Text="{Binding FromYMm}" ToolTip="From y [mm]"/>
                                    <TextBox Text="{Binding FromZMm}" ToolTip="From z [mm]"/>
                                    <TextBox Text="{Binding ToXMm}" ToolTip="To x [mm]"/>
                                    <TextBox Text="{Binding ToYMm}" ToolTip="To y [mm]"/>
                                    <TextBox Text="{Binding ToZMm}" ToolTip="To z [mm]"/>
                                </UniformGrid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <UniformGrid Columns="2" Margin="0,2,0,0">
                    <Button Content="Add a plate" Command="{Binding Antenna.AddSheetPartCommand}"/>
                    <Button Content="Add a port line" Command="{Binding Antenna.AddSheetPortCommand}" Margin="2,0,0,0"/>
                </UniformGrid>
            </StackPanel>

            <UniformGrid Columns="2" Visibility="{Binding Antenna.IsPortedPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                <Label Content="Driven port (fields)"/>
                <ComboBox x:Name="FarFieldPortCombo" ItemsSource="{Binding Antenna.PortChoices}" SelectedItem="{Binding Antenna.FarFieldPort}"
                          ToolTip="The far field, near field and overlay drive this port with 1 V; the other ports stay closed as set, a port left a port in the reference impedance (the embedded pattern)."/>
            </UniformGrid>
            <CheckBox Content="Mesh convergence check (re-solve 1.5× finer)"
                      IsChecked="{Binding Antenna.CheckMeshConvergence}"
                      Foreground="{DynamicResource TextMutedBrush}" Margin="2,2,0,2"
                      ToolTip="After a surface solve, solve once more at f on a mesh 1.5× finer and report the change in Zin."/>
            <CheckBox Content="Three passes (also 2.25× finer: order and limit)"
                      IsChecked="{Binding Antenna.ThreePassMeshCheck}"
                      IsEnabled="{Binding Antenna.CheckMeshConvergence}"
                      Foreground="{DynamicResource TextMutedBrush}" Margin="18,2,0,2"
                      ToolTip="Solve on a third mesh 2.25× finer: from the three, the order at which Zin converges and Richardson's estimate of Zin on an infinitely fine mesh. That mesh has about 5× the unknowns, so its solve alone costs 25–130× the first."/>
            <CheckBox x:Name="AdaptiveSweepCheck" Content="Adaptive sweep (the solver places the points)"
                      IsChecked="{Binding Antenna.AdaptiveSweep}"
                      Foreground="{DynamicResource TextMutedBrush}" Margin="2,2,0,2"
                      ToolTip="Rational interpolation between solver runs: each round's new frequencies go where the curve is least certain (up to four solved side by side), so a narrow resonance is not stepped over. 'Sweep points' (at least 30) becomes the limit on solver runs. The −10 dB band is read on the interpolant."/>
            <CheckBox Content="Sample in log frequency"
                      IsChecked="{Binding Antenna.LogarithmicSweep}"
                      IsEnabled="{Binding Antenna.AdaptiveSweep}"
                      Foreground="{DynamicResource TextMutedBrush}" Margin="18,2,0,2"
                      ToolTip="The adaptive sweep samples and interpolates in ln f — for a band of a decade or more. Off: linear in frequency between f min and f max."/>
            <CheckBox x:Name="ConductorLossCheck" Content="Metal loss (sheet, probe and wires)"
                      IsChecked="{Binding Antenna.ConductorLoss}"
                      Foreground="{DynamicResource TextMutedBrush}" Margin="2,2,0,2"
                      ToolTip="The metal gets the surface impedance of the given conductivity instead of being a perfect conductor: sheets of the given thickness, wires and the probe tube as skin-deep round conductors. Along a sheet's free edges the loss is that of an edge of the given thickness, so it does not grow as the mesh is refined. The ground plane has its own box below."/>
            <CheckBox x:Name="GroundLossCheck" Content="Ground plane loss (substrate solves)"
                      IsChecked="{Binding Antenna.GroundLoss}"
                      Foreground="{DynamicResource TextMutedBrush}" Margin="2,2,0,2"
                      ToolTip="The ground plane under a substrate becomes an impedance boundary of the given conductivity and thickness instead of a perfect conductor: it absorbs, and the surface waves decay into it. Solves go through the multi-layer Green's function; the power ledger integrates the ground's heat over the plane for sheet currents."/>
            <UniformGrid Columns="2">
                <Label Content="Metal σ [S/m]"/>
                <TextBox Text="{Binding Antenna.MetalConductivity}" IsEnabled="{Binding Antenna.MetalPropertiesEnabled}"/>
                <Label Content="Metal thickness [µm]"/>
                <TextBox Text="{Binding Antenna.MetalThicknessUm}" IsEnabled="{Binding Antenna.MetalPropertiesEnabled}"/>
                <Label Content="Reference impedance [Ω]"/>
                <TextBox x:Name="ReferenceOhmsBox" Text="{Binding Antenna.ReferenceOhms}"/>
            </UniformGrid>
            <Button x:Name="SolveAntennaButton" Content="Solve antenna (Zin sweep)"
                    Command="{Binding Antenna.SolveAntennaCommand}"/>
            <TextBlock Text="{Binding Antenna.AntennaResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Antenna.SParameterResult}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            <Image Source="{Binding Antenna.ReturnLossImage}" MaxHeight="220" Margin="0,4,0,0" Stretch="Uniform"
                   AutomationProperties.AutomationId="AntennaS11Image"/>
            <Image Source="{Binding Antenna.SmithImage}" MaxHeight="300" Margin="0,4,0,0" Stretch="Uniform"
                   AutomationProperties.AutomationId="AntennaSmithImage"/>
            <Button Content="Save S11 (Touchstone .s1p)" Command="{Binding Antenna.ExportS1pCommand}"
                    IsEnabled="{Binding Antenna.HasSParameters}"/>
            <!-- FU-47: the N-port result (Feature 8) of pins and sheet-port lines -->
            <StackPanel Visibility="{Binding Antenna.HasMultiPort, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                <TextBlock Text="Multi-port S-parameters" FontWeight="Bold"/>
                <TextBlock x:Name="MultiPortResultText" Text="{Binding Antenna.MultiPortResult}" TextWrapping="Wrap"
                           FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                <Image Source="{Binding Antenna.MultiPortImage}" MaxHeight="240" Margin="0,4,0,0" Stretch="Uniform"
                       AutomationProperties.AutomationId="AntennaMultiPortImage"/>
                <Button Content="Save S-parameters (Touchstone .sNp)" Command="{Binding Antenna.ExportSnpCommand}"/>
            </StackPanel>
            <TextBlock Text="Matching network (L-section)" FontWeight="Bold" Margin="0,6,0,0"/>
            <UniformGrid Columns="2">
                <Label Content="Design frequency [MHz] (0 = best match)"/>
                <TextBox Text="{Binding Antenna.MatchFrequencyMHz}"/>
                <Label Content="Inductor Q (0 = ideal)"/>
                <TextBox Text="{Binding Antenna.InductorQ}"/>
                <Label Content="Capacitor Q (0 = ideal)"/>
                <TextBox Text="{Binding Antenna.CapacitorQ}"/>
            </UniformGrid>
            <Button Content="Design matching network" Command="{Binding Antenna.DesignMatchCommand}"
                    IsEnabled="{Binding Antenna.HasSParameters}"/>
            <TextBlock Text="{Binding Antenna.MatchResult}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            <Image Source="{Binding Antenna.MatchImage}" MaxHeight="220" Margin="0,4,0,0" Stretch="Uniform"/>
            <ItemsControl ItemsSource="{Binding Antenna.ZinSweep}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <UniformGrid Columns="3">
                            <TextBlock Text="{Binding FrequencyHz, StringFormat='f = {0:g3} Hz'}" FontSize="11"/>
                            <TextBlock Text="{Binding Resistance, StringFormat='R = {0:g4} Ω'}" FontSize="11"/>
                            <TextBlock Text="{Binding Reactance, StringFormat='X = {0:g4} Ω'}" FontSize="11"/>
                        </UniformGrid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <UniformGrid Columns="2" Margin="0,4,0,0">
                <Label Content="Field grid (n³)"/>
                <TextBox Text="{Binding Antenna.GridResolution}"/>
            </UniformGrid>
            <UniformGrid Columns="3">
                <Button x:Name="NearFieldButton" Content="Near-field map"
                        Command="{Binding Antenna.ComputeNearFieldCommand}"/>
                <Button x:Name="FarFieldButton" Content="Far-field lobe"
                        Command="{Binding Antenna.ShowFarFieldCommand}"/>
                <Button Content="Clear overlays" Command="{Binding Antenna.ClearOverlaysCommand}"/>
            </UniformGrid>

            <!-- Board field overlay (SIwave-style): a translucent |field| heatmap plane
                 over the PCB/structure with user scale/range/opacity controls. E only in
                 v1; picking H surfaces a typed follow-up message until the H kernels ship. -->
            <TextBlock Text="Field overlay over the board" FontWeight="Bold" Margin="0,8,0,2"/>
            <UniformGrid Columns="4">
                <Label Content="Field"/>
                <ComboBox x:Name="OverlayFieldCombo"
                          ItemsSource="{Binding Antenna.OverlayFieldTypes}"
                          SelectedItem="{Binding Antenna.OverlayFieldType}"/>
                <Label Content="Scale"/>
                <ComboBox x:Name="OverlayScaleCombo"
                          ItemsSource="{Binding Antenna.OverlayScaleModes}"
                          SelectedItem="{Binding Antenna.OverlayScaleMode}"/>
                <Label Content="Height above metal [mm]"/>
                <TextBox x:Name="OverlayHeightBox" Text="{Binding Antenna.OverlayHeightMm}"
                         ToolTip="The overlay plane hovers this far above the structure's top metal. Values within ~an element of metal are surface-scale approximations."/>
                <Label Content="Grid (n²)"/>
                <TextBox x:Name="OverlayGridBox" Text="{Binding Antenna.OverlayGridN}"/>
                <CheckBox x:Name="OverlayAutoRangeCheck" Content="Auto range"
                          IsChecked="{Binding Antenna.OverlayAutoRange}"
                          Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,1"
                          ToolTip="Color range from the sampled data; log mode spans the top N decades below the peak."/>
                <TextBox x:Name="OverlayDecadesBox" Text="{Binding Antenna.OverlayDecades}"
                         ToolTip="Log mode: decades below the peak an auto range spans"/>
                <Label Content="Range min/max [V/m]"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="OverlayMinBox" Text="{Binding Antenna.OverlayMinVPerM}" Margin="0,0,2,0"
                             ToolTip="Range minimum (V/m), used when auto range is off. In log mode a non-positive min falls back to max/10^decades."/>
                    <TextBox x:Name="OverlayMaxBox" Text="{Binding Antenna.OverlayMaxVPerM}" Margin="2,0,0,0"
                             ToolTip="Range maximum (V/m), used when auto range is off. Samples above it saturate (legend shows ▲)."/>
                </UniformGrid>
                <Label Content="Opacity [%]"/>
                <Slider x:Name="OverlayOpacitySlider" Minimum="5" Maximum="100"
                        Value="{Binding Antenna.OverlayOpacityPercent}"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        ToolTip="Overlay plane transparency over the copper preview"/>
            </UniformGrid>
            <CheckBox x:Name="OverlayOverBoardCheck" Content="Over the board outline (per copper layer)"
                      IsChecked="{Binding Antenna.OverlayOverBoard}"
                      Visibility="{Binding Antenna.HasBoardOverlay, Converter={StaticResource BoolToVis}}"
                      Foreground="{DynamicResource TextMutedBrush}" Margin="2,3,0,0"
                      ToolTip="Paint the field masked to the board outline at each copper-layer height (the SIwave board view), instead of one plane above the net"/>
            <Button x:Name="FieldOverlayButton" Content="Field overlay on board"
                    Command="{Binding Antenna.ShowFieldOverlayCommand}"/>
            <TextBlock Text="{Binding Antenna.FieldResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Antenna.AntennaAssumptions}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>

        </StackPanel>
    </GroupBox>
</UserControl>
