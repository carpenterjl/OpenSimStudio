<UserControl x:Class="OpenSim.App.Views.Panels.OpticsAnalysesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenSim.App.Controls">
    <!-- Opens the Optics analysis windows (OP-9) and saves the report page made from them.
         The windows dock beside and under the viewport; each one's menu docks, tabs, floats
         or closes it. -->
    <GroupBox Header="Analyses">
        <StackPanel>
            <controls:FormGrid>
                <Label Content="Analysis"/>
                <ComboBox ItemsSource="{Binding OpticsAnalyses.Available}"
                          SelectedItem="{Binding OpticsAnalyses.SelectedToOpen}"
                          DisplayMemberPath="Name"
                          AutomationProperties.AutomationId="OpticsAnalysisCombo"/>
            </controls:FormGrid>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Open window" Style="{StaticResource AccentButton}"
                        Command="{Binding OpticsAnalyses.OpenSelectedCommand}"
                        AutomationProperties.AutomationId="OpticsOpenAnalysisButton"/>
                <Button Content="Save report" Margin="6,0,0,0"
                        Command="{Binding OpticsAnalyses.SaveReportCommand}"
                        IsEnabled="{Binding OpticsAnalyses.HasWindows}"
                        AutomationProperties.AutomationId="OpticsSaveReportButton"/>
            </StackPanel>
            <TextBlock Text="Each window recomputes when the system changes, a moment after the last edit; a compute still running when the next edit comes is abandoned. The open windows, where they are docked and their settings are saved with the project. The report gathers what every open window shows."
                       TextWrapping="Wrap" Style="{StaticResource FaintText}" Margin="0,6,0,0"/>
        </StackPanel>
    </GroupBox>
</UserControl>
