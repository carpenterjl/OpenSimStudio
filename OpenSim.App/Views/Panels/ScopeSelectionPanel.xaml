<UserControl x:Class="OpenSim.App.Views.Panels.ScopeSelectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GroupBox Header="Scope (edges and vertices)">
        <StackPanel>
            <TextBlock Text="{Binding ScopeSelection.ScopeSummary}" AutomationProperties.AutomationId="ScopeSummaryText"
                       Margin="0,0,0,4" TextWrapping="Wrap" Opacity="0.8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Edges shared by selected faces" Padding="6,2"
                        AutomationProperties.AutomationId="SelectSharedEdgesButton"
                        Command="{Binding ScopeSelection.SelectSharedEdgesCommand}"/>
                <Button Content="Clear" Padding="6,2" Margin="4,0,0,0"
                        AutomationProperties.AutomationId="ClearScopeButton"
                        Command="{Binding ScopeSelection.ClearScopeSelectionCommand}"/>
            </StackPanel>

            <TextBlock Text="Edges" FontWeight="Bold" Margin="0,4,0,2"/>
            <ListBox ItemsSource="{Binding ScopeSelection.Edges}" MinHeight="60" MaxHeight="140"
                     AutomationProperties.AutomationId="ScopeEdgeList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Vertices" FontWeight="Bold" Margin="0,6,0,2"/>
            <ListBox ItemsSource="{Binding ScopeSelection.Vertices}" MinHeight="40" MaxHeight="100"
                     AutomationProperties.AutomationId="ScopeVertexList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.7"
                       AutomationProperties.AutomationId="ScopeFooterText"
                       Text="{Binding ScopeSelection.ScopeFooter}"/>
        </StackPanel>
    </GroupBox>
</UserControl>
