<UserControl x:Class="OpenSim.App.Views.Panels.AnalysisSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Transient thermal (also the Joule study's optional transient leg) -->
        <GroupBox Header="Transient settings"
                  Visibility="{Binding Session.ShowsTransientSettings, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <CheckBox x:Name="JouleTransientCheck" Content="Transient thermal leg (constant DC power)"
                          IsChecked="{Binding Solve.JouleTransient}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,1,2,3"
                          Visibility="{Binding Session.IsJouleAnalysis, Converter={StaticResource BoolToVis}}"
                          ToolTip="Unchecked: steady-state temperature. Checked: time history of the heat-up at the DC solve's constant power."/>
                <CheckBox x:Name="EnvironmentSteadyCheck" Content="Steady state (skip the time history)"
                          IsChecked="{Binding Solve.EnvironmentSteadyState}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,1,2,3"
                          Visibility="{Binding Session.IsEnvironmentThermalAnalysis, Converter={StaticResource BoolToVis}}"
                          ToolTip="Solves the final equilibrium directly. The same nonlinear convection/radiation coupling is iterated to convergence — it answers how hot the parts end up, not how they got there."/>
                <UniformGrid Columns="2">
                    <Label Content="Initial temperature [K]"/>
                    <TextBox x:Name="InitialTemperatureBox" Text="{Binding Solve.InitialTemperature}"/>
                    <Label Content="Duration [s]"/>
                    <TextBox x:Name="TransientDurationBox" Text="{Binding Solve.TransientDuration}"/>
                    <Label Content="Time step [s]"/>
                    <TextBox x:Name="TransientTimeStepBox" Text="{Binding Solve.TransientTimeStep}"/>
                </UniformGrid>
                <TextBlock Text="Backward Euler — stable at any step size; smaller steps sharpen the early transient. Results appear as scrubbable time frames."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>
        <!-- Pulsed power and thermal impedance -->
        <GroupBox Header="Pulsed power and thermal impedance"
                  Visibility="{Binding Session.ShowsTransientSettings, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <CheckBox Content="Pulse the heat sources during the transient"
                          IsChecked="{Binding Solve.PulsedPower}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,1,2,3"
                          ToolTip="Heat flows and volumetric sources switch between their value and zero. Each time step takes the mean power over the step, so the energy is right even with an edge inside a step."/>
                <UniformGrid Columns="2">
                    <Label Content="Pulse period [s]"/>
                    <TextBox Text="{Binding Solve.PulsePeriod}"/>
                    <Label Content="On time [% of period]"/>
                    <TextBox Text="{Binding Solve.PulseDutyPercent}"/>
                    <Label Content="Z_th from [s]"/>
                    <TextBox Text="{Binding Solve.ZthStartTime}"/>
                    <Label Content="Z_th to [s]"/>
                    <TextBox Text="{Binding Solve.ZthEndTime}"/>
                    <Label Content="Network stages (0 = auto)"/>
                    <TextBox Text="{Binding Solve.ZthStages}"/>
                </UniformGrid>
                <Button Content="Thermal impedance curve (Z_th)" Command="{Binding Solve.SolveThermalImpedanceCommand}"
                        ToolTip="Temperature rise per watt at the heated faces against time after switch-on, on a logarithmic time grid, with a fitted Foster network and its Cauer ladder. Uses the thermal conditions placed on the model."/>
                <TextBlock Text="{Binding Solve.ZthResult}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                <Image Source="{Binding Solve.ZthPlot}" MaxHeight="260" Margin="0,4,0,0" Stretch="Uniform"/>
                <UniformGrid Columns="3" Margin="0,3,0,0" IsEnabled="{Binding Solve.HasZth}">
                    <Button Content="Save curve" Command="{Binding Solve.SaveZthCurveCommand}"/>
                    <Button Content="Save SPICE" Command="{Binding Solve.SaveZthNetworksCommand}" Margin="2,0,0,0"/>
                    <Button Content="Save table" Command="{Binding Solve.SaveZthTableCommand}" Margin="2,0,0,0"
                            ToolTip="R, τ and C of the Foster and Cauer stages as CSV, for tools that take the values typed in."/>
                </UniformGrid>
                <TextBlock Text="Z_th belongs to a linear model: with an environment the surface coefficients are held at their steady values. A Foster network reproduces the curve at its terminals only; continue a model from the Cauer ladder."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Modal -->
        <GroupBox Header="Modal settings"
                  Visibility="{Binding Session.IsModalAnalysis, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <UniformGrid Columns="2">
                    <Label Content="Modes (lowest first)"/>
                    <TextBox x:Name="ModeCountBox" Text="{Binding Solve.ModeCount}"/>
                </UniformGrid>
                <TextBlock Text="Needs at least one fixed support (a free body has zero-frequency rigid modes). Loads are ignored. Pick modes in the Results panel; the deform scale sets the displayed amplitude."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- AC electrical sweep -->
        <GroupBox Header="AC sweep settings"
                  Visibility="{Binding Session.IsAcElectricalAnalysis, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <UniformGrid Columns="2">
                    <Label Content="Min frequency [Hz]"/>
                    <TextBox x:Name="AcMinFrequencyBox" Text="{Binding Solve.AcMinFrequency}"/>
                    <Label Content="Max frequency [Hz]"/>
                    <TextBox x:Name="AcMaxFrequencyBox" Text="{Binding Solve.AcMaxFrequency}"/>
                    <Label Content="Points (geometric)"/>
                    <TextBox x:Name="AcPointCountBox" Text="{Binding Solve.AcPointCount}"/>
                </UniformGrid>
                <TextBlock Text="Electro-quasistatic (σ + jωε) — for dielectric/capacitive studies. Conductor+dielectric composites are rejected (same conditioning ban as DC); use the trace R + jωL estimate for copper. Scrub frequencies in the Results panel."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
