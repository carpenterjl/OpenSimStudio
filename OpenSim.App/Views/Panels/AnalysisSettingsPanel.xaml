<UserControl x:Class="OpenSim.App.Views.Panels.AnalysisSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Transient thermal (also the Joule study's optional transient leg) -->
        <GroupBox Header="Transient settings"
                  Visibility="{Binding Session.ShowsTransientSettings, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <CheckBox x:Name="JouleTransientCheck" Content="Transient thermal leg (constant DC power)"
                          IsChecked="{Binding Solve.JouleTransient}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,1,2,3"
                          Visibility="{Binding Session.IsJouleAnalysis, Converter={StaticResource BoolToVis}}"
                          ToolTip="Unchecked: steady-state temperature. Checked: time history of the heat-up at the DC solve's constant power."/>
                <CheckBox x:Name="EnvironmentSteadyCheck" Content="Steady state (skip the time history)"
                          IsChecked="{Binding Solve.EnvironmentSteadyState}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,1,2,3"
                          Visibility="{Binding Session.IsEnvironmentThermalAnalysis, Converter={StaticResource BoolToVis}}"
                          ToolTip="Solves the final equilibrium directly. The same nonlinear convection/radiation coupling is iterated to convergence — it answers how hot the parts end up, not how they got there."/>
                <UniformGrid Columns="2">
                    <Label Content="Initial temperature [K]"/>
                    <TextBox x:Name="InitialTemperatureBox" Text="{Binding Solve.InitialTemperature}"/>
                    <Label Content="Duration [s]"/>
                    <TextBox x:Name="TransientDurationBox" Text="{Binding Solve.TransientDuration}"/>
                    <Label Content="Time step [s]"/>
                    <TextBox x:Name="TransientTimeStepBox" Text="{Binding Solve.TransientTimeStep}"
                             ToolTip="Fixed-step integrators: the step. Adaptive: the interval between stored frames."/>
                    <Label Content="Integrator"/>
                    <ComboBox SelectedIndex="{Binding Solve.TransientIntegratorIndex}"
                              ToolTip="Backward Euler takes every model. TR-BDF2 (second order) and the adaptive step take linear models only: no environment, no radiation exchange.">
                        <ComboBoxItem Content="Backward Euler"/>
                        <ComboBoxItem Content="TR-BDF2"/>
                        <ComboBoxItem Content="Adaptive TR-BDF2"/>
                    </ComboBox>
                    <Label Content="Adaptive tolerance [K]"/>
                    <TextBox Text="{Binding Solve.TransientTolerance}"
                             ToolTip="The largest temperature error one adaptive step may add."/>
                    <Label Content="Heat capacity"/>
                    <ComboBox SelectedIndex="{Binding Solve.TransientCapacityIndex}"
                              ToolTip="Automatic: lumped where the step is below h²/6α (where the consistent matrix lets a node next to a heated one move the wrong way first), consistent otherwise. The log says which.">
                        <ComboBoxItem Content="Automatic"/>
                        <ComboBoxItem Content="Consistent"/>
                        <ComboBoxItem Content="Lumped"/>
                    </ComboBox>
                </UniformGrid>
                <TextBlock Text="Backward Euler is stable at any step size; smaller steps sharpen the early transient. TR-BDF2 is second order at the same cost per stage; the adaptive step keeps each step's error under the tolerance. Results appear as scrubbable time frames."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
                <!-- FU-44 / FU-47: the state a transient starts from -->
                <CheckBox x:Name="StartFromSteadyCheck" Content="Start from the last steady thermal result"
                          IsChecked="{Binding Solve.StartFromLastSteady}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,4,2,0"
                          ToolTip="Solve the steady state first (the steady heat-conduction analysis, with the conditions of the starting point), then switch to the transient: it starts from that field, node by node, instead of the uniform initial temperature. Nodes under a fixed temperature start at their value. Needs the same mesh."/>
                <TextBlock Text="{Binding Solve.LastSteadyStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="20,0,0,0"/>
            </StackPanel>
        </GroupBox>
        <!-- Pulsed power and thermal impedance -->
        <GroupBox Header="Pulsed power and thermal impedance"
                  Visibility="{Binding Session.ShowsTransientSettings, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <CheckBox Content="Pulse the heat sources during the transient"
                          IsChecked="{Binding Solve.PulsedPower}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,1,2,3"
                          ToolTip="Heat flows and volumetric sources switch between their value and zero. Each time step takes the mean power over the step, so the energy is right even with an edge inside a step."/>
                <UniformGrid Columns="2">
                    <Label Content="Pulse period [s]"/>
                    <TextBox Text="{Binding Solve.PulsePeriod}"/>
                    <Label Content="On time [% of period]"/>
                    <TextBox Text="{Binding Solve.PulseDutyPercent}"/>
                    <Label Content="Z_th from [s]"/>
                    <TextBox Text="{Binding Solve.ZthStartTime}"/>
                    <Label Content="Z_th to [s]"/>
                    <TextBox Text="{Binding Solve.ZthEndTime}"/>
                    <Label Content="Network stages (0 = auto)"/>
                    <TextBox Text="{Binding Solve.ZthStages}"/>
                </UniformGrid>
                <CheckBox Content="Follow the nonlinear surface exchange"
                          IsChecked="{Binding Solve.ZthNonlinear}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,1,2,3"
                          ToolTip="Z_th from the full transient at the model's power from its unpowered state, the convection correlations and radiation re-evaluated as it heats. Unchecked: the linear model about the steady state."/>
                <CheckBox x:Name="ZthMutualCheck" Content="Mutual matrix over the heat-flow conditions"
                          IsChecked="{Binding Solve.ZthMutual}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,1,2,3"
                          ToolTip="Each heat-flow condition is a source: one linear run per source with the others off, each read at every source's faces — the self and mutual Z_th, fitted as a Foster matrix with shared time constants (saved as SPICE). Linear model only."/>
                <Button Content="Thermal impedance curve (Z_th)" Command="{Binding Solve.SolveThermalImpedanceCommand}"
                        ToolTip="Temperature rise per watt at the heated faces against time after switch-on, on a logarithmic time grid, with a fitted Foster network and its Cauer ladder. Uses the thermal conditions placed on the model."/>
                <TextBlock Text="{Binding Solve.ZthResult}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                <Image Source="{Binding Solve.ZthPlot}" MaxHeight="260" Margin="0,4,0,0" Stretch="Uniform"/>
                <UniformGrid Columns="3" Margin="0,3,0,0" IsEnabled="{Binding Solve.HasZth}">
                    <Button Content="Save curve" Command="{Binding Solve.SaveZthCurveCommand}"/>
                    <Button Content="Save SPICE" Command="{Binding Solve.SaveZthNetworksCommand}" Margin="2,0,0,0"/>
                    <Button Content="Save table" Command="{Binding Solve.SaveZthTableCommand}" Margin="2,0,0,0"
                            ToolTip="R, τ and C of the Foster and Cauer stages as CSV, for tools that take the values typed in."/>
                </UniformGrid>
                <TextBlock Text="Z_th belongs to a linear model: with an environment the surface coefficients are held at their steady values unless the nonlinear exchange is followed. A Foster network reproduces the curve at its terminals only; continue a model from the Cauer ladder."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Modal -->
        <GroupBox Header="Modal settings"
                  Visibility="{Binding Session.IsModalAnalysis, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <UniformGrid Columns="2">
                    <Label Content="Modes (lowest first)"/>
                    <TextBox x:Name="ModeCountBox" Text="{Binding Solve.ModeCount}"/>
                </UniformGrid>
                <TextBlock Text="Needs at least one fixed support (a free body has zero-frequency rigid modes). Loads are ignored. Pick modes in the Results panel; the deform scale sets the displayed amplitude."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- AC electrical sweep -->
        <GroupBox Header="AC sweep settings"
                  Visibility="{Binding Session.IsAcElectricalAnalysis, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <UniformGrid Columns="2">
                    <Label Content="Min frequency [Hz]"/>
                    <TextBox x:Name="AcMinFrequencyBox" Text="{Binding Solve.AcMinFrequency}"/>
                    <Label Content="Max frequency [Hz]"/>
                    <TextBox x:Name="AcMaxFrequencyBox" Text="{Binding Solve.AcMaxFrequency}"/>
                    <Label Content="Points (geometric)"/>
                    <TextBox x:Name="AcPointCountBox" Text="{Binding Solve.AcPointCount}"/>
                </UniformGrid>
                <TextBlock Text="Electro-quasistatic (σ + jωε) — for dielectric/capacitive studies. Conductor+dielectric composites are rejected (same conditioning ban as DC); use the trace R + jωL estimate for copper. Scrub frequencies in the Results panel."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- FU-42 / FU-47: the electrostatic solve's outer boundary -->
        <GroupBox Header="Electrostatic settings"
                  Visibility="{Binding Session.IsElectrostaticAnalysis, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <CheckBox x:Name="OpenBoundaryCheck" Content="Open outer boundary (space beyond the mesh)"
                          IsChecked="{Binding Solve.ElectrostaticOpenBoundary}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,1,2,3"
                          ToolTip="Every boundary face no electrode claims carries the asymptotic condition of the net charge's 1/r field, so an isolated conductor has a capacitance to infinity. Unchecked: a zero-flux wall. Saved with the project's solver settings."/>
                <TextBlock Text="The 1/r term is exact; the dipole and higher terms are not absorbed, their share falling as (a/R)³ for a structure of size a in a boundary R away — the solve states a/R."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- FU-45 / FU-47: flux recovery and probes (DC conduction, steady heat) -->
        <GroupBox Header="Flux recovery and probes"
                  Visibility="{Binding Session.IsFluxRecoveryAnalysis, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <CheckBox x:Name="RecoverFluxCheck" Content="Recover the flux and estimate its error"
                          IsChecked="{Binding Solve.RecoverFlux}" Foreground="{DynamicResource TextMutedBrush}" Margin="2,1,2,3"
                          ToolTip="Superconvergent patch recovery of the current density or heat flux, one polynomial per material round every node, with the element error field and the energy-norm error of the whole mesh; and the flux through every probe below, in the log. Off: the solve's own fields only."/>
                <ItemsControl ItemsSource="{Binding Solve.FluxProbes}" IsEnabled="{Binding Solve.RecoverFlux}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    <Button Grid.Column="2" Content="×" Padding="0" ToolTip="Remove this probe"
                                            Command="{Binding DataContext.Solve.RemoveProbeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                <UniformGrid Columns="2" Visibility="{Binding IsPlane, Converter={StaticResource BoolToVis}}">
                                    <Label Content="Point x/y/z [mm]"/>
                                    <UniformGrid Columns="3">
                                        <TextBox Text="{Binding OriginXMm}" Margin="0,0,2,0"/>
                                        <TextBox Text="{Binding OriginYMm}" Margin="2,0,2,0"/>
                                        <TextBox Text="{Binding OriginZMm}" Margin="2,0,0,0"/>
                                    </UniformGrid>
                                    <Label Content="Normal x/y/z"/>
                                    <UniformGrid Columns="3">
                                        <TextBox Text="{Binding NormalX}" Margin="0,0,2,0"/>
                                        <TextBox Text="{Binding NormalY}" Margin="2,0,2,0"/>
                                        <TextBox Text="{Binding NormalZ}" Margin="2,0,0,0"/>
                                    </UniformGrid>
                                </UniformGrid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <UniformGrid Columns="2" Margin="0,2,0,0" IsEnabled="{Binding Solve.RecoverFlux}">
                    <Button Content="Add a plane probe" Command="{Binding Solve.AddPlaneProbeCommand}"
                            ToolTip="The flux crossing a plane through the point, in the normal's direction: the conservative value (the solve's own balance of the part on the plane's positive side) and the section value through the cut."/>
                    <Button Content="Probe on the selected faces" Command="{Binding Solve.AddFaceProbeCommand}" Margin="2,0,0,0"
                            ToolTip="The flux leaving the body through the selected boundary faces."/>
                </UniformGrid>
                <TextBlock Text="Probes are kept for this session (not saved with the project); a plane limited to a box is library and command line only."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Report of the last solve: inputs, conditions, summary, field ranges, assumptions, log -->
        <GroupBox Header="Report">
            <StackPanel>
                <TextBlock Text="The last solve as a document: what was solved, the summary values, every field's range, the assumptions the solver stated, and its log. The same report the command line writes."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
                <Button Content="Save report (Markdown / HTML)" Command="{Binding Solve.SaveReportCommand}"
                        IsEnabled="{Binding Solve.HasReport}"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
