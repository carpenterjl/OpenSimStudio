<UserControl x:Class="OpenSim.App.Views.Panels.MaterialPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenSim.App.Controls">
    <GroupBox Header="Material"
              Visibility="{Binding Session.IsPcbMode, Converter={StaticResource InverseBoolToVis}}">
        <StackPanel>
            <ComboBox x:Name="MaterialCombo"
                      ItemsSource="{Binding Materials.Materials}" SelectedItem="{Binding Session.SelectedMaterial}"
                      DisplayMemberPath="Name"/>
            <!-- Only the properties the selected analysis reads. -->
            <controls:FormGrid Margin="0,4,0,0"
                         Visibility="{Binding Session.IsStructuralAnalysis, Converter={StaticResource BoolToVis}}">
                <Label Content="E [Pa]"/>
                <TextBlock Text="{Binding Session.SelectedMaterial.YoungsModulus, StringFormat=g4}" VerticalAlignment="Center"/>
                <Label Content="ν"/>
                <TextBlock Text="{Binding Session.SelectedMaterial.PoissonRatio}" VerticalAlignment="Center"/>
                <Label Content="ρ [kg/m³]"/>
                <TextBlock Text="{Binding Session.SelectedMaterial.Density}" VerticalAlignment="Center"/>
            </controls:FormGrid>
            <controls:FormGrid Margin="0,4,0,0"
                         Visibility="{Binding Session.IsThermalAnalysis, Converter={StaticResource BoolToVis}}">
                <Label Content="k [W/(m·K)]"/>
                <TextBlock Text="{Binding Session.SelectedMaterial.ThermalConductivity, StringFormat=g4}" VerticalAlignment="Center"/>
                <Label Content="ρ [kg/m³]"/>
                <TextBlock Text="{Binding Session.SelectedMaterial.Density}" VerticalAlignment="Center"/>
                <Label Content="cₚ [J/(kg·K)]"/>
                <TextBlock Text="{Binding Session.SelectedMaterial.SpecificHeat, StringFormat=g4}" VerticalAlignment="Center"/>
            </controls:FormGrid>
            <controls:FormGrid Margin="0,4,0,0"
                         Visibility="{Binding Session.ShowsConductivity, Converter={StaticResource BoolToVis}}">
                <Label Content="σ [S/m]"/>
                <TextBlock Text="{Binding Session.SelectedMaterial.ElectricalConductivity, StringFormat=g4}" VerticalAlignment="Center"/>
            </controls:FormGrid>
            <controls:FormGrid Margin="0,4,0,0"
                         Visibility="{Binding Session.ShowsPermittivity, Converter={StaticResource BoolToVis}}">
                <Label Content="εᵣ"/>
                <TextBlock Text="{Binding Session.SelectedMaterial.RelativePermittivity, StringFormat=g4}" VerticalAlignment="Center"/>
            </controls:FormGrid>
            <Button Content="Edit materials…" Command="{Binding Materials.EditMaterialsCommand}" Margin="0,4,0,0"/>
        </StackPanel>
    </GroupBox>
</UserControl>
