<UserControl x:Class="OpenSim.App.Views.Panels.OpticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenSim.App.Controls"
             xmlns:panels="clr-namespace:OpenSim.App.Views.Panels">
    <!-- The Optics workspace's panel: the mode, the lens data editor, the system data, the
         glass and coating catalogs. -->
    <GroupBox Header="Optical system">
        <StackPanel>
            <controls:FormGrid>
                <Label Content="Mode"/>
                <ComboBox x:Name="OpticsModeCombo" ItemsSource="{Binding Optics.Modes}"
                          SelectedItem="{Binding Optics.SelectedMode}"
                          DisplayMemberPath="Label"
                          AutomationProperties.AutomationId="OpticsModeCombo"/>
            </controls:FormGrid>
            <TextBlock Text="{Binding Optics.ModeDescription}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFaintBrush}" Margin="0,4,0,0"/>
            <!-- OP-31: the sequential surfaces, edited in the Lens Data Editor window. -->
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Content="Lens Data Editor…" Click="LensDataEditor_Click"
                        AutomationProperties.AutomationId="OpticsLensDataEditorButton"/>
                <TextBlock Text="{Binding Optics.LensEditor.SurfaceCount, StringFormat='{}{0} surfaces, object and image included'}"
                           VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource FaintText}"/>
            </DockPanel>
            <TextBlock Text="{Binding Optics.LensEditor.ProblemsText}" TextWrapping="Wrap" Style="{StaticResource FaintText}" Margin="0,4,0,0"/>
            <!-- OP-54: the merit function, edited in the Merit Function Editor window. -->
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Left" Content="Merit Function Editor…" Click="MeritFunctionEditor_Click"
                        AutomationProperties.AutomationId="OpticsMeritFunctionEditorButton"/>
                <!-- OP-57: local optimization against the merit function. -->
                <Button DockPanel.Dock="Left" Content="Optimize…" Click="Optimize_Click" Margin="4,0,0,0"
                        AutomationProperties.AutomationId="OpticsOptimizeButton"/>
                <TextBlock Text="{Binding Optics.MeritEditor.OperandCount, StringFormat='{}{0} operands'}"
                           VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource FaintText}"/>
            </DockPanel>
            <!-- OP-60: the manual adjustment tools (OpticStudio's Manual Adjustment group). -->
            <WrapPanel Margin="0,4,0,0">
                <Button Content="Quick Focus…" Click="QuickFocus_Click" Margin="0,0,4,0"
                        ToolTip="Adjust the thickness before the image for the best RMS spot or wavefront."
                        AutomationProperties.AutomationId="OpticsQuickFocusButton"/>
                <Button Content="Quick Adjust…" Click="QuickAdjust_Click" Margin="0,0,4,0"
                        ToolTip="Adjust one radius or thickness for the best RMS at a later surface."
                        AutomationProperties.AutomationId="OpticsQuickAdjustButton"/>
                <Button Content="Slider…" Click="Slider_Click" Margin="0,0,4,0"
                        ToolTip="Drag one surface value while the analysis windows update."
                        AutomationProperties.AutomationId="OpticsSliderButton"/>
                <Button Content="Visual Optimizer…" Click="VisualOptimizer_Click"
                        ToolTip="Sliders on up to eight variables while the analysis windows update."
                        AutomationProperties.AutomationId="OpticsVisualOptimizerButton"/>
            </WrapPanel>
            <!-- OP-17: test plate fitting (OpticStudio's Optimization Tools group). -->
            <WrapPanel Margin="0,4,0,0">
                <Button Content="Test Plate Fitting…" Click="TestPlateFitting_Click"
                        ToolTip="Fit the variable radii to a fabricator's test plate list, re-optimizing after each."
                        AutomationProperties.AutomationId="OpticsTestPlateFittingButton"/>
            </WrapPanel>
            <!-- OP-61 -->
            <WrapPanel Margin="0,4,0,0">
                <Button Content="Design Conversion Tools…" Click="DesignTools_Click"
                        ToolTip="Find Best Asphere, Convert Asphere Types and Stock Lens Matching."
                        AutomationProperties.AutomationId="OpticsDesignToolsButton"/>
            </WrapPanel>
            <!-- OP-16: stock lens catalogs, Insert Lens and design templates (OpticStudio's Libraries tab). -->
            <WrapPanel Margin="0,4,0,0">
                <Button Content="Lens Catalogs…" Click="LensCatalogs_Click"
                        ToolTip="Search stock lens catalogs built from vendor .zmx files, insert a lens, or start from a design template."
                        AutomationProperties.AutomationId="OpticsLensCatalogsButton"/>
            </WrapPanel>
            <!-- OP-99 -->
            <WrapPanel Margin="0,4,0,0">
                <Button Content="ZPL Macros…" Click="Macros_Click"
                        ToolTip="Edit and run OpticStudio ZPL macros on the lens."
                        AutomationProperties.AutomationId="OpticsMacrosButton"/>
            </WrapPanel>
            <!-- OP-96 -->
            <WrapPanel Margin="0,4,0,0">
                <Button Content="Export CAD Files…" Click="CadExport_Click"
                        ToolTip="Write the lens elements, mirrors and rays as STEP, IGES, STL or a 2-D DXF cross-section."
                        AutomationProperties.AutomationId="OpticsCadExportButton"/>
            </WrapPanel>
            <!-- OP-63: the tolerance data, edited in the Tolerance Data Editor window. -->
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Left" Content="Tolerance Data Editor…" Click="ToleranceDataEditor_Click"
                        AutomationProperties.AutomationId="OpticsToleranceDataEditorButton"/>
                <TextBlock Text="{Binding Optics.ToleranceEditor.OperandCount, StringFormat='{}{0} tolerance operands'}"
                           VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource FaintText}"/>
            </DockPanel>
            <!-- OP-30: the configurations, edited in the Multi-Configuration Editor window; the
                 current one is what the analyses use. -->
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Content="Multi-Configuration Editor…" Click="MultiConfigEditor_Click"
                        AutomationProperties.AutomationId="OpticsMultiConfigEditorButton"/>
                <ComboBox DockPanel.Dock="Left" Width="56" Margin="8,0,0,0" ItemsSource="{Binding Optics.MultiConfig.Configurations}"
                          SelectedItem="{Binding Optics.MultiConfig.CurrentConfiguration}"
                          ToolTip="The current configuration: the one every analysis uses."
                          AutomationProperties.AutomationId="OpticsCurrentConfigurationCombo"/>
                <TextBlock Text="{Binding Optics.MultiConfig.Summary}" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource FaintText}"/>
            </DockPanel>
            <!-- OP-71: the non-sequential objects, edited in the Non-Sequential Component Editor window. -->
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Content="Non-Sequential Component Editor…" Click="NonSequentialEditor_Click"
                        AutomationProperties.AutomationId="OpticsNonSequentialEditorButton"/>
                <TextBlock Text="{Binding Optics.NonSequentialEditor.ObjectCount, StringFormat='{}{0} objects'}"
                           VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource FaintText}"/>
            </DockPanel>
            <!-- OP-18: the system data; OP-10: the lens on its own. -->
            <panels:OpticsSystemDataPanel/>
            <!-- OP-11: the glass catalogs. -->
            <panels:OpticsMaterialsPanel/>
            <!-- OP-15: the coating catalog. -->
            <panels:OpticsCoatingsPanel/>
        </StackPanel>
    </GroupBox>
</UserControl>
