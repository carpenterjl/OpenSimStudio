<UserControl x:Class="OpenSim.App.Views.Panels.OpticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenSim.App.Controls"
             xmlns:panels="clr-namespace:OpenSim.App.Views.Panels">
    <!-- The Optics workspace's panel: the mode, the lens data editor, the system data, the
         glass and coating catalogs. -->
    <GroupBox Header="Optical system">
        <StackPanel>
            <controls:FormGrid>
                <Label Content="Mode"/>
                <ComboBox x:Name="OpticsModeCombo" ItemsSource="{Binding Optics.Modes}"
                          SelectedItem="{Binding Optics.SelectedMode}"
                          DisplayMemberPath="Label"
                          AutomationProperties.AutomationId="OpticsModeCombo"/>
            </controls:FormGrid>
            <TextBlock Text="{Binding Optics.ModeDescription}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFaintBrush}" Margin="0,4,0,0"/>
            <!-- OP-31: the sequential surfaces, edited in the Lens Data Editor window. -->
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Content="Lens Data Editor…" Click="LensDataEditor_Click"
                        AutomationProperties.AutomationId="OpticsLensDataEditorButton"/>
                <TextBlock Text="{Binding Optics.LensEditor.SurfaceCount, StringFormat='{}{0} surfaces, object and image included'}"
                           VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource FaintText}"/>
            </DockPanel>
            <TextBlock Text="{Binding Optics.LensEditor.ProblemsText}" TextWrapping="Wrap" Style="{StaticResource FaintText}" Margin="0,4,0,0"/>
            <!-- OP-18: the system data; OP-10: the lens on its own. -->
            <panels:OpticsSystemDataPanel/>
            <!-- OP-11: the glass catalogs. -->
            <panels:OpticsMaterialsPanel/>
            <!-- OP-15: the coating catalog. -->
            <panels:OpticsCoatingsPanel/>
        </StackPanel>
    </GroupBox>
</UserControl>
