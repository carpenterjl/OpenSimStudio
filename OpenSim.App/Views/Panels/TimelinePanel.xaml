<UserControl x:Class="OpenSim.App.Views.Panels.TimelinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Playback head over a multi-frame result. The slider carries axis VALUES (seconds),
         with the frames as its ticks and snap-to-tick on: the thumb is then time-
         proportional and lands exactly on frames, both from one property. No binding Delay
         anywhere — scrubbing has to show frames while the mouse is still down. -->
    <!-- No AutomationId here on purpose: a Border has no automation peer, so an id on it
         is invisible to UI automation. The panel is probed by TimelineSlider instead. -->
    <Border Background="#CC1E1E24" CornerRadius="4" Padding="8">
        <StackPanel Width="400">
            <DockPanel Margin="0,0,0,2">
                <Button x:Name="TimelinePlayButton" DockPanel.Dock="Left" Width="30" Padding="0"
                        Content="{Binding Results.PlayButtonLabel}"
                        Command="{Binding Results.TogglePlayCommand}"
                        ToolTip="Play / pause the result animation"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Results.FrameAxis}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <ComboBox x:Name="TimelineSpeedCombo" DockPanel.Dock="Right" Width="58"
                          ItemsSource="{Binding Results.PlaySpeedOptions}"
                          SelectedItem="{Binding Results.PlaySpeed}"
                          ToolTip="Playback rate; 1x sweeps the whole axis in 5 seconds">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0}x}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox x:Name="TimelineLoopCheck" DockPanel.Dock="Right" Content="Loop"
                          IsChecked="{Binding Results.LoopPlayback}" Foreground="#C9C9D2"
                          VerticalAlignment="Center" Margin="0,0,6,0"
                          ToolTip="Restart at the first frame instead of stopping at the last"/>
                <TextBlock x:Name="TimelineTimeText" Text="{Binding Results.CurrentTimeLabel}"
                           TextAlignment="Right" VerticalAlignment="Center" Margin="6,0"
                           AutomationProperties.AutomationId="TimelineTimeText"/>
            </DockPanel>

            <Slider x:Name="TimelineSlider" Width="400" HorizontalAlignment="Left"
                    Minimum="{Binding Results.FrameTimeMin}"
                    Maximum="{Binding Results.FrameTimeMax}"
                    Value="{Binding Results.CurrentFrameTime}"
                    Ticks="{Binding Results.FrameTicks}"
                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                    TickPlacement="BottomRight"/>

            <!-- Axis labels, positioned in the view model against the slider's own track
                 (see TimelineTickMark: the track is inset by half a thumb at each end). -->
            <ItemsControl x:Name="TimelineTicks" ItemsSource="{Binding Results.TimelineTickLabels}"
                          Width="400" Height="13" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" Width="64" FontSize="9"
                                   Foreground="#8A8A96" TextAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
