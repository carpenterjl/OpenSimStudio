<UserControl x:Class="OpenSim.App.Views.Panels.BoundaryConditionsListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GroupBox Header="Boundary conditions">
        <Grid>
            <ListBox ItemsSource="{Binding Conditions.BoundaryConditions}" MinHeight="60" MaxHeight="180">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" Margin="4,0,0,0"
                                Command="{Binding DataContext.Conditions.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScopeSummary}" Opacity="0.7" FontSize="10"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
                <TextBlock Text="No conditions yet. Select faces in the view, then add one above." IsHitTestVisible="False" Margin="8,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FaintText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Conditions.BoundaryConditions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
        </Grid>
    </GroupBox>
</UserControl>
