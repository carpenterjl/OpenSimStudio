<UserControl x:Class="OpenSim.App.Views.Panels.StructuralConditionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenSim.App.Controls">
    <GroupBox Header="Structural conditions (select faces first)"
              Visibility="{Binding Session.IsStructuralAnalysis, Converter={StaticResource BoolToVis}}">
        <StackPanel>
            <Button x:Name="AddFixedSupportButton" Content="Add fixed support" Command="{Binding Conditions.AddFixedSupportCommand}"/>
            <!-- A modal solve ignores loads: only the supports shape its modes. -->
            <StackPanel Visibility="{Binding Session.IsModalAnalysis, Converter={StaticResource InverseBoolToVis}}">
            <controls:FormGrid Margin="0,6,0,0">
                <Label Content="Fx [N]"/>
                <TextBox Text="{Binding Conditions.ForceX}"/>
                <Label Content="Fy [N]"/>
                <TextBox x:Name="ForceYBox" Text="{Binding Conditions.ForceY}"/>
                <Label Content="Fz [N]"/>
                <TextBox Text="{Binding Conditions.ForceZ}"/>
            </controls:FormGrid>
            <Button x:Name="AddForceButton" Content="Add force" Command="{Binding Conditions.AddForceCommand}"/>
            <controls:FormGrid Margin="0,6,0,0">
                <Label Content="Pressure [Pa]"/>
                <TextBox Text="{Binding Conditions.PressureMagnitude}"/>
            </controls:FormGrid>
            <Button Content="Add pressure" Command="{Binding Conditions.AddPressureCommand}"/>
            </StackPanel>
        </StackPanel>
    </GroupBox>
</UserControl>
