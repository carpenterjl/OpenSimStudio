<UserControl x:Class="OpenSim.App.Views.Panels.SignalIntegrityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Moved verbatim out of ElectricalSetupPanel when SI became its own workspace (design screens 13-14); bindings go through the shell DataContext unchanged. -->
    <StackPanel>
    <GroupBox Header="Stackup and impedance calculator" DataContext="{Binding SignalIntegrity.Calculator}">
        <StackPanel>
            <TextBlock Text="One trace or an edge-coupled pair, over one plane or between two, with optional coplanar grounds: Z0, Z_diff, delay and loss from the same 2D field solve the board extraction uses."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
            <UniformGrid Columns="4">
                <Label Content="Structure"/>
                <ComboBox x:Name="ZcStructureCombo" ItemsSource="{Binding Structures}" SelectedItem="{Binding Structure}"/>
                <Label Content="Frequency [GHz]"/>
                <TextBox x:Name="ZcFrequencyBox" Text="{Binding FrequencyGhz}"/>
                <Label Content="Width base / top [mm]"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="ZcWidthBox" Text="{Binding WidthMm}" Margin="0,0,2,0"/>
                    <TextBox Text="{Binding TopWidthMm}" Margin="2,0,0,0"
                             ToolTip="Width at the top of an etched trace; 0 = rectangular"/>
                </UniformGrid>
                <Label Content="Copper [µm] / rough [µm]"/>
                <UniformGrid Columns="2">
                    <TextBox Text="{Binding CopperThicknessUm}" Margin="0,0,2,0"/>
                    <TextBox Text="{Binding RoughnessUm}" Margin="2,0,0,0"
                             ToolTip="RMS surface roughness (Hammerstad); 0 = smooth copper"/>
                </UniformGrid>
                <Label Content="Below: h [mm] / εr / tanδ"/>
                <UniformGrid Columns="3">
                    <TextBox x:Name="ZcHeightBox" Text="{Binding HeightMm}" Margin="0,0,2,0"/>
                    <TextBox Text="{Binding EpsR}" Margin="1,0"/>
                    <TextBox Text="{Binding TanD}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Above: h [mm] / εr / tanδ"
                       ToolTip="The layer over the trace: a cover layer, or the dielectric up to the upper plane of a stripline. Not used by a plain microstrip."/>
                <UniformGrid Columns="3">
                    <TextBox Text="{Binding UpperHeightMm}" Margin="0,0,2,0"/>
                    <TextBox Text="{Binding UpperEpsR}" Margin="1,0"/>
                    <TextBox Text="{Binding UpperTanD}" Margin="2,0,0,0"/>
                </UniformGrid>
                <CheckBox x:Name="ZcPairCheck" Content="Differential pair, gap [mm]" IsChecked="{Binding IsPair}"
                          Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,1"/>
                <TextBox Text="{Binding PairGapMm}"/>
                <CheckBox x:Name="ZcCoplanarCheck" Content="Coplanar ground, gap [mm]" IsChecked="{Binding HasCoplanarGround}"
                          Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,1"/>
                <TextBox Text="{Binding CoplanarGapMm}"/>
            </UniformGrid>
            <Button x:Name="ZcCalculateButton" Content="Calculate impedance" Command="{Binding CalculateCommand}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Result}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Assumptions}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
        </StackPanel>
    </GroupBox>
    <GroupBox Header="Signal integrity (coupled lines)">
        <StackPanel>
            <!-- Step 7: signal integrity (SI track) — coupled microstrip wizard →
                 RLGC → MTL network → S-params/Touchstone → PRBS transient + eye. -->
            <TextBlock Text="N coupled microstrips on the substrate: per-unit-length RLGC (2D quasi-static BEM over the layered dielectric), the exact frequency-domain coupled-line network, S-parameter export, and PRBS eye diagrams with crosstalk. Thevenin driver + R∥C receiver."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
            <UniformGrid Columns="4">
                <Label Content="Lines / driven"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="SiLineCountBox" Text="{Binding SignalIntegrity.LineCount}" Margin="0,0,2,0"/>
                    <TextBox x:Name="SiDrivenLineBox" Text="{Binding SignalIntegrity.DrivenLine}" Margin="2,0,0,0"
                             ToolTip="1-based index of the driven (victim) line"/>
                </UniformGrid>
                <Label Content="Width / gap [mm]"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="SiWidthBox" Text="{Binding SignalIntegrity.TraceWidthMm}" Margin="0,0,2,0"/>
                    <TextBox x:Name="SiGapBox" Text="{Binding SignalIntegrity.TraceGapMm}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Substrate h [mm] / εr"/>
                <UniformGrid Columns="2">
                    <TextBox x:Name="SiHeightBox" Text="{Binding SignalIntegrity.SubstrateHeightMm}" Margin="0,0,2,0"/>
                    <TextBox x:Name="SiEpsRBox" Text="{Binding SignalIntegrity.SiEpsR}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="tanδ / copper [µm]"/>
                <UniformGrid Columns="2">
                    <TextBox Text="{Binding SignalIntegrity.SiTanD}" Margin="0,0,2,0"/>
                    <TextBox Text="{Binding SignalIntegrity.CopperThicknessUm}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Length [mm]"/>
                <TextBox x:Name="SiLengthBox" Text="{Binding SignalIntegrity.LineLengthMm}"/>
                <Label Content="Signal"/>
                <ComboBox x:Name="SiSignalCombo"
                          ItemsSource="{Binding SignalIntegrity.SignalTypes}"
                          SelectedItem="{Binding SignalIntegrity.SignalType}"/>
                <Label Content="Bit rate [Gb/s]"/>
                <TextBox x:Name="SiBitRateBox" Text="{Binding SignalIntegrity.BitRateGbps}"/>
                <Label Content="Rise [% UI] / amp [V]"/>
                <UniformGrid Columns="2">
                    <TextBox Text="{Binding SignalIntegrity.RiseFractionPercent}" Margin="0,0,2,0"/>
                    <TextBox Text="{Binding SignalIntegrity.AmplitudeVolts}" Margin="2,0,0,0"/>
                </UniformGrid>
                <Label Content="Driver Rs [Ω]"/>
                <TextBox Text="{Binding SignalIntegrity.SourceOhms}"/>
                <Label Content="Receiver R [Ω] / C [pF]"/>
                <UniformGrid Columns="2">
                    <TextBox Text="{Binding SignalIntegrity.LoadOhms}" Margin="0,0,2,0"/>
                    <TextBox Text="{Binding SignalIntegrity.LoadPicofarads}" Margin="2,0,0,0"/>
                </UniformGrid>
                <CheckBox x:Name="SiAggressorsCheck" Content="Aggressors on"
                          IsChecked="{Binding SignalIntegrity.AggressorsEnabled}"
                          Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,1"
                          ToolTip="Drive every other line with a decorrelated PRBS — the crosstalk-closed eye"/>
                <CheckBox x:Name="SiProximityCheck" Content="Proximity R(f)"
                          IsChecked="{Binding SignalIntegrity.ProximityEffect}"
                          Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,1"
                          ToolTip="Frequency-dependent R(f) and internal L(f) from the 2D filament solve (current crowding + skin effect) — replaces max(R_dc, R_s√f)"/>
            </UniformGrid>

            <!-- Board extraction (Stage S6): pick 2+ parallel signal nets from the imported
                 board; the coupled cross-section replaces the wizard geometry above. -->
            <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,4,0,0"
                    Visibility="{Binding SignalIntegrity.HasBoard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="From board nets (2+ parallel for coupling; 1+ for C to ground):"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                    <ListBox x:Name="SiBoardNetsList" MaxHeight="110"
                             ItemsSource="{Binding SignalIntegrity.BoardNets}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource PanelBorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                          Foreground="{DynamicResource TextMutedBrush}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <CheckBox Content="Swap near/far ends (drive from the other end)"
                              IsChecked="{Binding SignalIntegrity.SwapBoardEnds}"
                              Foreground="{DynamicResource TextMutedBrush}" Margin="2,3,0,0"
                              ToolTip="The near end is where the first selected net's route starts; tick to drive from its other end. Applies at the next extraction — the result line states the near-end position."/>
                    <Button x:Name="SiBoardExtractButton" Content="Extract coupled section from nets"
                            Command="{Binding SignalIntegrity.ExtractFromBoardNetsCommand}"
                            Margin="0,3,0,0"/>
                    <CheckBox Content="Use board geometry (uncheck for wizard)"
                              IsChecked="{Binding SignalIntegrity.UseBoardNets}"
                              Foreground="{DynamicResource TextMutedBrush}" Margin="2,3,0,0"/>
                    <TextBlock Text="{Binding SignalIntegrity.BoardExtractionResult}" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                    <Button x:Name="SiTraceCapButton" Content="Per-trace C to ground"
                            Command="{Binding SignalIntegrity.ComputeTraceCapacitanceCommand}"
                            Margin="0,3,0,0"
                            ToolTip="Capacitance of each selected net to its reference plane: Σ C′(width, gap) × routed centerline length + parallel-plate pad terms, over the stackup dielectric (2D BEM). Bends and branches count; one net is enough."/>
                    <TextBlock Text="{Binding SignalIntegrity.TraceCapResult}" TextWrapping="Wrap"
                               FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                    <Button x:Name="SiDcNetsButton" Content="Evaluate DC nets (R, C, τ → CSV)"
                            Command="{Binding SignalIntegrity.EvaluateDcNetsCommand}"
                            Margin="0,3,0,0"
                            ToolTip="Board-wide DC screen over EVERY net with 2+ pads: resistance between each pad pair (nodal network on the trace graph — branches and parallel paths solve exactly), the net's total C to the reference plane, and the lumped time constant τ = R·C, saved as a CSV report. Nets that can't be priced appear as typed note rows."/>
                    <TextBlock Text="{Binding SignalIntegrity.DcNetsResult}" TextWrapping="Wrap"
                               FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                    <Button x:Name="SiLayoutCheckButton" Content="Check layout rules (whole board)"
                            Command="{Binding SignalIntegrity.CheckLayoutRulesCommand}"
                            Margin="0,3,0,0"
                            ToolTip="Geometric checks, no field solve: traces over a split, slot or edge of their reference plane; layer changes with no stitching via or capacitor near the via; via stubs; traces close to the board edge. Uses the stackup panel's thicknesses."/>
                    <TextBlock Text="{Binding SignalIntegrity.LayoutCheckResult}" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    <UniformGrid Columns="2" Margin="0,3,0,0">
                        <Button x:Name="SiCrosstalkScanButton" Content="Scan board crosstalk"
                                Command="{Binding SignalIntegrity.ScanBoardCrosstalkCommand}"
                                ToolTip="Every two nets with traces running side by side on a layer, ranked by near-end and far-end crosstalk for the given edge (2D field solve per distinct cross-section)."/>
                        <TextBox x:Name="SiScanRiseBox" Text="{Binding SignalIntegrity.ScanRiseTimeNs}" Margin="2,0,0,0"
                                 ToolTip="Aggressor rise time [ns]"/>
                    </UniformGrid>
                    <TextBlock Text="{Binding SignalIntegrity.CrosstalkScanResult}" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- IBIS driver (Stage S11): a nonlinear behavioral buffer replaces the Thevenin
                 driver for a single line; the eye then runs the nonlinear engine. -->
            <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,4,0,0">
                <StackPanel>
                    <UniformGrid Columns="3">
                        <Button x:Name="SiIbisLoadButton" Content="IBIS model…"
                                Command="{Binding SignalIntegrity.LoadIbisCommand}"
                                ToolTip="Load an .ibs behavioral buffer and drive the eye with its nonlinear V-I curves (single line)"/>
                        <ComboBox x:Name="SiIbisModelCombo" Margin="2,0"
                                  ItemsSource="{Binding SignalIntegrity.IbisModelNames}"
                                  SelectedItem="{Binding SignalIntegrity.SelectedIbisModel}"/>
                        <ComboBox x:Name="SiIbisCornerCombo"
                                  ItemsSource="{Binding SignalIntegrity.IbisCorners}"
                                  SelectedItem="{Binding SignalIntegrity.IbisCorner}"/>
                    </UniformGrid>
                    <CheckBox x:Name="SiUseIbisCheck" Content="Use IBIS driver (nonlinear)"
                              IsChecked="{Binding SignalIntegrity.UseIbisDriver}"
                              Foreground="{DynamicResource TextMutedBrush}" Margin="2,3,0,0"
                              ToolTip="Drive with the buffer's V-I tables and measured switching waveforms. Coupled lines are solved together, so crosstalk is computed in the same nonlinear solve."/>
                    <CheckBox x:Name="SiReceiverClampsCheck" Content="Receiver clamps (nonlinear)"
                              IsChecked="{Binding SignalIntegrity.UseReceiverClamps}"
                              Foreground="{DynamicResource TextMutedBrush}" Margin="2,3,0,0"
                              ToolTip="Model the receiver with the buffer's own GND/POWER protection diodes instead of a plain R∥C load. They only act where the waveform leaves the rails, so a well-terminated link is unaffected."/>
                    <TextBlock Text="{Binding SignalIntegrity.IbisStatus}" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="3" Margin="0,4,0,0">
                <Button x:Name="SiExtractButton" Content="Extract RLGC"
                        Command="{Binding SignalIntegrity.ExtractRlgcCommand}"/>
                <Button x:Name="SiSparamButton" Content="S-params (Touchstone)"
                        Command="{Binding SignalIntegrity.ComputeSParametersCommand}"/>
                <Button x:Name="SiEyeButton" Content="Transient + eye"
                        Command="{Binding SignalIntegrity.RunEyeDiagramCommand}"/>
            </UniformGrid>
            <TextBlock Text="{Binding SignalIntegrity.RlgcResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding SignalIntegrity.SParamResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding SignalIntegrity.EyeResult}" TextWrapping="Wrap"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
            <Image Source="{Binding SignalIntegrity.EyeImage}" MaxHeight="180" Margin="0,4,0,0"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"
                   AutomationProperties.AutomationId="SiEyeImage"/>
            <TextBlock Text="{Binding SignalIntegrity.SiAssumptions}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
        </StackPanel>
    </GroupBox>
    <GroupBox Header="Power distribution impedance (PDN)" DataContext="{Binding SignalIntegrity.Pdn}">
        <StackPanel>
            <TextBlock Text="Impedance against frequency at a load's supply pins: the plane pair of a power and a ground net (2D finite elements on its real outline), the capacitors between the two nets with their mounting inductance, a regulator, and a target."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,2"/>
            <UniformGrid Columns="2">
                <Label Content="Power net"/>
                <ComboBox x:Name="PdnPowerNetCombo" ItemsSource="{Binding Nets}" SelectedItem="{Binding PowerNet}"
                          DisplayMemberPath="Label"/>
                <Label Content="Ground net"/>
                <ComboBox x:Name="PdnGroundNetCombo" ItemsSource="{Binding Nets}" SelectedItem="{Binding GroundNet}"
                          DisplayMemberPath="Label"/>
                <Label Content="Capacitor default C [nF]"/>
                <TextBox Text="{Binding DefaultNanofarads}"/>
                <Label Content="Default ESR [mΩ]"/>
                <TextBox Text="{Binding DefaultEsrMilliohms}"/>
                <Label Content="Default ESL [nH]"/>
                <TextBox Text="{Binding DefaultEslNanohenries}"/>
            </UniformGrid>
            <Button x:Name="PdnFindPlanesButton" Content="Read planes and capacitors from the board"
                    Command="{Binding FindPlanesCommand}" Margin="0,3,0,0"
                    ToolTip="Finds the two nets' planes and where they overlap, and every component C… with a pad on each net: its via to the planes and the inductance of its mounting above them. Uses the stackup panel's thicknesses."/>
            <TextBlock Text="{Binding PlanesResult}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                <ItemsControl x:Name="PdnCapacitorList" ItemsSource="{Binding Capacitors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Include}" IsEnabled="{Binding CanInclude}"
                                          Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Mounting}" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Mounting}"/>
                                <TextBox Grid.Column="2" Text="{Binding Nanofarads}" ToolTip="C [nF]"/>
                                <TextBox Grid.Column="3" Text="{Binding EsrMilliohms}" ToolTip="ESR [mΩ]"/>
                                <TextBox Grid.Column="4" Text="{Binding EslNanohenries}" ToolTip="ESL [nH]"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <UniformGrid Columns="2" Margin="0,3,0,0">
                <Button x:Name="PdnVendorModelButton" Content="Capacitor S-parameters…" Command="{Binding LoadVendorModelCommand}"
                        ToolTip="A vendor .s1p, or a .s2p measured in shunt, used for every included capacitor instead of C, ESR and ESL."/>
                <Button Content="Back to C / ESR / ESL" Command="{Binding ClearVendorModelCommand}" Margin="2,0,0,0"/>
            </UniformGrid>
            <TextBlock Text="{Binding VendorModelStatus}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,1,0,0"/>
            <UniformGrid Columns="2" Margin="0,3,0,0">
                <Label Content="Load (refdes)"/>
                <TextBox x:Name="PdnLoadBox" Text="{Binding LoadRefDes}"
                         ToolTip="The part whose supply pins see the impedance, e.g. U1."/>
                <Label Content="Regulator (refdes, optional)"/>
                <TextBox Text="{Binding RegulatorRefDes}"/>
                <Label Content="Regulator R [mΩ]"/>
                <TextBox Text="{Binding RegulatorMilliohms}"/>
                <Label Content="Regulator L [nH]"/>
                <TextBox Text="{Binding RegulatorNanohenries}"/>
                <Label Content="Rail [V] (0 = no target)"/>
                <TextBox Text="{Binding RailVolts}"/>
                <Label Content="Allowed ripple [%]"/>
                <TextBox Text="{Binding RipplePercent}"/>
                <Label Content="Current step [A]"/>
                <TextBox Text="{Binding StepAmps}"/>
                <Label Content="Target up to [MHz]"/>
                <TextBox Text="{Binding TargetUpToMhz}"/>
                <Label Content="Sweep from [kHz]"/>
                <TextBox Text="{Binding FromKhz}"/>
                <Label Content="Sweep to [MHz]"/>
                <TextBox Text="{Binding ToMhz}"/>
            </UniformGrid>
            <Button x:Name="PdnSolveButton" Content="Solve PDN impedance" Command="{Binding SolveCommand}" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding Result}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            <Image Source="{Binding Plot}" MaxHeight="300" Margin="0,4,0,0" Stretch="Uniform"
                   AutomationProperties.AutomationId="PdnPlotImage"/>
            <UniformGrid Columns="2" Margin="0,3,0,0">
                <Button Content="Save curve (CSV)" Command="{Binding SaveCsvCommand}" IsEnabled="{Binding HasResult}"/>
                <Button Content="Save Touchstone (.s1p)" Command="{Binding SaveTouchstoneCommand}"
                        IsEnabled="{Binding HasResult}" Margin="2,0,0,0"/>
            </UniformGrid>
            <TextBlock Text="{Binding Assumptions}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0"/>
        </StackPanel>
    </GroupBox>
    </StackPanel>
</UserControl>
