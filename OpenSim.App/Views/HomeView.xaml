<UserControl x:Class="OpenSim.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OpenSim.App.Controls"
             Background="{DynamicResource AppBgBrush}">
    <!-- Home / launcher (design screens 01 + 18): start actions, geometry imports and
         recent projects on the left; the six workspace cards on the right. Empty recent
         list shows the action that fills it. -->
    <UserControl.Resources>
        <controls:RelativeTimeConverter x:Key="RelativeTime"/>

        <Style x:Key="ImportRow" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="WorkspaceCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{DynamicResource PanelBgBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="18,16" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBgRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
        </Style>
        <Style x:Key="CapChipText" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
        </Style>
        <Style x:Key="CardBody" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,8"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Status strip -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource RailBgBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Style="{StaticResource MonoText}" Foreground="{DynamicResource TextMutedBrush}"
                           Text="Ready. Open a project or import geometry to begin."/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                           Style="{StaticResource MonoText}" Foreground="{DynamicResource TextFaintBrush}"
                           Text="offline"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="432"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======== Left column: start / import / recent ======== -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="32,34">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="OpenSim Studio" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextHeadingBrush}"/>
                        <TextBlock Text="Offline-first engineering simulation — geometry to post-processing"
                                   Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,22"/>

                        <TextBlock Text="START" Style="{StaticResource MicroHeader}"/>
                        <Grid Margin="0,2,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource AccentButton}"
                                    Command="{Binding NewProjectCommand}"
                                    AutomationProperties.AutomationId="HomeNewProjectButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Width="16" Height="16"
                                                        Geometry="{StaticResource IconFilePlus2}"
                                                        Foreground="{DynamicResource AccentOnBrush}"/>
                                    <TextBlock Text="New project" Margin="9,0,0,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentOnBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding OpenProjectCommand}"
                                    AutomationProperties.AutomationId="HomeOpenProjectButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Width="16" Height="16"
                                                        Geometry="{StaticResource IconFolderOpen}"
                                                        Foreground="{DynamicResource TextBodyBrush}"/>
                                    <TextBlock Text="Open project…" Margin="9,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="IMPORT GEOMETRY" Style="{StaticResource MicroHeader}"/>
                        <Button Style="{StaticResource ImportRow}" Command="{Binding HomeImportStlCommand}"
                                AutomationProperties.AutomationId="HomeImportStlButton">
                            <DockPanel>
                                <controls:IconGlyph DockPanel.Dock="Left" Width="15" Height="15"
                                                    VerticalAlignment="Top" Margin="0,2,10,0"
                                                    Geometry="{StaticResource IconTriangle}"
                                                    Foreground="{DynamicResource KindModuleBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="Import STL…" FontWeight="Medium" FontSize="13"/>
                                    <TextBlock Text="A single part — mesh and analyze (Structural)"
                                               Style="{StaticResource FaintText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource ImportRow}" Command="{Binding HomeImportStepCommand}"
                                AutomationProperties.AutomationId="HomeImportStepButton">
                            <DockPanel>
                                <controls:IconGlyph DockPanel.Dock="Left" Width="15" Height="15"
                                                    VerticalAlignment="Top" Margin="0,2,10,0"
                                                    Geometry="{StaticResource IconBox}"
                                                    Foreground="{DynamicResource KindVariableBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="Import STEP…" FontWeight="Medium" FontSize="13"/>
                                    <TextBlock Text="CAD solid (AP203/AP214): mesh and analyze (Structural)"
                                               Style="{StaticResource FaintText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource ImportRow}" Command="{Binding HomeImportAssemblyCommand}"
                                AutomationProperties.AutomationId="HomeImportAssemblyButton">
                            <DockPanel>
                                <controls:IconGlyph DockPanel.Dock="Left" Width="15" Height="15"
                                                    VerticalAlignment="Top" Margin="0,2,10,0"
                                                    Geometry="{StaticResource IconBoxes}"
                                                    Foreground="{DynamicResource KindTypeBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="Import STEP assembly…" FontWeight="Medium" FontSize="13"/>
                                    <TextBlock Text="Every part as its own body: heat flow in an environment (Flow)"
                                               Style="{StaticResource FaintText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource ImportRow}" Command="{Binding HomeImportPcbCommand}"
                                AutomationProperties.AutomationId="HomeImportPcbButton">
                            <DockPanel>
                                <controls:IconGlyph DockPanel.Dock="Left" Width="15" Height="15"
                                                    VerticalAlignment="Top" Margin="0,2,10,0"
                                                    Geometry="{StaticResource IconCpu}"
                                                    Foreground="{DynamicResource KindConstantBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="Import PCB…" FontWeight="Medium" FontSize="13"/>
                                    <TextBlock Text="Gerber/IPC-2581 board: nets, resistance, Joule heating (Electrical)"
                                               Style="{StaticResource FaintText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <TextBlock Text="RECENT PROJECTS" Style="{StaticResource MicroHeader}"
                                   Margin="0,16,0,6"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Nothing here yet — projects you open or save appear here.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FaintText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentProjects.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding RecentProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Padding="10,8"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.OpenRecentCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <DockPanel>
                                                <controls:IconGlyph DockPanel.Dock="Left" Width="14" Height="14"
                                                                    Margin="0,0,10,0"
                                                                    Geometry="{StaticResource IconFolderOpen}"
                                                                    Foreground="{DynamicResource KindFunctionBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                           Style="{StaticResource FaintText}"
                                                           Text="{Binding LastOpenedUtc, Converter={StaticResource RelativeTime}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"/>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource MonoText}"
                                                               Foreground="{DynamicResource TextFaintBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ======== Right column: workspace cards ======== -->
            <DockPanel Grid.Column="1" Margin="36,34,24,24">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="WORKSPACES" Style="{StaticResource MicroHeader}" Margin="0,0,0,4"/>
                    <TextBlock Text="Each workspace opens the same gated study rail with only the panels its physics needs."
                               Style="{StaticResource MutedText}" FontSize="13"/>
                </StackPanel>
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource WorkspaceCard}"
                            Command="{Binding EnterWorkspaceCommand}"
                            CommandParameter="{x:Static vm:WorkspaceKind.Structural}"
                            xmlns:vm="clr-namespace:OpenSim.App.ViewModels"
                            AutomationProperties.AutomationId="HomeWorkspaceStructural">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <controls:IconGlyph Width="19" Height="19" Geometry="{StaticResource IconBox}"
                                                    Foreground="{DynamicResource KindFunctionBrush}"/>
                                <TextBlock Text="Structural" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Static" Style="{StaticResource CapChipText}"/></Border>
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Modal" Style="{StaticResource CapChipText}"/></Border>
                            </WrapPanel>
                            <TextBlock Text="Static and modal analysis on primitives, STL parts and STEP solids."
                                       Style="{StaticResource CardBody}" VerticalAlignment="Top"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource WorkspaceCard}"
                            Command="{Binding EnterWorkspaceCommand}"
                            CommandParameter="{x:Static vm:WorkspaceKind.Thermal}"
                            xmlns:vm="clr-namespace:OpenSim.App.ViewModels"
                            AutomationProperties.AutomationId="HomeWorkspaceThermal">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <controls:IconGlyph Width="19" Height="19" Geometry="{StaticResource IconThermometer}"
                                                    Foreground="{DynamicResource KindMacroBrush}"/>
                                <TextBlock Text="Thermal" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Steady-state" Style="{StaticResource CapChipText}"/></Border>
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Transient" Style="{StaticResource CapChipText}"/></Border>
                            </WrapPanel>
                            <TextBlock Text="Conduction with fixed temperatures, heat flow and convection — steady or transient."
                                       Style="{StaticResource CardBody}" VerticalAlignment="Top"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource WorkspaceCard}"
                            Command="{Binding EnterWorkspaceCommand}"
                            CommandParameter="{x:Static vm:WorkspaceKind.Electrical}"
                            xmlns:vm="clr-namespace:OpenSim.App.ViewModels"
                            AutomationProperties.AutomationId="HomeWorkspaceElectrical">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <controls:IconGlyph Width="19" Height="19" Geometry="{StaticResource IconZap}"
                                                    Foreground="{DynamicResource KindConstantBrush}"/>
                                <TextBlock Text="Electrical" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="DC conduction" Style="{StaticResource CapChipText}"/></Border>
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="AC sweep" Style="{StaticResource CapChipText}"/></Border>
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Joule heating" Style="{StaticResource CapChipText}"/></Border>
                            </WrapPanel>
                            <TextBlock Text="PCB import, DC conduction, AC sweep and Joule heating on board nets."
                                       Style="{StaticResource CardBody}" VerticalAlignment="Top"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource WorkspaceCard}"
                            Command="{Binding EnterWorkspaceCommand}"
                            CommandParameter="{x:Static vm:WorkspaceKind.Rf}"
                            xmlns:vm="clr-namespace:OpenSim.App.ViewModels"
                            AutomationProperties.AutomationId="HomeWorkspaceRf">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <controls:IconGlyph Width="19" Height="19" Geometry="{StaticResource IconRadioTower}"
                                                    Foreground="{DynamicResource KindTypeBrush}"/>
                                <TextBlock Text="RF &amp; antenna" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Zin sweep" Style="{StaticResource CapChipText}"/></Border>
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Near field" Style="{StaticResource CapChipText}"/></Border>
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Far field" Style="{StaticResource CapChipText}"/></Border>
                            </WrapPanel>
                            <TextBlock Text="Thin-wire and RWG surface method of moments in free space, over PEC ground, or on a substrate."
                                       Style="{StaticResource CardBody}" VerticalAlignment="Top"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource WorkspaceCard}"
                            Command="{Binding EnterWorkspaceCommand}"
                            CommandParameter="{x:Static vm:WorkspaceKind.SignalIntegrity}"
                            xmlns:vm="clr-namespace:OpenSim.App.ViewModels"
                            AutomationProperties.AutomationId="HomeWorkspaceSignalIntegrity">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <controls:IconGlyph Width="19" Height="19" Geometry="{StaticResource IconActivity}"
                                                    Foreground="{DynamicResource KindVariableBrush}"/>
                                <TextBlock Text="Signal integrity" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="RLGC" Style="{StaticResource CapChipText}"/></Border>
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Touchstone" Style="{StaticResource CapChipText}"/></Border>
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Eye" Style="{StaticResource CapChipText}"/></Border>
                            </WrapPanel>
                            <TextBlock Text="Coupled microstrips: per-unit-length RLGC, S-parameters and PRBS eye diagrams with crosstalk."
                                       Style="{StaticResource CardBody}" VerticalAlignment="Top"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource WorkspaceCard}"
                            Command="{Binding EnterWorkspaceCommand}"
                            CommandParameter="{x:Static vm:WorkspaceKind.Flow}"
                            xmlns:vm="clr-namespace:OpenSim.App.ViewModels"
                            AutomationProperties.AutomationId="HomeWorkspaceFlow">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <controls:IconGlyph Width="19" Height="19" Geometry="{StaticResource IconWind}"
                                                    Foreground="{DynamicResource KindInterfaceBrush}"/>
                                <TextBlock Text="Flow" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Environment" Style="{StaticResource CapChipText}"/></Border>
                                <Border Style="{StaticResource CapChip}"><TextBlock Text="Conjugate CFD" Style="{StaticResource CapChipText}"/></Border>
                            </WrapPanel>
                            <TextBlock Text="Assemblies in vacuum, still air or a moving fluid: transient heat flow and computed airflow."
                                       Style="{StaticResource CardBody}" VerticalAlignment="Top"/>
                        </DockPanel>
                    </Button>
                </UniformGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
