<Window x:Class="OpenSim.App.Views.MultiConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        xmlns:sheet="clr-namespace:OpenSim.App.Controls.Spreadsheet"
        Title="Multi-Configuration Editor" Width="900" Height="480" MinWidth="520" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}">
    <!-- OP-30: the Multi-Configuration Editor. DataContext is the OpticsMultiConfigEditorViewModel;
         the sheet is OP-10's SpreadsheetGrid (its own keys and context menu also work: Insert and
         Delete add and remove operand rows, the flag menu sets variable, pickup and thermal pickup). -->
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button Content="Insert operand" Command="{Binding InsertOperandCommand}" Margin="0,0,4,4"/>
            <Button Content="Delete operand" Command="{Binding DeleteOperandCommand}" Margin="0,0,4,4"/>
            <Button Content="Undo" Command="{Binding UndoCommand}" Margin="8,0,4,4"/>
            <Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,4,4"/>
            <Button Content="Insert configuration" Command="{Binding InsertConfigurationCommand}" Margin="8,0,4,4"
                    ToolTip="Insert a configuration at the cursor's column, a copy of the one there."/>
            <Button Content="Insert with pickups" Command="{Binding InsertConfigurationWithPickupsCommand}" Margin="0,0,4,4"
                    ToolTip="Insert a configuration whose cells pick up configuration 1."/>
            <Button Content="Delete configuration" Command="{Binding DeleteConfigurationCommand}" Margin="0,0,4,4"
                    ToolTip="Delete the configuration at the cursor's column."/>
            <Button Content="Make single configuration" Command="{Binding MakeSingleConfigurationCommand}" Margin="0,0,4,4"
                    ToolTip="Remove the table, leaving the lens in the current configuration."/>
        </WrapPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <controls:FormGrid DockPanel.Dock="Left" Width="280">
                <Label Content="Current configuration"/>
                <ComboBox ItemsSource="{Binding Configurations}" SelectedItem="{Binding CurrentConfiguration}"
                          AutomationProperties.AutomationId="MultiConfigCurrentCombo"
                          ToolTip="The configuration every analysis uses."/>
                <Label Content="Add all data for"/>
                <ComboBox ItemsSource="{Binding AddAllDataCodes}" SelectedItem="{Binding AddAllDataCode}"/>
            </controls:FormGrid>
            <WrapPanel Margin="8,0,0,0" VerticalAlignment="Top">
                <Button Content="Previous" Command="{Binding PreviousConfigurationCommand}" Margin="0,0,4,4"/>
                <Button Content="Next" Command="{Binding NextConfigurationCommand}" Margin="0,0,4,4"/>
                <Button Content="Add all data" Command="{Binding AddAllDataCommand}" Margin="8,0,4,4"
                        ToolTip="Add a row of the chosen operand for every surface, field or wavelength that holds such data."/>
            </WrapPanel>
        </DockPanel>

        <!-- OP-91: Make Thermal (OpticStudio help, "Make Thermal") and the glass-to-material links (OQ-12). -->
        <Expander DockPanel.Dock="Top" Header="Thermal" Margin="0,0,0,4">
            <WrapPanel Margin="0,4,0,0">
                <StackPanel Width="300" Margin="0,0,12,0">
                    <controls:FormGrid>
                        <Label Content="New configurations"/>
                        <TextBox Text="{Binding ThermalConfigurations, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Configurations spanning the range in equal steps, per nominal configuration."/>
                        <Label Content="Minimum temperature (°C)"/>
                        <TextBox Text="{Binding ThermalMinimum, UpdateSourceTrigger=LostFocus}"/>
                        <Label Content="Maximum temperature (°C)"/>
                        <TextBox Text="{Binding ThermalMaximum, UpdateSourceTrigger=LostFocus}"/>
                        <Label Content="Pressure (atm)"/>
                        <TextBox Text="{Binding ThermalPressure, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="The new configurations' air pressure; empty keeps the nominal pressure (OpticStudio's rule)."/>
                        <Label Content="Use existing configurations as nominal"/>
                        <CheckBox IsChecked="{Binding ThermalKeepExisting}" VerticalAlignment="Center"
                                  ToolTip="Off: the table is replaced by one nominal configuration (the current one) and the new ones."/>
                        <Label Content="Sort by surface"/>
                        <CheckBox IsChecked="{Binding ThermalSortBySurface}" VerticalAlignment="Center"/>
                    </controls:FormGrid>
                    <Button Content="Make thermal" Command="{Binding MakeThermalCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            ToolTip="Add configurations at each temperature, with thermal pickups on the radii, thicknesses and semi-diameters."/>
                </StackPanel>
                <StackPanel Width="320">
                    <controls:FormGrid>
                        <Label Content="Glass"/>
                        <ComboBox IsEditable="True" ItemsSource="{Binding GlassNames}" Text="{Binding LinkGlass, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="Mechanical material"/>
                        <ComboBox ItemsSource="{Binding MaterialNames}" SelectedItem="{Binding LinkMaterial}"
                                  ToolTip="The glass expands with this material's thermal expansion coefficient instead of its catalog TCE."/>
                    </controls:FormGrid>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Link" Command="{Binding LinkGlassToMaterialCommand}" Margin="0,0,4,4"/>
                        <Button Content="Unlink" Command="{Binding UnlinkGlassCommand}" Margin="0,0,4,4"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding GlassLinksText}" TextWrapping="Wrap" Style="{StaticResource FaintText}"/>
                </StackPanel>
            </WrapPanel>
        </Expander>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ProblemsText}" TextWrapping="Wrap" Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource FaintText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <sheet:SpreadsheetGrid x:Name="Grid" Document="{Binding Document}"/>
    </DockPanel>
</Window>
