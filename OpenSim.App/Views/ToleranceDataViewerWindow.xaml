<Window x:Class="OpenSim.App.Views.ToleranceDataViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        xmlns:analyses="clr-namespace:OpenSim.App.Views.Analyses"
        Title="Tolerance Data Viewer" Width="1100" Height="760" MinWidth="520" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}">
    <!-- OP-66: the Tolerance Data Viewer, Histogram and Yield. DataContext is the ToleranceDataViewerViewModel:
         the last sensitivity rows, the last Monte Carlo trials and the last Quick Yield of the Tolerance Data Editor. -->
    <Window.Resources>
        <analyses:AnalysisPlotViewConverter x:Key="PlotView"/>
    </Window.Resources>
    <TabControl Margin="8">
        <TabItem Header="Monte Carlo data">
            <DockPanel Margin="4">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button Content="Statistics" Command="{Binding ComputeStatisticsCommand}" Margin="0,0,4,4"
                            ToolTip="Basic statistics of every column (help, &quot;Tolerance Data Viewer&quot;)."/>
                    <Button Content="Save CSV…" Command="{Binding SaveCsvCommand}" Margin="0,0,4,4"/>
                </WrapPanel>
                <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Statistics}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160"
                          HeadersVisibility="Column" Margin="0,0,0,4" AutomationProperties.AutomationId="ToleranceDataStatisticsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Column" Binding="{Binding Column}"/>
                        <DataGridTextColumn Header="Count" Binding="{Binding Count}"/>
                        <DataGridTextColumn Header="Mean" Binding="{Binding Mean}"/>
                        <DataGridTextColumn Header="Std dev" Binding="{Binding StandardDeviation}"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding Min}"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding Max}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="TrialsGrid" ItemsSource="{Binding Trials}" AutoGenerateColumns="True" IsReadOnly="True"
                          HeadersVisibility="Column" AutomationProperties.AutomationId="ToleranceDataTrialsGrid"/>
            </DockPanel>
        </TabItem>
        <TabItem Header="Histogram and yield">
            <DockPanel Margin="4">
                <controls:FormGrid DockPanel.Dock="Left" Width="320" VerticalAlignment="Top">
                    <Label Content="Operand"/>
                    <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}"
                              ToolTip="The criterion, a compensator or a drawn tolerance (help, &quot;Histogram&quot;, &quot;Operand&quot;)."/>
                    <Label Content="Bin count"/>
                    <TextBox Text="{Binding Bins}"/>
                    <Label Content="Min value"/>
                    <TextBox Text="{Binding MinValueText, UpdateSourceTrigger=LostFocus}" ToolTip="Empty for the smallest value; values below are counted in one bar."/>
                    <Label Content="Max value"/>
                    <TextBox Text="{Binding MaxValueText, UpdateSourceTrigger=LostFocus}" ToolTip="Empty for the largest value; values above are counted in one bar."/>
                </controls:FormGrid>
                <WrapPanel Margin="8,0,0,0">
                    <ContentControl Content="{Binding HistogramPlot, Converter={StaticResource PlotView}}" Margin="0,0,8,4"/>
                    <ContentControl Content="{Binding YieldPlot, Converter={StaticResource PlotView}}" Margin="0,0,0,4"/>
                </WrapPanel>
            </DockPanel>
        </TabItem>
        <TabItem Header="Sensitivity">
            <DockPanel Margin="4">
                <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding SensitivityRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Row" Binding="{Binding Row}"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding Min}"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding Max}"/>
                        <DataGridTextColumn Header="Criterion (min)" Binding="{Binding CriterionAtMin}"/>
                        <DataGridTextColumn Header="Change (min)" Binding="{Binding ChangeAtMin}"/>
                        <DataGridTextColumn Header="Criterion (max)" Binding="{Binding CriterionAtMax}"/>
                        <DataGridTextColumn Header="Change (max)" Binding="{Binding ChangeAtMax}"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBox Text="{Binding SensitivityText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,4,0,0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </DockPanel>
        </TabItem>
        <TabItem Header="Quick Yield">
            <TextBox Text="{Binding QuickYieldText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="4"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
        </TabItem>
    </TabControl>
</Window>
