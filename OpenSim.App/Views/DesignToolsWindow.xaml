<Window x:Class="OpenSim.App.Views.DesignToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        Title="Design Conversion Tools" Width="720" Height="760" MinWidth="460" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}">
    <!-- OP-61: Convert Asphere Types, Find Best Asphere and Stock Lens Matching (OpticStudio's
         Optimization Tools group). DataContext is the OpticsDesignToolsViewModel. Each tool shows
         its report below; Keep writes the last result into the lens (one undoable edit of the
         Lens Data Editor). -->
    <DockPanel Margin="8">
        <ScrollViewer DockPanel.Dock="Top" MaxHeight="430" VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding IsIdle}">
                <GroupBox Header="Convert Asphere Types">
                    <StackPanel>
                        <controls:FormGrid>
                            <Label Content="Surface"/>
                            <TextBox Text="{Binding ConvertSurface}" ToolTip="The surface to convert (Lens Data Editor numbering)."
                                     AutomationProperties.AutomationId="DesignToolsConvertSurfaceBox"/>
                            <Label Content="Asphere type"/>
                            <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label"
                                      AutomationProperties.AutomationId="DesignToolsTargetCombo"/>
                            <Label Content="Automatic terms"/>
                            <CheckBox IsChecked="{Binding AutomaticTerms}" VerticalAlignment="Center"
                                      ToolTip="Take the number of terms from the old asphere's order, adding terms while the residual is large."/>
                            <Label Content="Number of terms"/>
                            <TextBox Text="{Binding Terms}" ToolTip="Used when Automatic terms is cleared."/>
                            <Label Content="Fit radius and conic"/>
                            <CheckBox IsChecked="{Binding VaryRadiusAndConic}" VerticalAlignment="Center"
                                      ToolTip="A non-zero or variable radius or conic is fitted too (not one held by a solve or pickup)."/>
                        </controls:FormGrid>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Convert" Command="{Binding ConvertCommand}" MinWidth="70"
                                    AutomationProperties.AutomationId="DesignToolsConvertButton"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Find Best Asphere" Margin="0,6,0,0">
                    <StackPanel>
                        <controls:FormGrid>
                            <Label Content="First surface"/>
                            <TextBox Text="{Binding FirstSurface}"/>
                            <Label Content="Last surface"/>
                            <TextBox Text="{Binding LastSurface}" ToolTip="0 for the surface before the image."/>
                            <Label Content="Asphere type"/>
                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Label"
                                      AutomationProperties.AutomationId="DesignToolsAsphereKindCombo"/>
                            <Label Content="Maximum order"/>
                            <ComboBox ItemsSource="{Binding Orders}" SelectedItem="{Binding MaxOrder}"
                                      ToolTip="The even asphere's highest power of r; the terms from r^4 up are varied."/>
                        </controls:FormGrid>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Start" Command="{Binding FindBestAsphereCommand}" MinWidth="70"
                                    AutomationProperties.AutomationId="DesignToolsFindBestAsphereButton"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Stock Lens Matching" Margin="0,6,0,0">
                    <StackPanel>
                        <controls:FormGrid>
                            <Label Content="Catalog folder"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Load" Command="{Binding LoadCatalogsCommand}" Margin="4,0,0,0"
                                        AutomationProperties.AutomationId="DesignToolsLoadCatalogsButton"/>
                                <TextBox Text="{Binding LibraryFolder, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="The stock lens catalog folder of Lens Catalogs: vendor folders of lens files and private catalogs."/>
                            </DockPanel>
                            <Label Content="Vendor(s)"/>
                            <ComboBox ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedVendor}"/>
                            <Label Content="Surfaces"/>
                            <ComboBox ItemsSource="{Binding SurfaceChoices}" SelectedItem="{Binding SelectedSurfaces}" DisplayMemberPath="Label"
                                      ToolTip="All: every glass element. Variables: elements with a variable radius."/>
                            <Label Content="Show matches"/>
                            <TextBox Text="{Binding ShowMatches}"/>
                            <Label Content="EFL tolerance (%)"/>
                            <TextBox Text="{Binding EflTolerance}"/>
                            <Label Content="EPD tolerance (%)"/>
                            <TextBox Text="{Binding EpdTolerance}" ToolTip="Stock lenses are never smaller than the element's diameter."/>
                            <Label Content="Air thickness compensation"/>
                            <CheckBox IsChecked="{Binding AirThicknessCompensation}" VerticalAlignment="Center"
                                      ToolTip="Re-optimize the variable air thicknesses (only) with each stock lens in place."/>
                            <Label Content="Match shape"/>
                            <CheckBox IsChecked="{Binding MatchShape}" VerticalAlignment="Center"/>
                            <Label Content="Match orientation"/>
                            <CheckBox IsChecked="{Binding MatchOrientation}" VerticalAlignment="Center"
                                      ToolTip="Cleared: every stock lens is tried both ways round."/>
                        </controls:FormGrid>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Start" Command="{Binding MatchStockLensesCommand}" MinWidth="70"
                                    AutomationProperties.AutomationId="DesignToolsStockLensButton"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Optimization of every trial" Margin="0,6,0,0">
                    <controls:FormGrid>
                        <Label Content="Automatic cycles"/>
                        <CheckBox IsChecked="{Binding AutomaticCycles}" VerticalAlignment="Center"/>
                        <Label Content="# Opt. cycles"/>
                        <TextBox Text="{Binding CycleCount}" ToolTip="Used when Automatic cycles is cleared."/>
                    </controls:FormGrid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,4">
            <Button Content="Keep" Command="{Binding KeepCommand}" MinWidth="70" Margin="0,0,4,4"
                    ToolTip="Write the last result into the lens (the Lens Data Editor's Undo takes it back)."
                    AutomationProperties.AutomationId="DesignToolsKeepButton"/>
            <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="70" Margin="0,0,4,4"/>
            <Button Content="Close" Click="Close_Click" MinWidth="70" Margin="0,0,4,4"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,4"/>
        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 Foreground="{DynamicResource TextFaintBrush}"/>
    </DockPanel>
</Window>
