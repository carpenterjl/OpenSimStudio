<Window x:Class="OpenSim.App.Views.QuickAdjustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        Title="Quick Adjust" Width="480" Height="480" MinWidth="360" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}">
    <!-- OP-60: Quick Adjust. DataContext is the OpticsQuickAdjustViewModel. Adjust varies one
         radius or thickness for the best RMS at a later surface and writes it into the lens
         (one undoable edit). The dialog may stay open while the lens is edited. -->
    <DockPanel Margin="8">
        <controls:FormGrid DockPanel.Dock="Top" IsEnabled="{Binding IsIdle}">
            <Label Content="Adjust surface"/>
            <TextBox Text="{Binding Surface}" AutomationProperties.AutomationId="QuickAdjustSurfaceBox"/>
            <Label Content="Radius / thickness"/>
            <ComboBox ItemsSource="{Binding Parameters}" SelectedItem="{Binding SelectedParameter}" DisplayMemberPath="Label"/>
            <Label Content="Criterion"/>
            <ComboBox ItemsSource="{Binding Criteria}" SelectedItem="{Binding SelectedCriterion}" DisplayMemberPath="Label"
                      ToolTip="RMS about the centroid; angular criteria use the direction cosines after refraction into the evaluation surface."/>
            <Label Content="Evaluate surface (0: image)"/>
            <TextBox Text="{Binding EvaluateSurface}"/>
            <Label Content="Gaussian quadrature rings"/>
            <TextBox Text="{Binding Rings}" ToolTip="Rings of the pupil quadrature, 1 to 20; 4 arms per ring."/>
        </controls:FormGrid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,4">
            <Button Content="Adjust" Command="{Binding AdjustCommand}" MinWidth="70" Margin="0,0,4,4"
                    AutomationProperties.AutomationId="QuickAdjustButton"/>
            <Button Content="Close" Click="Close_Click" MinWidth="70" Margin="0,0,4,4"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,4"/>
        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextFaintBrush}"/>
    </DockPanel>
</Window>
