<Window x:Class="OpenSim.App.Views.ToleranceDataEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        xmlns:sheet="clr-namespace:OpenSim.App.Controls.Spreadsheet"
        xmlns:analyses="clr-namespace:OpenSim.App.Views.Analyses"
        Title="Tolerance Data Editor" Width="1100" Height="720" MinWidth="520" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}">
    <!-- OP-63: the Tolerance Data Editor. DataContext is the OpticsToleranceEditorViewModel; the
         sheet is OP-10's SpreadsheetGrid. Type an operand's code (TRAD) or name in the Operand
         column. Update validates the rows and fills the Nominal column. -->
    <Window.Resources>
        <analyses:AnalysisPlotViewConverter x:Key="PlotView"/>
    </Window.Resources>
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button Content="Update" Command="{Binding UpdateCommand}" Margin="0,0,4,4"
                    ToolTip="Check every row against the lens (surface ranges, codes, limits, nesting) and show each row's nominal value."/>
            <Button Content="Insert operand" Command="{Binding InsertOperandCommand}" Margin="8,0,4,4"
                    ToolTip="Insert a TOFF row before the current one."/>
            <Button Content="Insert after" Command="{Binding InsertOperandAfterCommand}" Margin="0,0,4,4"/>
            <Button Content="Delete operand" Command="{Binding DeleteOperandCommand}" Margin="0,0,4,4"/>
            <Button Content="Loosen 2x" Command="{Binding LoosenCommand}" Margin="8,0,4,4"
                    ToolTip="Double every tolerance's Min and Max."/>
            <Button Content="Tighten 2x" Command="{Binding TightenCommand}" Margin="0,0,4,4"
                    ToolTip="Halve every tolerance's Min and Max."/>
            <Button Content="Undo" Command="{Binding UndoCommand}" Margin="8,0,4,4"/>
            <Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,4,4"/>
        </WrapPanel>

        <controls:FormGrid DockPanel.Dock="Top" Width="560" HorizontalAlignment="Left" Margin="0,0,0,4">
            <Label Content="TIRR irregularity model"/>
            <ComboBox ItemsSource="{Binding IrregularityModels}" SelectedItem="{Binding SelectedIrregularityModel}"
                      DisplayMemberPath="Label" AutomationProperties.AutomationId="ToleranceIrregularityModelCombo"
                      ToolTip="How a TIRR row's fringes become sag: with power removed (the default), or OpticStudio's formula as its help writes it."/>
        </controls:FormGrid>

        <Expander DockPanel.Dock="Top" Header="Find an operand" Margin="0,0,0,4">
            <DockPanel Margin="4">
                <controls:FormGrid DockPanel.Dock="Top" Width="360" HorizontalAlignment="Left">
                    <Label Content="Code or name"/>
                    <TextBox Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"/>
                </controls:FormGrid>
                <ListBox ItemsSource="{Binding FindResults}" MaxHeight="140" Margin="0,4,0,0"/>
            </DockPanel>
        </Expander>

        <!-- OP-65: the Monte Carlo run (OpticStudio's Tolerancing dialog, Monte Carlo tab, as far as built). It uses
             the criterion, compensator, field and sampling settings of the tolerance run (the expander above it). -->
        <Expander DockPanel.Dock="Bottom" Header="Monte Carlo" Margin="0,4,0,0" AutomationProperties.AutomationId="MonteCarloExpander">
            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <DockPanel Margin="4">
                    <controls:FormGrid DockPanel.Dock="Left" Width="380" VerticalAlignment="Top" IsEnabled="{Binding IsRunIdle}">
                        <Label Content="Trials"/>
                        <TextBox Text="{Binding MonteCarloTrials}" AutomationProperties.AutomationId="MonteCarloTrials"
                                 ToolTip="The number of random lenses (OpticStudio's default is 20)."/>
                        <Label Content="Seed"/>
                        <TextBox Text="{Binding MonteCarloSeed}" ToolTip="Trial k depends only on the seed and k. 0 draws a seed from the clock; the result names it. SEED rows override it for the rows below them."/>
                        <Label Content="Statistics"/>
                        <ComboBox ItemsSource="{Binding MonteCarloStatisticsChoices}" SelectedItem="{Binding SelectedMonteCarloStatistics}" DisplayMemberPath="Label"
                                  ToolTip="The distribution of rows no STAT row governs."/>
                        <Label Content="Std devs to extremes"/>
                        <TextBox Text="{Binding MonteCarloStandardDeviations}" ToolTip="Normal statistics: n standard deviations from the midpoint to the tolerance extremes, 1 to 10 (default 2)."/>
                        <Label Content="Yield limit"/>
                        <TextBox Text="{Binding YieldLimitText, UpdateSourceTrigger=LostFocus}" ToolTip="The criterion limit, in its unit; empty for no yield. Larger-is-better criteria count trials at or above it."/>
                        <Label Content="Percentiles (%)"/>
                        <TextBox Text="{Binding PercentilesText, UpdateSourceTrigger=LostFocus}"/>
                        <Label Content="Distribution folder"/>
                        <TextBox Text="{Binding DistributionFolder, UpdateSourceTrigger=LostFocus}" ToolTip="The folder of the .UDD files that STAT 3 rows name in their comment."/>
                        <Label Content="Histogram bins"/>
                        <TextBox Text="{Binding HistogramBins}"/>
                        <Label Content="Overlay MTF"/>
                        <CheckBox IsChecked="{Binding OverlayMtf}" VerticalAlignment="Center" ToolTip="Compute each trial's FFT MTF at one field for an overlay plot."/>
                        <Label Content="Overlay field"/>
                        <TextBox Text="{Binding OverlayField}"/>
                        <Label Content="Overlay max frequency (cycles/mm)"/>
                        <TextBox Text="{Binding OverlayMaxFrequency}"/>
                        <Label Content="Overlay frequencies"/>
                        <TextBox Text="{Binding OverlayPoints}"/>
                        <Label Content="Overlay trials"/>
                        <TextBox Text="{Binding OverlayTrials}" ToolTip="The overlay draws the first this many trials."/>
                        <Label Content="Trial to save"/>
                        <TextBox Text="{Binding TrialToSave}"/>
                    </controls:FormGrid>
                    <StackPanel Margin="8,0,0,0">
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Run Monte Carlo" Command="{Binding RunMonteCarloCommand}" Margin="0,0,4,4"
                                    AutomationProperties.AutomationId="MonteCarloRunButton"/>
                            <Button Content="Stop" Command="{Binding CancelRunCommand}" MinWidth="70" Margin="0,0,4,4"/>
                            <Button Content="Save trial…" Command="{Binding SaveTrialCommand}" Margin="8,0,4,4"
                                    ToolTip="Write the lens of the trial above (compensated) to a lens file."/>
                        </WrapPanel>
                        <TextBlock Text="{Binding MonteCarloStatus}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <DataGrid ItemsSource="{Binding MonteCarloStatistics}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260"
                                      HeadersVisibility="Column" Margin="0,0,8,4" AutomationProperties.AutomationId="MonteCarloStatisticsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Statistic" Binding="{Binding Quantity}"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <ContentControl Content="{Binding HistogramPlot, Converter={StaticResource PlotView}}" Margin="0,0,8,4"/>
                            <ContentControl Content="{Binding MtfOverlayPlot, Converter={StaticResource PlotView}}" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding MonteCarloRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200"
                                  HeadersVisibility="Column" AutomationProperties.AutomationId="MonteCarloTrialsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Trial" Binding="{Binding Trial}"/>
                                <DataGridTextColumn Header="Criterion" Binding="{Binding Criterion}"/>
                                <DataGridTextColumn Header="Change" Binding="{Binding Change}"/>
                                <DataGridTextColumn Header="Compensators" Binding="{Binding Compensators}"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox Text="{Binding MonteCarloReportText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" MaxHeight="200" Margin="0,4,0,0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    </StackPanel>
                </DockPanel>
            </ScrollViewer>
        </Expander>

        <!-- OP-64: the tolerance run (OpticStudio's Tolerancing dialog, Set-Up and Criterion tabs, as far
             as built; Quick Sensitivity). Run works on the project's lens and the rows above. -->
        <Expander DockPanel.Dock="Bottom" Header="Tolerance run (sensitivity, inverse limit, inverse increment)" Margin="0,4,0,0"
                  AutomationProperties.AutomationId="ToleranceRunExpander">
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <DockPanel Margin="4">
                    <controls:FormGrid DockPanel.Dock="Left" Width="380" VerticalAlignment="Top" IsEnabled="{Binding IsRunIdle}">
                        <Label Content="Mode"/>
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label"
                                  AutomationProperties.AutomationId="ToleranceModeCombo"
                                  ToolTip="Sensitivity: the criterion at each tolerance's min and max. Inverse Limit / Increment: tighten each limit until the criterion reaches the Limit or changes by the Increment."/>
                        <Label Content="Criterion"/>
                        <ComboBox ItemsSource="{Binding Criteria}" SelectedItem="{Binding SelectedCriterion}" DisplayMemberPath="Label"
                                  AutomationProperties.AutomationId="ToleranceCriterionCombo" ToolTip="{Binding CriteriaNotBuilt}"/>
                        <Label Content="Change"/>
                        <ComboBox ItemsSource="{Binding ChangeModes}" SelectedItem="{Binding SelectedChange}" DisplayMemberPath="Label"
                                  ToolTip="Linear: P − N. RSS: S(P − N)·√|P² − N²|."/>
                        <Label Content="Compensators"/>
                        <ComboBox ItemsSource="{Binding Compensations}" SelectedItem="{Binding SelectedCompensation}" DisplayMemberPath="Label"
                                  AutomationProperties.AutomationId="ToleranceCompensationCombo"
                                  ToolTip="Paraxial focus holds the nominal defocus; Optimize drives the COMP, CPAR and CMCO rows with the local optimizer."/>
                        <Label Content="Compensator rows"/>
                        <TextBox Text="{Binding CompensatorRowsText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Optimize only: the COMP, CPAR or CMCO rows to use, as &quot;2, 5&quot;; empty for all."/>
                        <Label Content="Optimizer cycles"/>
                        <TextBox Text="{Binding OptimizerCycles}" ToolTip="0 is automatic (run until converged)."/>
                        <Label Content="Fields"/>
                        <ComboBox ItemsSource="{Binding FieldSets}" SelectedItem="{Binding SelectedFieldSet}" DisplayMemberPath="Label"/>
                        <Label Content="Sampling"/>
                        <TextBox Text="{Binding Sampling}" ToolTip="Rays along each radial arm of the Gaussian quadrature, 1 to 20; twice as many arms."/>
                        <Label Content="Pupil grid"/>
                        <TextBox Text="{Binding PsfSampling}" ToolTip="Strehl ratio, MTF and encircled energy: the pupil grid, 16 to 1024 nodes per side."/>
                        <Label Content="MTF frequency (cycles/mm)"/>
                        <TextBox Text="{Binding MtfFrequency}" AutomationProperties.AutomationId="ToleranceMtfFrequency"
                                 ToolTip="MTF criteria: the spatial frequency, MTF units (cycles per millimeter)."/>
                        <Label Content="Encircled radius (µm)"/>
                        <TextBox Text="{Binding EncircledRadius}" AutomationProperties.AutomationId="ToleranceEncircledRadius"
                                 ToolTip="Encircled-energy criteria: the radius about the centroid, micrometers."/>
                        <Label Content="Limit"/>
                        <TextBox Text="{Binding Limit}" ToolTip="Inverse Limit: the criterion each tolerance may reach (worse than the nominal)."/>
                        <Label Content="Increment"/>
                        <TextBox Text="{Binding Increment}" ToolTip="Inverse Increment: the change each tolerance may cause (positive)."/>
                        <Label Content="Show worst"/>
                        <TextBox Text="{Binding ShowWorst}"/>
                        <Label Content="Threads"/>
                        <TextBox Text="{Binding Threads}" ToolTip="The result is the same at any number."/>
                    </controls:FormGrid>
                    <StackPanel Margin="8,0,0,0">
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Run" Command="{Binding RunToleranceCommand}" MinWidth="70" Margin="0,0,4,4"
                                    AutomationProperties.AutomationId="ToleranceRunButton"/>
                            <Button Content="Quick Sensitivity" Command="{Binding QuickSensitivityCommand}" Margin="0,0,4,4"
                                    ToolTip="Sensitivity with the paraxial focus compensator (spot, wavefront and boresight criteria)."/>
                            <Button Content="Cancel" Command="{Binding CancelRunCommand}" MinWidth="70" Margin="0,0,4,4"/>
                            <Button Content="Apply inverse limits" Command="{Binding ApplyInverseLimitsCommand}" Margin="8,0,4,4"
                                    ToolTip="Write the tightened limits of the last inverse run into the table (one undo step)."/>
                        </WrapPanel>
                        <TextBlock Text="{Binding RunStatus}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <DataGrid ItemsSource="{Binding RunRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200"
                                  HeadersVisibility="Column" AutomationProperties.AutomationId="ToleranceRunGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Row" Binding="{Binding Row}"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                                <DataGridTextColumn Header="Min" Binding="{Binding Min}"/>
                                <DataGridTextColumn Header="Max" Binding="{Binding Max}"/>
                                <DataGridTextColumn Header="Criterion (min)" Binding="{Binding CriterionAtMin}"/>
                                <DataGridTextColumn Header="Change (min)" Binding="{Binding ChangeAtMin}"/>
                                <DataGridTextColumn Header="Criterion (max)" Binding="{Binding CriterionAtMax}"/>
                                <DataGridTextColumn Header="Change (max)" Binding="{Binding ChangeAtMax}"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" MaxHeight="200" Margin="0,4,0,0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    </StackPanel>
                </DockPanel>
            </ScrollViewer>
        </Expander>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ProblemsText}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource ErrorBrush}"/>
        </StackPanel>

        <sheet:SpreadsheetGrid x:Name="Grid" Document="{Binding Document}"/>
    </DockPanel>
</Window>
