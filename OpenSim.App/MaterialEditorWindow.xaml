<Window x:Class="OpenSim.App.MaterialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Material editor" Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBgBrush}"
        Foreground="{DynamicResource TextBodyBrush}">
    <DockPanel Margin="18,14,18,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Materials" Style="{StaticResource PanelTitle}"/>
            <TextBlock Text="Every property the six workspaces read. Blank means the material cannot be used for that physics."
                       Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        </StackPanel>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="LIBRARY" Style="{StaticResource MicroHeader}"/>
            <ListBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Background="{Binding Color}"/>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text=" (built-in)" Foreground="{DynamicResource TextFaintBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="PROPERTIES (SI UNITS)" Style="{StaticResource MicroHeader}"/>

            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,4"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="New from selected" Command="{Binding NewFromSelectedCommand}"
                            Margin="0,0,6,0"/>
                    <Button Content="Save library" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0"/>
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,0"/>
                    <Button Content="Close" Click="Close_Click"/>
                </StackPanel>
                <TextBlock Text="Built-in materials cannot be edited in place — 'New from selected' copies one; saving under a built-in name overrides it."
                           Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Name"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="1" Content="Young's modulus E [Pa]"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding YoungsModulus, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="2" Content="Poisson's ratio ν [-]"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PoissonRatio, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="3" Content="Density ρ [kg/m³]"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Density, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="4" Content="Thermal conductivity k [W/(m·K)]"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ThermalConductivity, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="5" Content="Specific heat c_p [J/(kg·K)]"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SpecificHeat, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="6" Content="Electrical conductivity σ [S/m]"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ElectricalConductivity, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="7" Content="Relative permittivity ε_r [-]"/>
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding RelativePermittivity, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Grid.Row="8" Content="Emissivity ε [0–1]"/>
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Emissivity, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Total hemispherical emissivity, required for radiating environment solves. Set by the SURFACE FINISH, not the alloy: ~0.03 polished metal, 0.1–0.3 mill finish, 0.85–0.95 paint, plastic or anodizing. Leave blank if unknown."/>
                <Label Grid.Row="9" Content="Color [#RRGGBB]"/>
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
