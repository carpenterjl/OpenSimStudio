<Window x:Class="OpenSim.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenSim.App.Views"
        xmlns:panels="clr-namespace:OpenSim.App.Views.Panels"
        xmlns:controls="clr-namespace:OpenSim.App.Controls"
        xmlns:vm="clr-namespace:OpenSim.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="OpenSim Studio" Height="820" Width="1360"
        MinHeight="600" MinWidth="1080"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextBodyBrush}"
        WindowStyle="None">
    <!-- Custom chrome: the design's 34px title bar replaces the OS caption. Resize
         borders and caption drag come from WindowChrome; the three buttons opt back
         into hit testing. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <controls:StringEqualsToVisibilityConverter x:Key="StepVis"/>

        <!-- Per-workspace content visibility (the properties pane's outer switch). -->
        <Style x:Key="StructuralOnly" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Structural">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThermalOnly" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Thermal">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ElectricalOnly" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Electrical">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RfOnly" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Rf">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SignalIntegrityOnly" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="SignalIntegrity">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlowOnly" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Flow">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Title-bar caption buttons. -->
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>

        <!-- Menu-ribbon action (icon + label). -->
        <Style x:Key="RibbonButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
        </Style>

        <!-- Nav-rail item: 44px wide icon+label column. -->
        <Style x:Key="NavRailButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Padding" Value="0,7"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>

        <DataTemplate x:Key="StudyLineTemplate" DataType="{x:Type vm:StudyRailViewModel+StudyLine}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Style="{StaticResource MonoText}"
                           Foreground="{DynamicResource TextFaintBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource MonoText}"
                           TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- One study-rail step row: number circle / done check / lock, title, detail. -->
        <DataTemplate x:Key="StudyStepTemplate" DataType="{x:Type vm:StudyStep}">
            <Button Command="{Binding DataContext.StudyRail.SelectStepCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.AutomationId="{Binding Title, StringFormat=StudyStep{0}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="Transparent" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="ActiveBar" Width="2" Margin="-14,-9,0,-9"
                                           HorizontalAlignment="Left"
                                           Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                <!-- Number / state bubble -->
                                <Grid Width="20" Height="20" VerticalAlignment="Top">
                                    <Border x:Name="NumberBubble" CornerRadius="10"
                                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                        <TextBlock x:Name="NumberText" Text="{Binding Number}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="DoneBubble" CornerRadius="10"
                                            Background="{DynamicResource SuccessBrush}" Visibility="Collapsed">
                                        <Path Data="M20 6 9 17l-5-5" Stretch="Uniform" Margin="4.5"
                                              Stroke="{DynamicResource AppBgBrush}" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TitleText" Text="{Binding Title}"
                                                   FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextBodyBrush}"/>
                                        <controls:IconGlyph x:Name="LockIcon" Width="11" Height="11" Margin="6,0,0,0"
                                                            Geometry="{StaticResource IconLock}"
                                                            Foreground="{DynamicResource TextFaintBrush}"
                                                            Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFaintBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource PanelBgHoverBrush}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NumberBubble" Property="Background"
                                        Value="{DynamicResource AccentSolidBrush}"/>
                                <Setter TargetName="NumberBubble" Property="BorderBrush"
                                        Value="{DynamicResource AccentSolidBrush}"/>
                                <Setter TargetName="NumberText" Property="Foreground"
                                        Value="{DynamicResource AccentOnBrush}"/>
                                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="TitleText" Property="Foreground"
                                        Value="{DynamicResource TextHeadingBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Done">
                                <Setter TargetName="NumberBubble" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="DoneBubble" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Locked">
                                <Setter TargetName="Row" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="LockIcon" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource PanelBgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ======== Title bar (34px) ======== -->
            <Grid Grid.Row="0" Background="{DynamicResource RailBgBrush}">
                <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"/>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <controls:IconGlyph Geometry="{StaticResource IconOrbit}"
                                        Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="OpenSim Studio" Margin="8,0,0,0"
                               FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHeadingBrush}"/>
                    <TextBlock Text="—" Margin="8,0" Foreground="{DynamicResource TextFaintBrush}"/>
                    <TextBlock Text="{Binding Session.Project.Name}" Style="{StaticResource MonoText}"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                            AutomationProperties.AutomationId="CaptionMinimizeButton">
                        <controls:IconGlyph Width="13" Height="13" Geometry="{StaticResource IconMinus}"
                                            Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="MaximizeRestore_Click"
                            AutomationProperties.AutomationId="CaptionMaximizeButton">
                        <controls:IconGlyph Width="11" Height="11" Geometry="{StaticResource IconSquare}"
                                            Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Close_Click"
                            AutomationProperties.AutomationId="CaptionCloseButton">
                        <controls:IconGlyph Width="13" Height="13" Geometry="{StaticResource IconX}"
                                            Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- ======== Workspace UI ======== -->
                <Grid Visibility="{Binding Session.IsHomeActive, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <!-- Menu ribbon (38px): file + import actions, theme. -->
                    <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding NewProjectCommand}"
                                    AutomationProperties.AutomationId="RibbonNewButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Geometry="{StaticResource IconFilePlus2}"
                                                        Foreground="{DynamicResource TextBodyBrush}"/>
                                    <TextBlock Text="New" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding OpenProjectCommand}"
                                    AutomationProperties.AutomationId="RibbonOpenButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Geometry="{StaticResource IconFolderOpen}"
                                                        Foreground="{DynamicResource TextBodyBrush}"/>
                                    <TextBlock Text="Open" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding SaveProjectCommand}"
                                    AutomationProperties.AutomationId="RibbonSaveButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Geometry="{StaticResource IconSave}"
                                                        Foreground="{DynamicResource TextBodyBrush}"/>
                                    <TextBlock Text="Save" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Rectangle Style="{StaticResource VerticalDivider}"/>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding Geometry.ImportStlCommand}"
                                    AutomationProperties.AutomationId="RibbonImportStlButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Geometry="{StaticResource IconTriangle}"
                                                        Foreground="{DynamicResource TextBodyBrush}"/>
                                    <TextBlock Text="STL" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding Geometry.ImportStepCommand}"
                                    AutomationProperties.AutomationId="RibbonImportStepButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Geometry="{StaticResource IconBox}"
                                                        Foreground="{DynamicResource TextBodyBrush}"/>
                                    <TextBlock Text="STEP" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding Geometry.ImportStepAssemblyCommand}"
                                    AutomationProperties.AutomationId="RibbonImportAssemblyButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Geometry="{StaticResource IconBoxes}"
                                                        Foreground="{DynamicResource TextBodyBrush}"/>
                                    <TextBlock Text="Assembly" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding Pcb.ImportPcbCommand}"
                                    AutomationProperties.AutomationId="RibbonImportPcbButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Geometry="{StaticResource IconCpu}"
                                                        Foreground="{DynamicResource TextBodyBrush}"/>
                                    <TextBlock Text="PCB" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Background="Transparent" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource RibbonButton}" Command="{Binding ToggleThemeCommand}"
                                    AutomationProperties.AutomationId="ThemeToggleButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Geometry="{StaticResource IconSunMoon}"
                                                        Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="Theme" Margin="7,0,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Workspace ribbon (42px): badge, analysis, solve, view toggles. -->
                    <Border Grid.Row="1" Background="{DynamicResource PanelBgRaisedBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel Margin="10,0" LastChildFill="False">
                            <Border DockPanel.Dock="Left" Background="{DynamicResource PanelBgBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,5,10,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Width="15" Height="15">
                                        <controls:IconGlyph.Style>
                                            <Style TargetType="controls:IconGlyph"
                                                   BasedOn="{StaticResource {x:Type controls:IconGlyph}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Structural">
                                                        <Setter Property="Geometry" Value="{StaticResource IconBox}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource KindFunctionBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Thermal">
                                                        <Setter Property="Geometry" Value="{StaticResource IconThermometer}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource KindMacroBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Electrical">
                                                        <Setter Property="Geometry" Value="{StaticResource IconZap}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource KindConstantBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Rf">
                                                        <Setter Property="Geometry" Value="{StaticResource IconRadioTower}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource KindTypeBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="SignalIntegrity">
                                                        <Setter Property="Geometry" Value="{StaticResource IconActivity}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource KindVariableBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Flow">
                                                        <Setter Property="Geometry" Value="{StaticResource IconWind}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource KindInterfaceBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:IconGlyph.Style>
                                    </controls:IconGlyph>
                                    <TextBlock Margin="8,0,0,0" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextHeadingBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Structural">
                                                        <Setter Property="Text" Value="Structural"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Thermal">
                                                        <Setter Property="Text" Value="Thermal"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Electrical">
                                                        <Setter Property="Text" Value="Electrical"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Rf">
                                                        <Setter Property="Text" Value="RF &amp; antenna"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="SignalIntegrity">
                                                        <Setter Property="Text" Value="Signal integrity"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Session.ActiveWorkspace}" Value="Flow">
                                                        <Setter Property="Text" Value="Flow"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Rectangle DockPanel.Dock="Left" Style="{StaticResource VerticalDivider}"
                                       Height="20" Margin="10,0"/>
                            <TextBlock DockPanel.Dock="Left" Text="ANALYSIS" VerticalAlignment="Center"
                                       Style="{StaticResource MicroHeader}" Margin="0,0,8,0"/>
                            <ComboBox DockPanel.Dock="Left" x:Name="AnalysisCombo" MinWidth="248"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding Session.AnalysisOptions}"
                                      SelectedItem="{Binding Session.SelectedAnalysis}"
                                      DisplayMemberPath="Label"/>
                            <Button DockPanel.Dock="Left" x:Name="SolveButton" Margin="10,0,0,0"
                                    VerticalAlignment="Center" Style="{StaticResource AccentButton}"
                                    Command="{Binding SolveActiveCommand}" Padding="14,7"
                                    AutomationProperties.AutomationId="SolveButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Geometry="{StaticResource IconPlay}"
                                                        Foreground="{DynamicResource AccentOnBrush}"/>
                                    <TextBlock Text="Solve" Margin="8,0,0,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentOnBrush}"/>
                                </StackPanel>
                            </Button>

                            <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                    Click="Fit_Click" AutomationProperties.AutomationId="FitViewButton">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Width="13" Height="13"
                                                        Geometry="{StaticResource IconMaximize}"
                                                        Foreground="{DynamicResource TextBodyBrush}"/>
                                    <TextBlock Text="Fit" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Rectangle DockPanel.Dock="Right" Style="{StaticResource VerticalDivider}"
                                       Height="20" Margin="10,0"/>
                            <CheckBox DockPanel.Dock="Right" Content="Show 3D body" VerticalAlignment="Center"
                                      Margin="0,0,4,0" IsChecked="{Binding Scene.ShowBody}"/>
                            <CheckBox DockPanel.Dock="Right" Content="Show mesh" VerticalAlignment="Center"
                                      Margin="0,0,14,0" IsChecked="{Binding Scene.ShowMeshEdges}"/>
                        </DockPanel>
                    </Border>

                    <!-- Main content: nav rail | study rail | properties | viewport+log -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="208"/>
                            <ColumnDefinition Width="352"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nav rail -->
                        <Border Grid.Column="0" Background="{DynamicResource RailBgBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
                            <StackPanel Margin="0,8">
                                <Button Style="{StaticResource NavRailButton}" Command="{Binding GoHomeCommand}"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        AutomationProperties.AutomationId="GoHomeButton" HorizontalAlignment="Center">
                                    <StackPanel>
                                        <controls:IconGlyph Width="18" Height="18" Geometry="{StaticResource IconHouse}"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center"/>
                                        <TextBlock Text="Home" FontSize="9" FontWeight="Medium" Margin="0,3,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Rectangle Height="1" Width="32" Fill="{DynamicResource PanelBorderBrush}"
                                           Margin="0,6"/>
                                <ItemsControl ItemsSource="{Binding WorkspaceNav}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.EnterWorkspaceCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Kind}"
                                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                                    HorizontalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Chrome" Width="44" Padding="0,7" CornerRadius="4"
                                                                Background="Transparent" Margin="0,1">
                                                            <Grid>
                                                                <Rectangle x:Name="ActiveBar" Width="2" Margin="0,-7"
                                                                           HorizontalAlignment="Left"
                                                                           Fill="{DynamicResource AccentBrush}"
                                                                           Visibility="Collapsed"/>
                                                                <StackPanel>
                                                                    <controls:IconGlyph x:Name="Icon" Width="18" Height="18"
                                                                                        Geometry="{Binding Icon}"
                                                                                        Foreground="{DynamicResource TextFaintBrush}"
                                                                                        HorizontalAlignment="Center"/>
                                                                    <TextBlock x:Name="Label" Text="{Binding ShortLabel}"
                                                                               FontSize="9" FontWeight="Medium" Margin="0,3,0,0"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="{DynamicResource TextFaintBrush}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background"
                                                                        Value="{DynamicResource PanelBgHoverBrush}"/>
                                                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="Icon" Property="Foreground"
                                                                        Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="Label" Property="Foreground"
                                                                        Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background"
                                                                        Value="{DynamicResource PanelBgHoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Study-steps rail -->
                        <Border Grid.Column="1" Background="{DynamicResource PanelBgBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
                            <DockPanel Margin="0,12">
                                <TextBlock DockPanel.Dock="Top" Text="STUDY STEPS"
                                           Style="{StaticResource MicroHeader}" Margin="14,0,14,10"/>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}"
                                        Margin="12,10,12,0">
                                    <StackPanel>
                                        <TextBlock Text="STUDY" Style="{StaticResource MicroHeader}"/>
                                        <ItemsControl ItemsSource="{Binding StudyRail.StudyLines}"
                                                      ItemTemplate="{StaticResource StudyLineTemplate}"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding StudyRail.Steps}"
                                              ItemTemplate="{StaticResource StudyStepTemplate}"
                                              VerticalAlignment="Top"/>
                            </DockPanel>
                        </Border>

                        <!-- Properties pane: header + step-scoped panel groups. -->
                        <Border Grid.Column="2" Background="{DynamicResource PanelBgBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="16,14,16,12"
                                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MicroHeaderAccent}" Margin="0">
                                            <Run Text="STEP "/><Run Text="{Binding StudyRail.SelectedStep.Number, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Session.SelectedAnalysis.Label, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StudyRail.SelectedStep.Title}"
                                                   Style="{StaticResource PanelTitle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,13">
                                    <Grid>
                                        <!-- Structural -->
                                        <StackPanel Style="{StaticResource StructuralOnly}">
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Geometry}">
                                                <panels:PrimitivesPanel/>
                                                <panels:GeometryInfoPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Mesh}">
                                                <panels:MeshingPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Setup}">
                                                <panels:MaterialPanel/>
                                                <panels:ScopeSelectionPanel/>
                                                <panels:StructuralConditionsPanel/>
                                                <panels:BoundaryConditionsListPanel/>
                                                <panels:AnalysisSettingsPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Solve}">
                                                <panels:SolvePanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Results}">
                                                <panels:ResultsFieldsPanel/>
                                                <panels:ResultDisplayPanel/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Thermal -->
                                        <StackPanel Style="{StaticResource ThermalOnly}">
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Geometry}">
                                                <panels:PrimitivesPanel/>
                                                <panels:GeometryInfoPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Mesh}">
                                                <panels:MeshingPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Setup}">
                                                <panels:MaterialPanel/>
                                                <panels:ScopeSelectionPanel/>
                                                <panels:ThermalConditionsPanel/>
                                                <panels:BoundaryConditionsListPanel/>
                                                <panels:AnalysisSettingsPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Solve}">
                                                <panels:SolvePanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Results}">
                                                <panels:ResultsFieldsPanel/>
                                                <panels:ResultDisplayPanel/>
                                                <panels:TimelinePanel/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Electrical -->
                                        <StackPanel Style="{StaticResource ElectricalOnly}">
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Geometry}">
                                                <panels:PcbNetsPanel/>
                                                <panels:PrimitivesPanel/>
                                                <panels:GeometryInfoPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Mesh}">
                                                <panels:MeshingPanel/>
                                                <panels:StackupPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Setup}">
                                                <panels:ElectricalSetupPanel/>
                                                <panels:MaterialPanel/>
                                                <panels:ScopeSelectionPanel/>
                                                <panels:ElectricalConditionsPanel/>
                                                <panels:ThermalConditionsPanel/>
                                                <panels:BoundaryConditionsListPanel/>
                                                <panels:AnalysisSettingsPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Solve}">
                                                <panels:SolvePanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Results}">
                                                <panels:ResultsFieldsPanel/>
                                                <panels:ResultDisplayPanel/>
                                                <panels:TimelinePanel/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- RF: one integrated MoM panel; SolvePanel joins on the Solve step. -->
                                        <StackPanel Style="{StaticResource RfOnly}">
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Solve}">
                                                <panels:SolvePanel/>
                                            </StackPanel>
                                            <panels:AntennaPanel/>
                                        </StackPanel>

                                        <!-- Signal integrity -->
                                        <StackPanel Style="{StaticResource SignalIntegrityOnly}">
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Solve}">
                                                <panels:SolvePanel/>
                                            </StackPanel>
                                            <panels:SignalIntegrityPanel/>
                                        </StackPanel>

                                        <!-- Flow. BodiesPanel rides on BOTH Geometry and Mesh:
                                             the assembly workflow's per-body material + mesh-all
                                             buttons live there, and the rail auto-advances to
                                             Mesh the moment the import lands. -->
                                        <StackPanel Style="{StaticResource FlowOnly}">
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Geometry}">
                                                <panels:BodiesPanel/>
                                                <panels:GeometryInfoPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Mesh}">
                                                <panels:BodiesPanel/>
                                                <panels:MeshingPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Environment}">
                                                <panels:EnvironmentPanel/>
                                                <panels:CfdSetupPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Setup}">
                                                <panels:MaterialPanel/>
                                                <panels:ScopeSelectionPanel/>
                                                <panels:ThermalConditionsPanel/>
                                                <panels:BoundaryConditionsListPanel/>
                                                <panels:AnalysisSettingsPanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Solve}">
                                                <panels:SolvePanel/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding StudyRail.ActiveStepName, Converter={StaticResource StepVis}, ConverterParameter=Results}">
                                                <panels:ResultsFieldsPanel/>
                                                <panels:ResultDisplayPanel/>
                                                <panels:FlowVisualizationPanel/>
                                                <panels:ColormapEditorPanel/>
                                                <panels:TimelinePanel/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Viewport + log -->
                        <Grid Grid.Column="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <views:Viewport3DView x:Name="ViewportView" Grid.Row="0"/>

                            <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="12,7"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="LOG"
                                                       Style="{StaticResource MicroHeader}" Margin="0"/>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource MonoText}"
                                                       Foreground="{DynamicResource TextFaintBrush}"
                                                       Margin="8,0,0,0"
                                                       Text="{Binding Log.Entries.Count, StringFormat={}{0} entries}"/>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                                    Padding="4" Click="ToggleLog_Click"
                                                    AutomationProperties.AutomationId="LogCollapseButton">
                                                <controls:IconGlyph x:Name="LogChevron" Width="13" Height="13"
                                                                    Geometry="{StaticResource IconChevronDown}"
                                                                    Foreground="{DynamicResource TextFaintBrush}"/>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                    <ListBox x:Name="LogList" ItemsSource="{Binding Log.Entries}"
                                             Height="96" BorderThickness="0"
                                             Background="{DynamicResource PanelBgBrush}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Status bar (26px) -->
                    <Border Grid.Row="3" Background="{DynamicResource RailBgBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                        <DockPanel Margin="12,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Style="{StaticResource MonoText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding Session.StatusText}"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Style="{StaticResource MonoText}"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       Text="{Binding Session.SelectedAnalysis.Label}"/>
                            <ProgressBar DockPanel.Dock="Right" Width="180" Height="4"
                                         VerticalAlignment="Center" Margin="0,0,14,0"
                                         x:Name="SolveProgress"
                                         Value="{Binding Session.ProgressFraction, Mode=OneWay}" Maximum="1"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Home / start screen overlays the workspace; the viewport stays alive
                     underneath so loaded state survives navigation. -->
                <views:HomeView Visibility="{Binding Session.IsHomeActive, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
